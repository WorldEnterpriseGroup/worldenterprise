{
  "version": 2,
  "redirectAllowlist": [
    "/apply/thanks/",
    "/briefs/thanks/",
    "/investors/interest/thanks/",
    "/network/partners/enquire/thanks/"
  ],
  "kinds": {
    "apply": {
      "thanks": "/apply/thanks/",
      "audience": [
        "startup"
      ],
      "rateLimit": {
        "perHour": 5
      },
      "fields": {
        "name": {
          "rule": "R",
          "type": "string",
          "max": 120
        },
        "email": {
          "rule": "R",
          "type": "email",
          "max": 254
        },
        "company": {
          "rule": "O",
          "type": "string",
          "max": 120
        },
        "stage": {
          "rule": "R",
          "type": "enum",
          "max": 12,
          "enum": [
            "idea",
            "validating",
            "building",
            "launched"
          ]
        },
        "seats": {
          "rule": "O",
          "type": "string",
          "max": 500
        },
        "topic": {
          "rule": "-",
          "type": "enum",
          "max": 20,
          "enum": [
            "general",
            "seat-rate",
            "press",
            "correction",
            "information"
          ]
        },
        "message": {
          "rule": "O",
          "type": "string",
          "max": 4000
        },
        "briefId": {
          "rule": "-",
          "type": "slug",
          "max": 64
        },
        "companyUrl": {
          "rule": "-",
          "type": "url",
          "max": 300
        },
        "partnerCategory": {
          "rule": "-",
          "type": "enum",
          "max": 30,
          "enum": [
            "tooling-saas",
            "cloud-credits",
            "legal",
            "finance-accounting",
            "delivery",
            "ecosystem",
            "other"
          ]
        },
        "offer": {
          "rule": "-",
          "type": "string",
          "max": 1500
        },
        "investorKind": {
          "rule": "-",
          "type": "enum",
          "max": 20,
          "enum": [
            "angel",
            "fund",
            "corporate",
            "family-office",
            "other"
          ]
        },
        "focus": {
          "rule": "-",
          "type": "string",
          "max": 1000
        },
        "consent": {
          "rule": "R",
          "type": "boolean",
          "max": 5
        },
        "consentUpdates": {
          "rule": "-",
          "type": "boolean",
          "max": 5
        },
        "requestId": {
          "rule": "R",
          "type": "uuid",
          "max": 36
        }
