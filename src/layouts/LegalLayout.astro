---
import BaseLayout from './BaseLayout.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import { buildCrumbs } from '../lib/breadcrumbs.ts';
import type { HeaderProps, PageMeta } from './types.ts';
type Props = PageMeta & HeaderProps & { title: string; updated: Date };

const { eyebrow, lead, ...meta } = Astro.props;
const crumbs = meta.crumbs ?? buildCrumbs(meta.path, meta.title);
const dateFormat = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<BaseLayout {...meta} crumbs={crumbs}>
  <PageHeader title={meta.title} eyebrow={eyebrow ?? 'Legal'} lead={lead} crumbs={crumbs} measure="prose" />
  <div class="section">
    <div class="container container--prose stack">
      <p class="muted ui">Last updated <time datetime={meta.updated.toISOString()}>{dateFormat.format(meta.updated)}</time></p>
      <div class="prose">
        <slot />
      </div>
    </div>
  </div>
</BaseLayout>
