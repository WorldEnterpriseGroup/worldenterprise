---
import BaseLayout from './BaseLayout.astro';
import CtaEnd from '../components/cta/CtaEnd.astro';
import PageHero from '../components/hero/PageHero.astro';
import { buildCrumbs } from '../lib/breadcrumbs.ts';
import type { HeaderProps, PageMeta } from './types.ts';
type Props = PageMeta & HeaderProps & { title: string; wide?: boolean };

const { eyebrow, lead, wide = false, primary, secondary, photo, art, measure, cta, ...meta } = Astro.props;
const crumbs = meta.crumbs ?? buildCrumbs(meta.path, meta.title);
---

<BaseLayout {...meta} crumbs={crumbs}>
  <PageHero
    title={meta.title}
    eyebrow={eyebrow}
    lead={lead}
    crumbs={crumbs}
    primary={primary}
    secondary={secondary}
    photo={photo}
    art={art}
    measure={measure ?? (wide ? 'default' : 'prose')}
  />
  <div class="section">
    <div class:list={['container', 'stack', { 'container--prose': !wide }]}>
      <slot />
    </div>
  </div>
  <slot name="cta-end"><CtaEnd path={meta.path} collection="pages" cta={cta} /></slot>
</BaseLayout>
