---
import BaseLayout from './BaseLayout.astro';
import PageHero from '../components/hero/PageHero.astro';
import { buildCrumbs } from '../lib/breadcrumbs.ts';
import type { HeaderProps, PageMeta } from './types.ts';
type Props = PageMeta & HeaderProps & { title: string };

const { eyebrow, lead, primary, secondary, photo, art, measure, ...meta } = Astro.props;
const crumbs = meta.crumbs ?? buildCrumbs(meta.path, meta.title);
---

<BaseLayout {...meta} crumbs={crumbs} schemaType={meta.schemaType ?? 'WebPage'}>
  <PageHero title={meta.title} eyebrow={eyebrow} lead={lead} crumbs={crumbs} primary={primary} secondary={secondary} photo={photo} art={art} measure={measure} />
  <div class="section">
    <div class="container form-layout">
      <div class="stack">
        <slot />
      </div>
      <aside class="stack form-layout__aside" aria-label="Before you send">
        <slot name="aside" />
      </aside>
    </div>
  </div>
</BaseLayout>
