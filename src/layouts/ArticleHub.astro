---
import BaseLayout from './BaseLayout.astro';
import CtaEnd from '../components/cta/CtaEnd.astro';
import PageHero from '../components/hero/PageHero.astro';
import { buildCrumbs } from '../lib/breadcrumbs.ts';
import type { HeaderProps, PageMeta } from './types.ts';
type Props = PageMeta & HeaderProps & {
  title: string;
  /** Editor's introduction for topic hubs (120 to 200 words, written by hand). */
  introduction?: string;
};

const { eyebrow, lead, introduction, primary, secondary, photo, art, measure, cta, ...meta } = Astro.props;
const crumbs = meta.crumbs ?? buildCrumbs(meta.path, meta.title);
---

<BaseLayout {...meta} crumbs={crumbs} schemaType={meta.schemaType ?? 'CollectionPage'}>
  <PageHero title={meta.title} eyebrow={eyebrow ?? 'Insights'} lead={lead} crumbs={crumbs} primary={primary} secondary={secondary} photo={photo} art={art} measure={measure} />
  {
    introduction && (
      <div class="section section--tight">
        <div class="container">
          <div class="prose measure-prose">
            <p>{introduction}</p>
          </div>
        </div>
      </div>
    )
  }
  <div class="section">
    <div class="container stack">
      <slot />
    </div>
  </div>
  <slot name="after" />
  <slot name="cta-end">{!Astro.slots.has('after') && <CtaEnd path={meta.path} collection="pages" cta={cta} />}</slot>
</BaseLayout>
