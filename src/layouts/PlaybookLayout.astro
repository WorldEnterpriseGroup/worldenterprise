---
import BaseLayout from './BaseLayout.astro';
import CtaEnd from '../components/cta/CtaEnd.astro';
import PageHero from '../components/hero/PageHero.astro';
import { APPLY, jumpTo } from '../components/hero/ctas.ts';
import { buildCrumbs } from '../lib/breadcrumbs.ts';
import type { HeaderProps, PageMeta } from './types.ts';
import ContextualNext from '../components/blocks/ContextualNext.astro';
import CiteThis from '../components/geo/CiteThis.astro';
import Steps from '../components/ui/Steps.astro';

interface Step {
  readonly title: string;
  readonly body: string;
}

type Props = PageMeta & HeaderProps & {
  title: string;
  stage?: 'dream' | 'build' | 'grow';
  steps: readonly Step[];
  /** Artifacts the reader can open today (templates, checklists, briefs). */
  artifacts?: readonly { readonly title: string; readonly href: string; readonly description?: string }[];
};

const { eyebrow, lead, stage, steps, artifacts = [], primary = jumpTo('Read the steps', '#steps-title'), secondary = APPLY, photo, art, measure, cta, ...meta } = Astro.props;
const crumbs = meta.crumbs ?? buildCrumbs(meta.path, meta.title);
---

<BaseLayout {...meta} crumbs={crumbs}>
  <PageHero
    title={meta.title}
    eyebrow={eyebrow ?? (stage ? `Playbook, ${stage}` : 'Playbook')}
    lead={lead}
    crumbs={crumbs}
    primary={primary}
    secondary={secondary}
    photo={photo}
    art={photo === undefined ? (art ?? { variant: 'trail', count: steps.length }) : art}
    measure={measure}
  />
  <div class="section">
    <div class="container stack">
      <slot />
      <slot name="media" />
      <section aria-labelledby="steps-title">
        <h2 id="steps-title">The steps</h2>
        <Steps steps={steps} headingLevel={3} />
      </section>
      <CiteThis title={meta.title} path={meta.path} date={meta.updated} />
    </div>
  </div>
  {
    artifacts.length > 0 && (
      <div class="section section--soft section--defer">
        <div class="container">
          <ContextualNext items={artifacts} title="Open these next" />
        </div>
      </div>
    )
  }
  <slot name="after" />
  <slot name="cta-end">{!Astro.slots.has('after') && <CtaEnd path={meta.path} collection="playbooks" cta={cta} />}</slot>
</BaseLayout>
