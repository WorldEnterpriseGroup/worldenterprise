---
import BaseLayout from './BaseLayout.astro';
import CtaEnd from '../components/cta/CtaEnd.astro';
import PageHero from '../components/hero/PageHero.astro';
import { buildCrumbs } from '../lib/breadcrumbs.ts';
import ProseRail from '../components/layout/ProseRail.astro';
import type { HeaderProps, PageMeta } from './types.ts';

type Props = PageMeta & HeaderProps & {
  title: string;
  /** Path of the static Markdown download for this template, when it exists. */
  markdownHref?: string;
  instructions?: string;
};

const { eyebrow, lead, markdownHref, instructions, primary, secondary, photo, art, measure = 'default', cta, ...meta } = Astro.props;
const crumbs = meta.crumbs ?? buildCrumbs(meta.path, meta.title);
// The download is the main action of a template, so it sits in the hero. Controls the page adds (copy, print) join it there.
const download = markdownHref !== undefined ? { label: 'Download as Markdown', href: markdownHref, download: true } : undefined;
---

<BaseLayout {...meta} crumbs={crumbs}>
  <PageHero
    title={meta.title}
    eyebrow={eyebrow ?? 'Template'}
    lead={lead}
    crumbs={crumbs}
    primary={primary ?? download}
    secondary={secondary}
    photo={photo}
    art={art}
    measure={measure}
  >
    <Fragment slot="actions"><slot name="actions" /></Fragment>
  </PageHero>
  <div class="section">
    <ProseRail path={meta.path} collection="library" cta={cta} bodyClass="prose template-body">
      <Fragment slot="before">{instructions && <p class="callout"><strong>How to use this.</strong> {instructions}</p>}</Fragment>
      <slot />
    </ProseRail>
  </div>
  <slot name="cta-end"><CtaEnd path={meta.path} collection="library" cta={cta} /></slot>
</BaseLayout>
