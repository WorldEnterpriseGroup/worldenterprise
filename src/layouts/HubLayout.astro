---
import BaseLayout from './BaseLayout.astro';
import CtaEnd from '../components/cta/CtaEnd.astro';
import HeroConsole from '../components/hero/HeroConsole.astro';
import PageHero from '../components/hero/PageHero.astro';
import { APPLY } from '../components/hero/ctas.ts';
import { buildCrumbs } from '../lib/breadcrumbs.ts';
import type { HeaderProps, PageMeta } from './types.ts';
import { href } from '../lib/url.ts';
import type { Heading } from './types.ts';

interface HubChild {
  readonly title: string;
  readonly href: string;
  readonly description?: string;
}

type Props = PageMeta & HeaderProps & {
  title: string;
  /** Whole subtree of this hub. Rendered as a list so the section is reachable without the mega menu or JavaScript. */
  subtree?: readonly HubChild[];
  /** In-page table of contents entries (anchor ids on the page). */
  toc?: readonly Pick<Heading, 'slug' | 'text'>[];
  /** Header style. `console` renders the split hero with the named `panel` slot beside the copy. */
  hero?: 'editorial' | 'console';
};

// A hub opens with the editorial hero: its photo if the page names one, the flower art otherwise. Apply is the default action.
const { eyebrow, lead, subtree = [], toc = [], hero = 'editorial', primary = APPLY, secondary, photo, art, measure, cta, ...meta } = Astro.props;
const crumbs = meta.crumbs ?? buildCrumbs(meta.path, meta.title);
---

<BaseLayout {...meta} crumbs={crumbs} schemaType={meta.schemaType ?? 'CollectionPage'}>
  {
    hero === 'console' ? (
      <HeroConsole crumbs={crumbs} eyebrow={eyebrow} title={meta.title} lead={lead} primary={primary} secondary={secondary} measure={measure}>
        <slot name="panel" />
      </HeroConsole>
    ) : (
      <PageHero
        title={meta.title}
        eyebrow={eyebrow}
        lead={lead}
        crumbs={crumbs}
        primary={primary}
        secondary={secondary}
        photo={photo}
        art={photo === undefined ? (art ?? { variant: 'flower' }) : art}
        measure={measure}
      />
    )
  }
  {
    toc.length > 0 && (
      <nav class="toc container" aria-label="On this page">
        <ul class="toc__list" role="list">
          {toc.map((entry) => (
            <li>
              <a href={`#${entry.slug}`}>{entry.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
  <div class="section">
    <div class="container stack">
      <slot />
    </div>
  </div>
  {
    subtree.length > 0 && (
      <section class="section section--soft section--tinted section--tint-stone section--defer" aria-labelledby="hub-subtree">
        <div class="container stack">
          <h2 id="hub-subtree">In this section</h2>
          <ul class="subtree grid" role="list">
            {subtree.map((child) => (
              <li>
                <a class="subtree__link" href={href(child.href)}>
                  <span class="subtree__title">{child.title}</span>
                  {child.description && <span class="subtree__desc">{child.description}</span>}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
  <slot name="after" />
  <slot name="cta-end">{!Astro.slots.has('after') && <CtaEnd path={meta.path} collection="pages" cta={cta} />}</slot>
</BaseLayout>
