---
import BaseLayout from './BaseLayout.astro';
import PageHero from '../components/hero/PageHero.astro';
import { APPLY, COMPOSE_TEAM } from '../components/hero/ctas.ts';
import { buildCrumbs } from '../lib/breadcrumbs.ts';
import type { HeaderProps, PageMeta } from './types.ts';
import LimitsBlock from '../components/blocks/LimitsBlock.astro';
import NoFundingDisclaimer from '../components/blocks/NoFundingDisclaimer.astro';
import DataTable from '../components/ui/DataTable.astro';
import type { ServiceLine } from '../data/nav.ts';
import { site } from '../data/site.ts';
import { absoluteUrl } from '../lib/url.ts';

type Props = PageMeta & HeaderProps & {
  title: string;
  /** Optional longer name for the h1 when the SEO title must stay short. */
  heading?: string;
  line: ServiceLine;
  covers?: readonly string[];
  /** What the founder receives from this line. Rendered as a table before the page body. */
  artifacts?: readonly { readonly name: string; readonly purpose: string }[];
  /** Required: every service line states what it does not do (claim C-04). */
  doesNotCover: readonly string[];
};

const { eyebrow, lead, line, heading, covers = [], artifacts = [], doesNotCover, primary = APPLY, secondary = COMPOSE_TEAM, photo, art, measure, ...meta } = Astro.props;
const crumbs = meta.crumbs ?? buildCrumbs(meta.path, meta.title);
const serviceNode = {
  '@type': 'Service',
  '@id': `${absoluteUrl(meta.path)}#service`,
  name: meta.title,
  description: meta.description,
  serviceType: meta.title,
  provider: { '@id': `${site.origin}/#org` },
  url: absoluteUrl(meta.path),
};
---

<BaseLayout {...meta} crumbs={crumbs} jsonLd={[...(meta.jsonLd ?? []), serviceNode]}>
  <PageHero
    title={heading ?? meta.title}
    eyebrow={eyebrow ?? `Service line ${line}`}
    lead={lead}
    crumbs={crumbs}
    primary={primary}
    secondary={secondary}
    photo={photo}
    art={photo === undefined ? (art ?? { variant: 'flower', glyph: line }) : art}
    measure={measure}
  />
  <div class="section">
    <div class="container with-rail">
      <div class="stack prose">
        {
          covers.length > 0 && (
            <section aria-labelledby="covers-title">
              <h2 id="covers-title">What this line covers</h2>
              <ul>
                {covers.map((item) => <li>{item}</li>)}
              </ul>
            </section>
          )
        }
        {
          artifacts.length > 0 && (
            <section aria-labelledby="receive-title">
              <h2 id="receive-title">What you receive</h2>
              <DataTable
                caption={`Artifacts from line ${line} and what each is for`}
                columns={['Artifact', 'What it is for']}
                rows={artifacts.map((artifact) => [artifact.name, artifact.purpose])}
              />
            </section>
          )
        }
        <slot />
        <LimitsBlock items={doesNotCover} />
        {line === 'F' && <NoFundingDisclaimer />}
      </div>
      <aside class="rail" aria-label="Related">
        <slot name="aside" />
      </aside>
    </div>
  </div>
  <slot name="after" />
</BaseLayout>
