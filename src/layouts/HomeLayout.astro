---
import BaseLayout from './BaseLayout.astro';
import type { PageMeta } from './types.ts';

/** Home page shell (hero mode H1 Atlas). The page supplies the hero, which carries the single h1, and may close with the `after` slot. */
type Props = Omit<PageMeta, 'path' | 'title'> & { path?: string };

const { path = '/', ...meta } = Astro.props;
---

<BaseLayout {...meta} path={path} schemaType="WebPage" mainClass="main--home">
  <slot name="hero" />
  <slot />
  <slot name="after" />
</BaseLayout>
