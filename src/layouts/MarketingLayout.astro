---
import BaseLayout from './BaseLayout.astro';
import CtaEnd from '../components/cta/CtaEnd.astro';
import HeroCompact from '../components/hero/HeroCompact.astro';
import PageHero from '../components/hero/PageHero.astro';
import { buildCrumbs } from '../lib/breadcrumbs.ts';
import type { HeaderProps, PageMeta } from './types.ts';
type Props = PageMeta &
  HeaderProps & {
    title: string;
    /**
     * Body width (wave 9, W9-4). 'content', the default, is the full 110rem frame: text keeps the reading measure at the frame's left
     * edge (.flow-wide) while figures, grids, tables and splits use the width. 'prose' is the centred 46rem reading column.
     */
    width?: 'content' | 'prose';
  };

const { eyebrow, lead, primary, secondary, photo, art, measure, cta, width = 'content', ...meta } = Astro.props;
const crumbs = meta.crumbs ?? buildCrumbs(meta.path, meta.title);
// A page that brings a photo or art gets the wider editorial frame. Without media a marketing page states its position, so it opens
// with the statement hero: the title is the claim, set large over the reading column, and the page needs no art to carry it.
const hasMedia = photo !== undefined || art !== undefined;
// The hero copy shares the body's left edge: the frame edge in the wide body, the reading column in the 'prose' body.
const heroMeasure = measure ?? (hasMedia || width === 'content' ? 'default' : 'prose');
const bodyClass = width === 'prose' ? 'container container--prose prose' : 'container flow-wide prose';
---

<BaseLayout {...meta} crumbs={crumbs}>
  {
    hasMedia ? (
      <PageHero title={meta.title} eyebrow={eyebrow} lead={lead} crumbs={crumbs} primary={primary} secondary={secondary} photo={photo} art={art} measure={heroMeasure} />
    ) : (
      <HeroCompact variant="statement" title={meta.title} eyebrow={eyebrow} lead={lead} crumbs={crumbs} primary={primary} secondary={secondary} measure={heroMeasure} />
    )
  }
  <div class="section">
    <div class={bodyClass}>
      <slot />
    </div>
  </div>
  <slot name="after" />
  <slot name="cta-end">{!Astro.slots.has('after') && <CtaEnd path={meta.path} collection="pages" cta={cta} />}</slot>
</BaseLayout>
