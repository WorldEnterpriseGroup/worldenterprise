---
import BaseLayout from './BaseLayout.astro';
import PageHero from '../components/hero/PageHero.astro';
import { buildCrumbs } from '../lib/breadcrumbs.ts';
import type { HeaderProps, PageMeta } from './types.ts';
type Props = PageMeta & HeaderProps & { title: string };

const { eyebrow, lead, primary, secondary, photo, art, measure, ...meta } = Astro.props;
const crumbs = meta.crumbs ?? buildCrumbs(meta.path, meta.title);
// The body is a reading column, so the hero copy shares its edge. A page that brings a photo or art gets the wider editorial frame.
const heroMeasure = measure ?? (photo !== undefined || art !== undefined ? 'default' : 'prose');
---

<BaseLayout {...meta} crumbs={crumbs}>
  <PageHero title={meta.title} eyebrow={eyebrow} lead={lead} crumbs={crumbs} primary={primary} secondary={secondary} photo={photo} art={art} measure={heroMeasure} />
  <div class="section">
    <div class="container container--prose prose">
      <slot />
    </div>
  </div>
  <slot name="after" />
</BaseLayout>
