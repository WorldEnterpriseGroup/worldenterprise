---
import BaseLayout from './BaseLayout.astro';
import CtaEnd from '../components/cta/CtaEnd.astro';
import PageHero from '../components/hero/PageHero.astro';
import { APPLY } from '../components/hero/ctas.ts';
import { getStage } from '../components/program/stages.ts';
import { buildCrumbs } from '../lib/breadcrumbs.ts';
import type { HeaderProps, PageMeta } from './types.ts';
import ContextualNext from '../components/blocks/ContextualNext.astro';
import StageRail from '../components/program/StageRail.astro';

const ALTITUDES = { dream: 'Survey', build: 'Blueprint', grow: 'Territory' } as const;

interface NextItem {
  readonly title: string;
  readonly href: string;
  readonly description?: string;
}

type Props = PageMeta & HeaderProps & {
  title: string;
  /** Dream, Build and Grow are three altitudes of the same map: survey, blueprint, territory. */
  stage?: keyof typeof ALTITUDES;
  next?: readonly NextItem[];
};

const { eyebrow, lead, stage, next = [], primary = APPLY, secondary, photo, art, measure, cta, ...meta } = Astro.props;
const crumbs = meta.crumbs ?? buildCrumbs(meta.path, meta.title);
const altitude = stage ? ALTITUDES[stage] : undefined;
// A stage page shows its own stage image. The pages that are about the path as a whole show the flower, or the trail they pass.
const heroPhoto = photo ?? (stage ? getStage(stage).slot : undefined);
const heroArt = heroPhoto !== undefined ? art : (art ?? { variant: 'flower' as const });
---

<BaseLayout {...meta} crumbs={crumbs}>
  <PageHero
    title={meta.title}
    eyebrow={eyebrow ?? (altitude ? `${altitude} altitude` : undefined)}
    lead={lead}
    crumbs={crumbs}
    primary={primary}
    secondary={secondary}
    photo={heroPhoto}
    art={heroArt}
    measure={measure}
  />
  {
    stage && (
      <div class="section section--tight">
        <div class="container">
          <StageRail current={stage} />
        </div>
      </div>
    )
  }
  <div class="section">
    <div class="container stack">
      <slot />
    </div>
  </div>
  <slot name="after" />
  {
    next.length > 0 && (
      <div class="section section--soft section--tinted section--tint-blue section--defer">
        <div class="container">
          <ContextualNext items={next} />
        </div>
      </div>
    )
  }
  <slot name="cta-end">{!Astro.slots.has('after') && <CtaEnd path={meta.path} collection="pages" cta={cta} />}</slot>
</BaseLayout>
