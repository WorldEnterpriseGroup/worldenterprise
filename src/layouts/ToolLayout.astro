---
import BaseLayout from './BaseLayout.astro';
import PageHero from '../components/hero/PageHero.astro';
import { buildCrumbs } from '../lib/breadcrumbs.ts';
import type { HeaderProps, PageMeta } from './types.ts';
type Props = PageMeta & HeaderProps & {
  title: string;
  /** Shown when JavaScript is off and the tool is an island. */
  noscript?: string;
};

const { eyebrow, lead, noscript, primary, secondary, photo, art, measure, ...meta } = Astro.props;
const crumbs = meta.crumbs ?? buildCrumbs(meta.path, meta.title);
---

<BaseLayout {...meta} crumbs={crumbs}>
  <PageHero title={meta.title} eyebrow={eyebrow ?? 'Tool'} lead={lead} crumbs={crumbs} primary={primary} secondary={secondary} photo={photo} art={art} measure={measure} />
  <div class="section">
    <div class="container stack">
      {noscript && <noscript><p class="callout">{noscript}</p></noscript>}
      <slot />
    </div>
  </div>
  <slot name="after" />
</BaseLayout>
