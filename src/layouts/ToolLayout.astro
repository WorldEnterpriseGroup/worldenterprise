---
import BaseLayout from './BaseLayout.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import { buildCrumbs } from '../lib/breadcrumbs.ts';
import type { HeaderProps, PageMeta } from './types.ts';
type Props = PageMeta & HeaderProps & {
  title: string;
  /** Shown when JavaScript is off and the tool is an island. */
  noscript?: string;
};

const { eyebrow, lead, noscript, ...meta } = Astro.props;
const crumbs = meta.crumbs ?? buildCrumbs(meta.path, meta.title);
---

<BaseLayout {...meta} crumbs={crumbs}>
  <PageHeader title={meta.title} eyebrow={eyebrow ?? 'Tool'} lead={lead} crumbs={crumbs} />
  <div class="section">
    <div class="container stack">
      {noscript && <noscript><p class="callout">{noscript}</p></noscript>}
      <slot />
    </div>
  </div>
  <slot name="after" />
</BaseLayout>
