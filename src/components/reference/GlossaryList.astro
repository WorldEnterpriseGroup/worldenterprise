---
import { anchorId, definitionMarkers, groupAnchorId, orderedGroups } from './jsonld.ts';

interface SeeAlsoLink {
  readonly href: string;
  readonly label: string;
}

interface Term {
  readonly id: string;
  readonly term: string;
  readonly definition: string;
  readonly group: string;
  readonly related: readonly string[];
  /** Wraps the definition in `data-generic-definition` (the SAFE-mechanics terms). */
  readonly genericDefinition?: boolean;
  /** Wraps the definition in `data-claim-allow` for each claims-denylist rule id. */
  readonly claimAllow?: readonly string[];
  /** Links to pages that are live, already resolved by the page. */
  readonly seeAlso?: readonly SeeAlsoLink[];
}

interface Props {
  terms: readonly Term[];
}

const { terms } = Astro.props;
const byTerm = (a: Term, b: Term): number => a.term.localeCompare(b.term, 'en', { sensitivity: 'base' });
const byId = new Map(terms.map((t) => [t.id, t]));
const sections = orderedGroups([...terms].sort(byTerm));
---

<nav class="glossary-index" aria-label="Jump to a group of terms">
  <ul class="glossary-index__list" role="list">
    {sections.map((section) => <li><a href={`#${groupAnchorId(section.group)}`}>{section.group}</a></li>)}
  </ul>
</nav>

<div class="stack stack--loose">
  {
    sections.map((section) => (
      <section aria-labelledby={groupAnchorId(section.group)} class="stack">
        <h2 id={groupAnchorId(section.group)}>{section.group}</h2>
        <dl class="glossary-list">
          {section.items.map((t) => {
            const related = t.related.filter((r) => byId.has(r));
            const seeAlso = t.seeAlso ?? [];
            return (
              <div class="glossary-list__entry">
                <dt id={anchorId('term', t.id)}>{t.term}</dt>
                <dd>
                  <p {...definitionMarkers(t)}>{t.definition}</p>
                  {(related.length > 0 || seeAlso.length > 0) && (
                    <p class="glossary-list__meta">
                      {related.length > 0 && (
                        <span>
                          See also:{' '}
                          {related.map((r, i) => (
                            <Fragment>
                              {i > 0 && ', '}
                              <a href={`#${anchorId('term', r)}`}>{byId.get(r)?.term}</a>
                            </Fragment>
                          ))}
                        </span>
                      )}
                      {seeAlso.length > 0 && (
                        <span>
                          Read more:{' '}
                          {seeAlso.map((link, i) => (
                            <Fragment>
                              {i > 0 && ', '}
                              <a href={link.href}>{link.label}</a>
                            </Fragment>
                          ))}
                        </span>
                      )}
                    </p>
                  )}
                </dd>
              </div>
            );
          })}
        </dl>
      </section>
    ))
  }
</div>

<style>
  .glossary-index {
    padding-block-end: var(--sp-4);
    border-block-end: var(--border-hair);
  }

  /*
   * The jump list is a grid of equal cells, each a fixed height that holds two lines. How many cells fit a row depends on the width of the
   * page, never on the width of a label, and a label that wraps one way in the fallback font and another in the web font stays inside its
   * cell. Wrapping chips moved the whole list when the fonts arrived (layout-shift budget, WP-77 fix-forward).
   */
  .glossary-index__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 10rem), 1fr));
    gap: var(--sp-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .glossary-index a {
    display: flex;
    align-items: center;
    justify-content: center;
    block-size: 3rem;
    padding-inline: var(--sp-2);
    border: var(--border-hair);
    border-radius: var(--radius-md);
    font-family: var(--ff-display);
    font-size: var(--fs-sm);
    font-weight: 600;
    line-height: var(--lh-snug);
    text-align: center;
    text-wrap: balance;
  }

  h2 {
    scroll-margin-block-start: calc(var(--header-h) + var(--sp-4));
  }

  .glossary-list {
    display: grid;
    gap: var(--sp-5);
    margin: 0;
  }

  .glossary-list__entry {
    scroll-margin-block-start: calc(var(--header-h) + var(--sp-4));
  }

  dt {
    font-family: var(--ff-display);
    font-size: var(--fs-lg);
    font-weight: 700;
    scroll-margin-block-start: calc(var(--header-h) + var(--sp-4));
  }

  dd {
    margin: var(--sp-2) 0 0;
  }

  dd p {
    margin: 0;
  }

  .glossary-list__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-5);
    margin-block-start: var(--sp-2);
    color: var(--color-text-muted);
    font-size: var(--fs-sm);
  }
</style>
