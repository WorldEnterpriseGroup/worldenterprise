---
import { href } from '../../lib/url.ts';
import { photoImage } from '../media/photo-image.ts';
import CellTrail from '../ui/CellTrail.astro';
import { LINE_SLOT, servicePath } from './lines.ts';
import type { ServiceSummary } from './data.ts';
import type { ServiceLine } from '../../data/nav.ts';

interface Props {
  line: ServiceLine;
  lines: readonly ServiceSummary[];
}

const { line, lines } = Astro.props;
const photo = await photoImage(LINE_SLOT[line], { sizes: '(min-width: 62rem) 32rem, 100vw' });
const current = lines.findIndex((l) => l.entry.data.line === line);
const cells = lines.map(({ slug, entry }) => ({ label: entry.data.shortTitle, href: href(servicePath(slug)) }));
---

<img class="line-aside__image" src={photo.src} srcset={photo.srcset} sizes={photo.srcset === undefined ? undefined : photo.sizes} width={photo.width} height={photo.height} alt={photo.alt} loading="lazy" decoding="async" />
<CellTrail label="All service lines" cells={cells} current={current >= 0 ? current : undefined} />

<style>
  @layer pages {
    .line-aside__image {
      inline-size: 100%;
      block-size: auto;
      aspect-ratio: 4 / 3;
      object-fit: cover;
      border-radius: var(--radius-md);
    }
  }
</style>
