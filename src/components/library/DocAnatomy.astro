---
/**
 * DocAnatomy: what every library document is made of (WP-24), drawn as one page with four numbered parts and the same four parts as a
 * list beside it: what the document is for, the fields to fill, the checks, and the Markdown copy to take away. An illustration of the
 * shared structure, not of any one document. Authored SVG; no script.
 */
import HubFigure from '../hubs/HubFigure.astro';

const W = 720;
const H = 520;
const PARTS = [
  { n: 1, title: 'What it is for', line: 'A title and one paragraph on when to use the document.' },
  { n: 2, title: 'Fields to fill', line: 'Plain headings with space for your own answers.' },
  { n: 3, title: 'Checks', line: 'Where the document has them, statements to tick when they are true of your company.' },
  { n: 4, title: 'A Markdown copy', line: 'The same document as a static file, for your own notes or tools.' },
] as const;
---

<HubFigure
  id="hub-library-anatomy"
  kind="illustration"
  title="Inside every document"
  caption="Four parts, shared across the templates, checklists, worksheets and guides."
  credit="Illustration: World Enterprise Group Incorporated. A drawing of the shared structure, not of a single document."
  width={W}
  height={H}
  alt="A page with four numbered parts: a title block at the top (1), lined fields to fill (2), a list of tick boxes (3), and a folded corner marked as the Markdown copy (4)."
>
  <rect class="hf-paper" x="0" y="0" width={W} height={H} rx="18" />
  <path class="doc-anatomy__page" d="M150 40 H520 L580 100 V480 H150 Z" />
  <path class="hf-amber" d="M520 40 L580 100 H520 Z" />
  <rect class="hf-ink" x="186" y="72" width="220" height="18" rx="4" />
  <rect class="hf-mist" x="186" y="102" width="300" height="10" rx="5" />
  <rect class="hf-mist" x="186" y="120" width="260" height="10" rx="5" />
  {[0, 1, 2].map((i) => (
    <>
      <rect class="hf-slate" x="186" y={160 + i * 50} width="120" height="10" rx="5" />
      <line class="hf-rule" x1="186" y1={190 + i * 50} x2="540" y2={190 + i * 50} />
    </>
  ))}
  {[0, 1, 2, 3].map((i) => (
    <>
      <rect class={i < 2 ? 'hf-blue' : 'doc-anatomy__box'} x="186" y={330 + i * 34} width="18" height="18" rx="3" />
      <rect class="hf-mist" x="216" y={334 + i * 34} width={i % 2 === 0 ? 260 : 200} height="10" rx="5" />
    </>
  ))}
  {
    [
      { n: 1, x: 110, y: 96 },
      { n: 2, x: 110, y: 214 },
      { n: 3, x: 110, y: 380 },
      { n: 4, x: 620, y: 70 },
    ].map((c) => (
      <g>
        <circle class="hf-ink" cx={c.x} cy={c.y} r="22" />
        <text class="hf-text hf-text--strong hf-text--inverse doc-anatomy__num" x={c.x} y={c.y + 8} text-anchor="middle">
          {c.n}
        </text>
      </g>
    ))
  }
  <ol class="doc-anatomy__legend" slot="legend" role="list">
    {
      PARTS.map((p) => (
        <li>
          <span class="doc-anatomy__key" aria-hidden="true">{p.n}</span>
          <span><strong>{p.title}.</strong> {p.line}</span>
        </li>
      ))
    }
  </ol>
</HubFigure>

<style>
  .doc-anatomy__page {
    fill: var(--we-white);
    stroke: var(--color-border-strong);
    stroke-width: 2;
  }

  .doc-anatomy__box {
    fill: none;
    stroke: var(--we-slate);
    stroke-width: 2;
  }

  .doc-anatomy__num {
    font-size: 22px;
  }

  .doc-anatomy__legend {
    display: grid;
    gap: var(--sp-2);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--fs-sm);

    & li {
      display: flex;
      gap: var(--sp-2);
      align-items: start;
    }
  }

  .doc-anatomy__key {
    flex: none;
    display: inline-grid;
    place-items: center;
    inline-size: 1.75rem;
    block-size: 1.75rem;
    border-radius: 50%;
    background: var(--we-blue-night);
    color: var(--we-white);
    font-weight: 700;
    font-size: var(--fs-xs);
  }

  @media (forced-colors: active) {
    .doc-anatomy__page,
    .doc-anatomy__box {
      fill: Canvas;
      stroke: CanvasText;
    }

    .doc-anatomy__key {
      border: 1px solid CanvasText;
    }
  }
</style>
