---
/**
 * DecadeCarousel (WP-22, #88): the seven milestones of the first-decade film as a Carousel of cards, each with its figure and source.
 * The same storyboard (./decade.ts) as the film, so the cards and the film always quote the same register entries.
 */
import Carousel from './Carousel.astro';
import { chapterSources, chapterStat, decadeMilestones } from './decade.ts';

interface Props {
  id?: string;
  /** Id of the visible heading that names the carousel. */
  labelledby?: string;
}

const { id = 'decade-milestones', labelledby } = Astro.props;
const cards = decadeMilestones().map((chapter) => {
  const figure = chapterStat(chapter);
  if (figure === undefined) throw new Error(`DecadeCarousel: the milestone "${chapter.id}" has no statistic`);
  return { chapter, figure, sources: chapterSources(chapter) };
});
---

<Carousel id={id} label="A company's first decade, milestone by milestone" labelledby={labelledby}>
  {
    cards.map(({ chapter, figure, sources }) => (
      <li class="milestone" id={`${id}-${chapter.id}`} data-label={chapter.title}>
        <p class="milestone__when">{chapter.when}</p>
        <h3 class="milestone__title">{chapter.title}</h3>
        <p class="milestone__value">{figure.value}</p>
        <p class="milestone__label">{figure.label}.</p>
        <p class="milestone__line">{chapter.line}</p>
        <p class="milestone__source">
          {figure.period}. Source:{' '}
          {sources.map((s, i) => (
            <>
              {i > 0 && '; '}
              <a href={s.url}>{s.short}</a>
            </>
          ))}
        </p>
      </li>
    ))
  }
</Carousel>

<style>
  .milestone {
    display: grid;
    grid-template-rows: auto auto auto auto 1fr auto;
    align-content: start;
    gap: var(--sp-2);
    block-size: 100%;
    box-sizing: border-box;
    padding: var(--sp-5);
    border: var(--border-hair) solid var(--color-border);
    border-radius: var(--radius-lg);
    background-color: var(--color-bg-soft);

    & p,
    & h3 {
      margin: 0;
    }
  }

  .milestone__when {
    font-family: var(--ff-display);
    font-size: var(--fs-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    color: var(--color-text-muted);
  }

  .milestone__title {
    font-size: var(--fs-lg);
    line-height: var(--lh-snug);
  }

  .milestone__value {
    font-family: var(--ff-display);
    font-size: var(--fs-3xl);
    font-weight: 700;
    line-height: var(--lh-tight);
    font-variant-numeric: tabular-nums;
  }

  .milestone__line,
  .milestone__label {
    line-height: var(--lh-body);
  }

  .milestone__source {
    font-size: var(--fs-xs);
    color: var(--color-text-muted);
  }
</style>
