---
/**
 * Scene: the frame every three.js visual lives in (ARCHITECTURE 3.2). It always renders the poster, a real AVIF frame of the same
 * scene, inside a reserved aspect-ratio box, so no-JS, reduced-motion, mobile and Lighthouse visitors see a finished picture and the
 * page never shifts. On a capable desktop the <we-scene> stub loads three and the scene after the frame nears the viewport, then
 * crossfades from the poster. Labels are real HTML (links or text) placed over the frame, and fall back to a list below it on narrow
 * containers.
 *
 * Usually used through a named wrapper (GalaxyScene, LaunchTrajectory, OrbitSystem, WorldForge, StarfieldBand), not directly.
 */
import type { SceneName, SceneOptions } from '../../scripts/visuals/types.ts';
import { cleanText, ratioClass, sceneRatio } from './contracts.ts';
import type { SceneRatio } from './contracts.ts';
import { posterImage } from './poster.ts';
import type { PosterSource } from './poster.ts';
import './positions.css';

interface Props {
  scene: SceneName;
  /** A poster key (src/assets/visuals/posters/) or an imported image. */
  poster: PosterSource;
  /** What the poster shows. Required: the poster is the scene's text equivalent for every visitor. */
  alt: string;
  ratio?: SceneRatio;
  options?: SceneOptions;
  sizes?: string;
  caption?: string;
  /** Accessible name of the label list, when the scene has labels. */
  labelsName?: string;
  /** Always show the poster (for the styleguide, print-like contexts, or a page with another scene already running). */
  static?: boolean;
  /** Fill the positioned parent instead of keeping an aspect ratio (band backgrounds). */
  fill?: boolean;
  /** Decorative background (a band): the poster gets alt="" and the frame is hidden from assistive technology (the pause button stays reachable). */
  decorative?: boolean;
  /**
   * `edges` (the default for a framed scene) feathers all four edges of the frame into the page with a CSS mask, so there is no box;
   * `none` keeps a hard edge. A `fill` scene never feathers: its band or hero owns the edges (see Band `bleed`).
   */
  feather?: 'edges' | 'none';
  /**
   * Names the scene's frame `hero-media` for cross-document view transitions, so the hero picture of one page morphs into the next page's
   * (one per page; a page with two names aborts its transition). Only the page's lead scene sets it.
   */
  hero?: boolean;
  /** `float` places labels over the frame at their anchors on wide containers; `list` always lists them below the frame. */
  labels?: 'float' | 'list';
  class?: string;
}

const {
  scene,
  poster,
  alt,
  ratio = '16/9',
  options = {},
  sizes = '100vw',
  caption,
  labelsName = 'Labels',
  static: isStatic = false,
  fill = false,
  decorative = false,
  labels = 'float',
  feather = 'edges',
  hero = false,
  class: className,
} = Astro.props;

const r = sceneRatio('Scene', ratio);
const altText = decorative ? '' : cleanText('Scene', 'alt', alt);
if (caption !== undefined) cleanText('Scene', 'caption', caption);
// A hero renders its own poster image (high fetch priority, the LCP image) in the `poster` slot; every other scene gets a lazy one here.
const image = Astro.slots.has('poster') ? null : await posterImage(poster, sizes);
const hasLabels = Astro.slots.has('labels');
const hasOverlay = Astro.slots.has('overlay');
const hasLegend = Astro.slots.has('legend');
const hasDetail = Astro.slots.has('detail');
const uid = Math.abs([...`${scene}|${alt}|${caption ?? ''}`].reduce((h, c) => (h * 31 + c.charCodeAt(0)) | 0, 7)).toString(36);
const legendId = `legend-${scene}-${uid}`;
const detailId = `detail-${scene}-${uid}`;
const optionsJson = Object.keys(options).length > 0 ? JSON.stringify(options) : undefined;
---

<we-scene
  class:list={['scene', fill && 'scene--fill', !fill && feather === 'edges' && 'scene--feather', hero && 'scene--hero', labels === 'list' && 'scene--list', className]}
  data-scene={scene}
  data-options={optionsJson}
  data-static={isStatic ? '' : undefined}
  data-state="poster"
>
  <figure class="scene__figure" role={decorative ? 'none' : undefined}>
    <div class="scene__stage">
      <div class:list={['scene__frame', !fill && ratioClass(r)]} aria-hidden={decorative ? 'true' : undefined}>
        {
          image === null ? (
            <slot name="poster" />
          ) : (
            <img
              class="scene__poster"
              src={image.src}
              srcset={image.srcset}
              sizes={image.sizes}
              width={image.width}
              height={image.height}
              alt={altText}
              decoding="async"
              loading="lazy"
            />
          )
        }
        {
          hasOverlay && (
            <div class="scene__overlay" aria-hidden="true">
              <slot name="overlay" />
            </div>
          )
        }
      </div>
      {
        hasLabels && (
          <ol class="scene__labels" aria-label={labelsName} role="list">
            <slot name="labels" />
          </ol>
        )
      }
      {
        (hasLegend || hasDetail) && (
          <div class="scene__tools">
            {hasLegend && (
              <button class="scene__tool" type="button" popovertarget={legendId} popovertargetaction="toggle">
                Key
              </button>
            )}
            {hasDetail && (
              <button class="scene__tool" type="button" hidden data-detail-for={detailId} commandfor={detailId} command="show-modal">
                About this scene
              </button>
            )}
          </div>
        )
      }
      {
        hasLegend && (
          <div class="scene__legend" id={legendId} popover="auto" role="group" aria-label="Key to the scene">
            <slot name="legend" />
          </div>
        )
      }
      {
        hasDetail && (
          <dialog class="scene__detail" id={detailId} closedby="any" aria-label="About this scene">
            <slot name="detail" />
            <form method="dialog">
              <button class="scene__tool" type="submit">
                Close
              </button>
            </form>
          </dialog>
        )
      }
      <button class="scene__toggle" type="button" hidden aria-pressed="false" data-play="Play animation" data-pause="Pause animation">
        <svg class="scene__toggle-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <rect class="scene__toggle-pause" x="4" y="3" width="3" height="10" rx="1"></rect>
          <rect class="scene__toggle-pause" x="9" y="3" width="3" height="10" rx="1"></rect>
          <path class="scene__toggle-play" d="M5 3.2v9.6a.6.6 0 0 0 .9.5l7.6-4.8a.6.6 0 0 0 0-1L5.9 2.7a.6.6 0 0 0-.9.5z"></path>
        </svg>
        <span class="scene__toggle-text">Pause animation</span>
      </button>
    </div>
    {caption !== undefined && <figcaption class="scene__caption">{caption}</figcaption>}
  </figure>
</we-scene>

<script>
  import { defineWeScene } from '../../scripts/visuals/scene-element.ts';

  defineWeScene();
</script>

<style>
  we-scene {
    display: block;
    container-type: inline-size;
    container-name: scene;
  }

  .scene--fill {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .scene__figure {
    margin: 0;
  }

  .scene--fill .scene__figure,
  .scene--fill .scene__stage,
  .scene--fill .scene__frame {
    block-size: 100%;
  }

  .scene__stage {
    position: relative;
  }

  /* The deep-space sky. The posters are rendered over exactly this color, so poster, canvas and frame agree. */
  .scene__frame {
    position: relative;
    overflow: hidden;
    background-color: color-mix(in oklab, var(--we-blue-night) 45%, var(--we-charcoal));
    border-radius: inherit;
  }

  .ratio-16-9 {
    aspect-ratio: 16 / 9;
  }

  .ratio-21-9 {
    aspect-ratio: 21 / 9;
  }

  .ratio-4-3 {
    aspect-ratio: 4 / 3;
  }

  .ratio-1-1 {
    aspect-ratio: 1;
  }

  .ratio-3-1 {
    aspect-ratio: 3;
  }

  .scene__frame :global(.scene__poster),
  .scene__overlay,
  .scene__frame :global(.scene__canvas) {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
  }

  .scene__frame :global(.scene__poster) {
    object-fit: cover;
  }

  .scene__overlay {
    z-index: 2;
  }

  .scene__overlay :global(svg) {
    display: block;
    inline-size: 100%;
    block-size: 100%;
  }

  .scene__frame :global(.scene__canvas) {
    z-index: 1;
    display: block;
  }

  /* Once the first live frame has rendered, the poster and its overlay fade out under the canvas. */
  we-scene.is-live :global(.scene__poster),
  we-scene.is-live .scene__overlay {
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .scene__frame :global(.scene__poster),
    .scene__overlay,
    .scene__frame :global(.scene__canvas) {
      transition-property: opacity;
      transition-duration: var(--dur-slow);
      transition-timing-function: var(--ease-out);
    }

    /* The canvas joins the DOM already drawn; @starting-style fades it in while the poster fades out, so the swap is a crossfade. */
    @starting-style {
      .scene__frame :global(.scene__canvas) {
        opacity: 0;
      }
    }
  }

  /*
   * Seamless edges (WP-36): a framed scene has no box. Two linear masks (one per axis) intersect, so every edge dissolves into the page
   * over --fade-x / --fade-y and the corners fade twice as softly. The mask sits on the frame, so the poster and the canvas fade together
   * and labels (outside the frame) stay crisp. Browsers without mask-composite keep the plain frame.
   */
  @supports (mask-composite: intersect) or (-webkit-mask-composite: source-in) {
    .scene--feather .scene__frame {
      --_bx: 11%;
      --_by: 16%;
      --fade-x: calc(var(--_bx) + var(--depth, 0) * 10%);
      --fade-y: calc(var(--_by) + var(--depth, 0) * 14%);
      --_ease-x: linear-gradient(
        to right,
        transparent 0,
        rgb(0 0 0 / 0.18) calc(var(--fade-x) * 0.35),
        rgb(0 0 0 / 0.62) calc(var(--fade-x) * 0.7),
        #000 var(--fade-x),
        #000 calc(100% - var(--fade-x)),
        rgb(0 0 0 / 0.62) calc(100% - var(--fade-x) * 0.7),
        rgb(0 0 0 / 0.18) calc(100% - var(--fade-x) * 0.35),
        transparent 100%
      );
      --_ease-y: linear-gradient(
        to bottom,
        transparent 0,
        rgb(0 0 0 / 0.18) calc(var(--fade-y) * 0.35),
        rgb(0 0 0 / 0.62) calc(var(--fade-y) * 0.7),
        #000 var(--fade-y),
        #000 calc(100% - var(--fade-y)),
        rgb(0 0 0 / 0.62) calc(100% - var(--fade-y) * 0.7),
        rgb(0 0 0 / 0.18) calc(100% - var(--fade-y) * 0.35),
        transparent 100%
      );
      border-radius: 0;
      -webkit-mask-image: var(--_ease-x), var(--_ease-y);
      mask-image: var(--_ease-x), var(--_ease-y);
      -webkit-mask-composite: source-in;
      mask-composite: intersect;
    }

    /* A narrow container keeps more of the picture: the fade shrinks with the frame. */
    @container scene (width < 40rem) {
      .scene--feather .scene__frame {
        --_bx: 6%;
        --_by: 10%;
      }
    }
  }

  /*
   * Scroll-driven depth, no movement and no scroll-jacking: as a framed scene enters and leaves the viewport its edges feather a little
   * more (--depth 1 at the viewport edges, 0 through the middle), so the world seems to materialise out of the page. animation-timeline:
   * view() runs on the compositor-friendly scroll timeline; without support the edges simply stay at their resting feather.
   */
  @property --depth {
    syntax: '<number>';
    inherits: false;
    initial-value: 0;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .scene--feather .scene__frame {
        animation-name: scene-materialize;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: cover;
      }

      @keyframes scene-materialize {
        0% {
          --depth: 1;
        }
        30%,
        70% {
          --depth: 0;
        }
        100% {
          --depth: 1;
        }
      }
    }
  }

  /* Labels: a list below the frame by default (narrow containers, and the text equivalent for everyone). */
  .scene__labels {
    display: grid;
    gap: var(--sp-2);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
    margin: 0;
    margin-block-start: var(--sp-3);
    padding: 0;
    list-style: none;
  }

  .scene__labels :global(.scene__label) {
    display: grid;
    gap: 2px;
    padding: var(--sp-2) var(--sp-3);
    font-family: var(--ff-sans);
    font-size: var(--fs-sm);
    line-height: var(--lh-snug);
    color: var(--color-text);
    background: var(--color-bg-soft);
    border-inline-start: 3px solid var(--color-accent);
    border-radius: var(--radius-sm);
  }

  .scene__labels :global(.scene__label-note) {
    color: var(--color-text-muted);
  }

  .scene__labels :global(.scene__label a) {
    color: var(--color-link);
    font-weight: 600;
  }

  /* Wide containers: each label floats over the frame at its anchor (static classes, or --x and --y from the live scene). */
  @container scene (min-width: 48rem) {
    .scene:not(.scene--list) .scene__labels {
      position: absolute;
      inset: 0;
      display: block;
      margin: 0;
      pointer-events: none;
    }

    .scene:not(.scene--list) .scene__labels :global(.scene__label) {
      position: absolute;
      left: var(--x, var(--px, 50%));
      top: var(--y, var(--py, 50%));
      transform: translate(-50%, calc(-100% - var(--sp-2)));
      max-inline-size: 15rem;
      padding: var(--sp-1) var(--sp-2);
      color: var(--color-text-inverse);
      text-align: center;
      background: color-mix(in oklab, var(--we-blue-night) 78%, transparent);
      border: 1px solid color-mix(in oklab, var(--we-tint) 35%, transparent);
      border-inline-start-width: 1px;
      border-radius: var(--radius-sm);
      pointer-events: auto;
      backdrop-filter: blur(4px);
    }

    .scene:not(.scene--list) .scene__labels :global(.scene__label.is-below) {
      transform: translate(-50%, var(--sp-2));
    }

    .scene:not(.scene--list) .scene__labels :global(.scene__label-note) {
      color: var(--we-tint);
      font-size: var(--fs-xs);
    }

    .scene:not(.scene--list) .scene__labels :global(.scene__label a) {
      color: var(--color-text-inverse);
      text-decoration-color: var(--we-amber);
    }

    .scene:not(.scene--list) .scene__labels :global(.scene__label a:focus-visible) {
      outline: 2px solid var(--color-focus-inverse);
      outline-offset: 2px;
    }
  }

  /* The pause control (WCAG 2.2.2): a real button outside the canvas, shown only while a scene runs. */
  .scene__toggle {
    position: absolute;
    inset-block-end: var(--sp-3);
    inset-inline-end: var(--sp-3);
    z-index: 3;
    display: inline-flex;
    gap: var(--sp-2);
    align-items: center;
    min-block-size: 2.75rem;
    padding: var(--sp-2) var(--sp-3);
    font-family: var(--ff-sans);
    font-size: var(--fs-sm);
    color: var(--color-text-inverse);
    background: color-mix(in oklab, var(--we-blue-night) 82%, transparent);
    border: 1px solid color-mix(in oklab, var(--we-tint) 45%, transparent);
    border-radius: var(--radius-pill);
    cursor: pointer;
  }

  .scene__toggle[hidden] {
    display: none;
  }

  .scene__toggle:focus-visible {
    outline: 2px solid var(--color-focus-inverse);
    outline-offset: 2px;
  }

  .scene__toggle-icon {
    inline-size: 1rem;
    block-size: 1rem;
    fill: currentcolor;
  }

  .scene__toggle-play,
  .scene__toggle[aria-pressed='true'] .scene__toggle-pause {
    display: none;
  }

  .scene__toggle[aria-pressed='true'] .scene__toggle-play {
    display: inline;
  }

  /* A scene's key: a real popover (Esc and outside click close it, no script), anchored to its button where CSS anchor positioning exists. */
  /* The key and the about button, bottom left of the frame (the pause button is bottom right). */
  .scene__tools {
    position: absolute;
    inset-block-end: var(--sp-3);
    inset-inline-start: var(--sp-3);
    z-index: 3;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }

  .scene__tool {
    min-block-size: 2.75rem;
    padding: var(--sp-2) var(--sp-3);
    font-family: var(--ff-sans);
    font-size: var(--fs-sm);
    color: var(--color-text-inverse);
    background: color-mix(in oklab, var(--we-blue-night) 82%, transparent);
    border: 1px solid color-mix(in oklab, var(--we-tint) 45%, transparent);
    border-radius: var(--radius-pill);
    cursor: pointer;
  }

  .scene__tool[hidden] {
    display: none;
  }

  .scene__tool:focus-visible {
    outline: 2px solid var(--color-focus-inverse);
    outline-offset: 2px;
  }

  /* <dialog closedby="any">: Esc, a click outside or the Close button dismiss it, with no script. */
  .scene__detail {
    max-inline-size: min(32rem, calc(100vw - 2 * var(--sp-4)));
    padding: var(--sp-5);
    font-family: var(--ff-sans);
    line-height: var(--lh-snug);
    color: var(--color-text-inverse);
    background: color-mix(in oklab, var(--we-blue-night) 94%, black);
    border: 1px solid color-mix(in oklab, var(--we-tint) 40%, transparent);
    border-radius: var(--radius-md, var(--radius-sm));
  }

  .scene__detail::backdrop {
    background: color-mix(in oklab, var(--we-blue-night) 55%, transparent);
    backdrop-filter: blur(6px);
  }

  .scene__detail form {
    margin-block-start: var(--sp-4);
  }

  @media (prefers-reduced-motion: no-preference) {
    .scene__detail {
      transition:
        opacity var(--dur-base) var(--ease-out),
        scale var(--dur-base) var(--ease-out),
        overlay var(--dur-base) allow-discrete,
        display var(--dur-base) allow-discrete;
    }

    .scene__detail:not([open]) {
      opacity: 0;
      scale: 0.96;
    }

    @starting-style {
      .scene__detail[open] {
        opacity: 0;
        scale: 0.96;
      }
    }
  }

  .scene__legend {
    max-inline-size: min(22rem, calc(100vw - 2 * var(--sp-4)));
    padding: var(--sp-3) var(--sp-4);
    font-family: var(--ff-sans);
    font-size: var(--fs-sm);
    line-height: var(--lh-snug);
    color: var(--color-text-inverse);
    background: color-mix(in oklab, var(--we-blue-night) 92%, black);
    border: 1px solid color-mix(in oklab, var(--we-tint) 40%, transparent);
    border-radius: var(--radius-sm);
  }

  .scene__legend::backdrop {
    background: transparent;
  }

  @supports (position-anchor: auto) and (position-area: top) {
    .scene__legend {
      position-anchor: auto;
      position-area: top span-right;
      margin: 0;
      margin-block-end: var(--sp-2);
      position-try-fallbacks: flip-block, flip-inline;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .scene__legend {
      transition:
        opacity var(--dur-base) var(--ease-out),
        translate var(--dur-base) var(--ease-out),
        overlay var(--dur-base) allow-discrete,
        display var(--dur-base) allow-discrete;
      opacity: 1;
      translate: 0 0;
    }

    .scene__legend:not(:popover-open) {
      opacity: 0;
      translate: 0 0.5rem;
    }

    @starting-style {
      .scene__legend:popover-open {
        opacity: 0;
        translate: 0 0.5rem;
      }
    }

    /* The pause button appears (hidden attribute removed) with a fade instead of a pop. */
    .scene__toggle {
      transition:
        opacity var(--dur-base) var(--ease-out),
        display var(--dur-base) allow-discrete;
    }

    @starting-style {
      .scene__toggle {
        opacity: 0;
      }
    }
  }

  /*
   * Poster state only (no canvas mounted, tested with :has): a slow light sweep across the still frame, so the picture breathes where
   * the live scene does not run (software GL, a blocked GPU, Save-Data). --sheen is a typed custom property, so the browser interpolates
   * the gradient position itself. Desktop-width and motion-allowed only: phones and reduced motion keep a still poster.
   */
  @property --sheen {
    syntax: '<percentage>';
    inherits: false;
    initial-value: -30%;
  }

  @media (prefers-reduced-motion: no-preference) and (min-width: 64rem) and (pointer: fine) {
    .scene__stage:not(:has(:global(.scene__canvas))) .scene__frame::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 1;
      pointer-events: none;
      mix-blend-mode: screen;
      background: linear-gradient(
        105deg,
        transparent calc(var(--sheen) - 22%),
        color-mix(in oklab, var(--we-tint) 11%, transparent) var(--sheen),
        transparent calc(var(--sheen) + 22%)
      );
      animation: scene-sheen 26s ease-in-out infinite alternate;
    }

    @keyframes scene-sheen {
      to {
        --sheen: 130%;
      }
    }
  }

  /* Cross-document view transitions: the lead scene of a page is one named group, so the hero picture carries across a navigation. */
  @supports (view-transition-name: none) {
    @media (prefers-reduced-motion: no-preference) {
      .scene--hero .scene__frame {
        view-transition-name: hero-media;
      }

      :global(::view-transition-group(hero-media)) {
        animation-duration: 320ms;
        animation-timing-function: var(--ease-out);
      }
    }
  }

  .scene__caption {
    margin-block-start: var(--sp-2);
    font-family: var(--ff-sans);
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
  }

  /* With labels below the frame (narrow containers) the pause button sits on the frame, not on the list. */
  .scene--list .scene__labels + .scene__toggle {
    inset-block-end: auto;
    inset-block-start: var(--sp-3);
  }

  @container scene (width < 48rem) {
    .scene__labels + .scene__toggle {
      inset-block-end: auto;
      inset-block-start: var(--sp-3);
    }
  }

  @media (forced-colors: active) {
    .scene__labels :global(.scene__label) {
      border: 1px solid CanvasText;
    }
  }
</style>
