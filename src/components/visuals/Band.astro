---
/**
 * Band: a full-bleed section (docs/wave9-contracts.md 2 and 5). The background runs edge to edge; a `.container` inside holds the
 * content in the 110rem frame. The `.band` and `.band--<tone>` rules live in src/styles/layout.css (WP-51); this component only fixes
 * the markup and layers an optional background visual (slot `scene`) under the content.
 *
 *   <Band tone="deep" labelledby="h-worlds">
 *     <Scene slot="scene" scene="starfield" poster="starfield" alt="" decorative fill />   (or <HexField slot="scene" tone="dark" />)
 *     <h2 id="h-worlds">Worlds take years to build.</h2>
 *   </Band>
 *
 * A `deep` band is the dark galaxy band (W9-7): light text from the --color-band-deep-* tokens, never the logo.
 */
import { bandTone } from './contracts.ts';
import type { BandTone } from './contracts.ts';

interface Props {
  tone?: BandTone;
  id?: string;
  /** Id of the heading inside the band that names the section. */
  labelledby?: string;
  /** Skip layout and paint until the band nears the viewport (content-visibility: auto). Never on the first band of a page. */
  defer?: boolean;
  /**
   * A deep band with a scene dissolves into the sections above and below (a soft skirt of the band colour past its edges) instead of
   * ending on a hard line. Default on; `false` keeps the hard edge.
   */
  bleed?: boolean;
  class?: string;
}

const { tone = 'plain', id, labelledby, defer = false, bleed = true, class: className } = Astro.props;
const t = bandTone('Band', tone);
const hasScene = Astro.slots.has('scene');
---

<section
  class:list={['band', t !== 'plain' && `band--${t}`, hasScene && 'band--scene', hasScene && t === 'deep' && bleed && !defer && 'band--bleed', defer && 'band--defer', className]}
  id={id}
  aria-labelledby={labelledby}
>
  {
    hasScene && (
      <div class="band__scene">
        <slot name="scene" />
      </div>
    )
  }
  <div class="container band__content">
    <slot />
  </div>
</section>

<style>
  .band--scene {
    isolation: isolate;
  }

  .band__scene {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .band--scene .band__content {
    position: relative;
    z-index: 1;
  }

  /*
   * Bleed: the band's colour runs past its edges as a gradient that fades to nothing, so the dark band melts into the neighbouring
   * sections. The skirts are decorative pseudo-elements that never take pointer events; --bleed stays short so they never reach the
   * neighbours' text (every band pads its content by at least --band-pad).
   */
  .band--bleed {
    --bleed: clamp(2rem, 6vw, 5rem);
    z-index: 1;
  }

  .band--bleed::before,
  .band--bleed::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    z-index: -1;
    block-size: var(--bleed);
    pointer-events: none;
    --_c: var(--color-band-deep-bg);
  }

  .band--bleed::before {
    inset-block-end: 100%;
    background: linear-gradient(
      to bottom,
      transparent,
      color-mix(in oklab, var(--_c) 14%, transparent),
      color-mix(in oklab, var(--_c) 40%, transparent),
      color-mix(in oklab, var(--_c) 72%, transparent),
      var(--_c)
    );
  }

  .band--bleed::after {
    inset-block-start: 100%;
    background: linear-gradient(
      to top,
      transparent,
      color-mix(in oklab, var(--_c) 14%, transparent),
      color-mix(in oklab, var(--_c) 40%, transparent),
      color-mix(in oklab, var(--_c) 72%, transparent),
      var(--_c)
    );
  }

  .band--defer {
    content-visibility: auto;
    contain-intrinsic-size: auto 40rem;
  }
</style>
