---
/**
 * DeskConstellation: the insights desks as one galaxy arm (WP-24). Each desk is a cluster with one star per published article, so the
 * size of a cluster is the size of the desk; the clusters run along a single arm, in desk order. Numbers on the drawing match the
 * legend below it, where each desk is a link (to its topic page, or to its rail on this page). With `focus` the other desks dim, for a
 * topic page. Computed at build time from the collection; no script.
 */
import HubFigure from './HubFigure.astro';
import { armCenters, cluster, field, smoothPath } from './geometry.ts';
import { countLabel } from './filter.ts';
import { href as resolve } from '../../lib/url.ts';

interface Desk {
  readonly id: string;
  readonly name: string;
  readonly count: number;
  readonly href: string;
}

interface Props {
  id: string;
  desks: readonly Desk[];
  /** A desk id to light; the others dim. */
  focus?: string;
  title?: string;
  caption?: string;
}

const { id, desks, focus } = Astro.props;
if (desks.length === 0) throw new Error('DeskConstellation: needs at least one desk');
const W = 1600;
const H = 520;
const centers = armCenters(desks.length, W, H, 90);
const total = desks.reduce((n, d) => n + d.count, 0);
const skies = desks.map((d, i) => {
  const center = centers[i] ?? { x: W / 2, y: H / 2 };
  return { ...d, n: i + 1, center, stars: cluster(`desk-${d.id}`, d.count, center, 13), lit: focus === undefined || focus === d.id };
});
// A light field: the sky sits on the heaviest hub page (every article card below it), so the decoration stays at 64 dots.
const background = field('insights-sky', 64, W, H);
// The one amber object: the anchor star of the largest desk (the first, when two are equal), or of the focused desk.
const amber = focus ?? [...desks].sort((a, b) => b.count - a.count)[0]?.id;
const focused = focus === undefined ? undefined : desks.find((d) => d.id === focus);
const title = Astro.props.title ?? (focused !== undefined ? `${focused.name} among the insights desks` : 'The insights desks, one star per article');
const caption =
  Astro.props.caption ??
  (focused !== undefined
    ? `${focused.name} holds ${countLabel(focused.count, 'article', 'articles')} of ${total}. Each cluster is a desk; each star is one article.`
    : `${desks.length} desks and ${total} articles. Each cluster is a desk and each star one article, so the brightest arms are the deepest desks.`);
const alt = `A dark sky crossed by one spiral arm with ${desks.length} star clusters on it, numbered 1 to ${desks.length}. ${desks
  .map((d, i) => `${i + 1}, ${d.name}: ${countLabel(d.count, 'star', 'stars')}`)
  .join('; ')}.`;
---

<HubFigure
  id={id}
  kind="illustration"
  title={title}
  caption={caption}
  credit="Illustration: World Enterprise Group Incorporated, drawn at build time from the articles published on this site."
  width={W}
  height={H}
  alt={alt}
  table={{ caption: 'Published articles by desk', columns: ['Desk', 'Articles'], rows: desks.map((d) => [d.name, String(d.count)]) }}
  class="hub-sky"
>
  <rect class="hf-sky" x="0" y="0" width={W} height={H} rx="18" />
  {background.map((s) => <circle class="hf-star--dim" cx={s.x} cy={s.y} r={s.r} />)}
  <path class="hf-line" d={smoothPath(centers)} />
  {
    skies.map((d) => (
      <g class:list={['hub-sky__desk', !d.lit && 'is-dim']}>
        {d.stars.map((s, k) => (
          <circle class:list={[k === 0 && d.id === amber ? 'hf-amber' : 'hf-star']} cx={s.x} cy={s.y} r={s.r} />
        ))}
        <circle class="hub-sky__badge" cx={d.center.x} cy={d.center.y + (d.center.y > H / 2 ? -78 : 78)} r="17" />
        <text class="hf-text hf-text--strong hub-sky__num" x={d.center.x} y={d.center.y + (d.center.y > H / 2 ? -72 : 84)} text-anchor="middle">
          {d.n}
        </text>
      </g>
    ))
  }
  <ol class="hub-sky__legend" slot="legend" aria-label="Desks on the map">
    {
      skies.map((d) => (
        <li class:list={[!d.lit && 'is-dim']}>
          <span class="hub-sky__key" aria-hidden="true">{d.n}</span>
          <a href={d.href.startsWith('#') ? d.href : resolve(d.href)} aria-current={focus === d.id ? 'page' : undefined}>{d.name}</a>
          <span class="hub-sky__count">{countLabel(d.count, 'article', 'articles')}</span>
        </li>
      ))
    }
  </ol>
</HubFigure>

<style>
  /* The figure element is HubFigure's, so it carries no scope attribute of this component; the rule targets the desk groups. */
  .hub-sky__desk.is-dim {
    opacity: 0.35;
  }

  .hub-sky__badge {
    fill: var(--we-white);
  }

  .hub-sky__num {
    fill: var(--we-blue-night);
    font-size: 17px;
  }

  .hub-sky__legend {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 10rem), 1fr));
    gap: var(--sp-2) var(--sp-4);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--fs-sm);

    & li {
      display: flex;
      flex-wrap: wrap;
      gap: var(--sp-1) var(--sp-2);
      align-items: center;
      min-block-size: 2.75rem;
    }

    & li.is-dim {
      opacity: 1;
      color: var(--color-text-muted);
    }
  }

  .hub-sky__key {
    display: inline-grid;
    place-items: center;
    inline-size: 1.75rem;
    block-size: 1.75rem;
    border-radius: 50%;
    background: var(--we-blue-night);
    color: var(--we-white);
    font-weight: 700;
    font-size: var(--fs-xs);
  }

  .hub-sky__count {
    color: var(--color-text-muted);
  }

  @media (forced-colors: active) {
    .hub-sky__badge {
      fill: Canvas;
      stroke: CanvasText;
    }

    .hub-sky__num {
      fill: CanvasText;
    }

    .hub-sky__key {
      border: 1px solid CanvasText;
    }
  }
</style>
