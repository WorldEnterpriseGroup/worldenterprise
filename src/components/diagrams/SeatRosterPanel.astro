---
import ConsolePanel from './ConsolePanel.astro';

interface Seat {
  readonly role: string;
  readonly focus: string;
  readonly state: 'Active' | 'Starting' | 'Open';
}

interface Props {
  seats?: readonly Seat[];
  title?: string;
}

const defaults: readonly Seat[] = [
  { role: 'Delivery lead', focus: 'Plan and unblock the team', state: 'Active' },
  { role: 'Product design', focus: 'Flows and interface', state: 'Active' },
  { role: 'Engineering', focus: 'Build and release', state: 'Starting' },
  { role: 'Quality assurance', focus: 'Test and verify', state: 'Open' },
];
const { seats = defaults, title = 'team roster' } = Astro.props;
---

<ConsolePanel title={title}>
  <ul class="console__list" role="list">
    {
      seats.map((s) => (
        <li class="console__row">
          <span class={`console__cell${s.state === 'Active' ? '' : ' console__cell--open'}`} aria-hidden="true" />
          <span class="console__grow"><strong>{s.role}</strong><br />{s.focus}</span>
          <span class="console__state">{s.state}</span>
        </li>
      ))
    }
  </ul>
</ConsolePanel>
