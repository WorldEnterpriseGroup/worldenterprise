---
import EmblemFrame from './EmblemFrame.astro';
import type { EmblemKind } from './emblems.ts';

/**
 * A readable column (about 40rem) with the family emblem beside it on a wide screen: the figure-beside-text frame of the WP-56
 * templates. The emblem is decorative and dropped below 62rem, so a phone reader keeps the text alone.
 */
interface Props {
  kind: EmblemKind;
  seed?: string;
  index?: number;
}

const { kind, seed, index } = Astro.props;
---

<div class="wv-with">
  <div class="wv-with__text">
    <slot />
  </div>
  <div class="wv-with__art">
    <EmblemFrame kind={kind} {...(seed !== undefined ? { seed } : {})} {...(index !== undefined ? { index } : {})} />
  </div>
</div>

<style>
  .wv-with {
    display: grid;
    gap: var(--sp-6);
    align-items: center;
  }

  .wv-with__text {
    display: grid;
    gap: var(--sp-4);
    max-inline-size: 56rem;
    min-inline-size: 0;
  }

  .wv-with__art {
    display: none;
  }

  /* A list beside the emblem is a panel, so it holds its column to the edge however short its lines are (WP-109). */
  .wv-with__text > :global(:is(ul, ol)) {
    margin: 0;
    padding: var(--sp-5) var(--sp-6) var(--sp-5) calc(var(--sp-6) + 1.5em);
    border: var(--border-hair);
    border-radius: var(--radius-md);
    background: var(--color-bg);
  }

  @media (min-width: 62rem) {
    .wv-with {
      /* The text holds 56rem (a reading line of about 70 characters) and the emblem takes the rest of the frame up to 50rem, so the pair
         spans the frame with one gutter between them (WP-109). */
      grid-template-columns: minmax(0, 56rem) minmax(18rem, 50rem);
      justify-content: space-between;
    }

    .wv-with__art {
      display: block;
    }
  }
</style>
