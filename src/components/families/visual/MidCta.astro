---
import { getRouteState } from '../../../lib/route-state.ts';
import { href as resolve } from '../../../lib/url.ts';
import { midBody } from './cta.ts';

/**
 * The mid-article action (SALES.md 6.2, "Articles"): "Get the timeline brief" once its page exists, "See how long it really takes"
 * until then, nothing when neither route is live. A quiet aside inside the text column, never a button wall.
 */
const state = await getRouteState();
const cta = midBody(state.isLive);
---

{
  cta !== undefined && (
    <aside class="wv-mid" aria-label="The real timeline" data-cta-mid>
      <p class="wv-mid__link">
        <a href={resolve(cta.href)}>{cta.label}</a>
      </p>
      {cta.note !== undefined && <p class="wv-mid__note">{cta.note}</p>}
    </aside>
  )
}

<style>
  .wv-mid {
    display: grid;
    gap: var(--sp-1);
    margin-block: var(--sp-6);
    padding: var(--sp-4) var(--sp-5);
    border-inline-start: 4px solid var(--color-highlight);
    background: var(--color-bg-soft);
    border-radius: var(--radius-md);
  }

  .wv-mid p {
    margin: 0;
  }

  .wv-mid__link {
    font-weight: 700;
  }

  .wv-mid__note {
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
  }
</style>
