---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import type { SlotId } from '../../assets/photo/slots.ts';
import HubLayout from '../../layouts/HubLayout.astro';
import BrandCallout from '../brand/BrandCallout.astro';
import type { HeroActions } from './actions.ts';
import { EYEBROWS, FIXED, HEADINGS, HUB_FALLBACK } from './copy.ts';
import FamilyHub from './FamilyHub.astro';
import type { FamilyLink } from './types.ts';
import { IDENTITY } from './visual/copy.ts';
import { hubActions } from './visual/cta.ts';
import EmblemFrame from './visual/EmblemFrame.astro';
import { getRouteState } from '../../lib/route-state.ts';

/**
 * The hub of a family (/industries/, /compare/, /journey/): the console hero with the family's emblem in its panel (industries as
 * hex-faceted planets, comparisons as navigating giants, the journey as a launch; wave 9), the hub
 * page's own MDX body if the content owner wrote one, an optional block of structure above the list (the journey hub puts the
 * ordered steps there) and the list of the family's pages as equal cards. The hub exists as soon as the template does; its list holds
 * only the pages that are live, so a family with no page yet shows its intro and no cards. The `lead` slot sits straight under the hero,
 * so a hub's first media moments open the page (WP-24); the default slot stays above the list.
 */
interface Props {
  family: 'industries' | 'compare' | 'journey';
  /** The hub's own `index` page, when the content owner has written it. */
  page?: CollectionEntry<'pages'> | undefined;
  path: string;
  cards: readonly FamilyLink[];
  /** Heading of the list of cards. */
  listHeading: string;
  actions: HeroActions;
  ogSlot: SlotId;
}

const { family, page, path, cards, listHeading, actions, ogSlot } = Astro.props;
// The readiness review leads every hub (SALES.md 6.1); the family keeps its own secondary action.
const primary = hubActions((await getRouteState()).isLive).primary ?? actions.primary;
const fallback = HUB_FALLBACK[family];
const fixed = FIXED[family === 'compare' ? 'compare' : family === 'industries' ? 'industry' : 'journey'];
const Content = page !== undefined ? (await render(page)).Content : undefined;
---

<HubLayout
  title={page?.data.title ?? fallback.title}
  seoTitle={page?.data.seoTitle}
  description={page?.data.description ?? fallback.description}
  path={path}
  lead={page?.data.description ?? fallback.lead}
  eyebrow={page?.data.eyebrow ?? EYEBROWS[family]}
  {...(page !== undefined ? { updated: page.data.updated, draft: page.data.draft } : {})}
  ogSlot={ogSlot}
  hero="console"
  primary={primary}
  secondary={actions.secondary}
>
  <div slot="panel"><EmblemFrame kind={family} caption={IDENTITY[family].caption} /></div>
  <slot name="lead" />
  <BrandCallout tone="note" title={HEADINGS.shared.about}>
    <p>{fixed}</p>
  </BrandCallout>
  {Content !== undefined && <div class="prose"><Content /></div>}
  <slot />
  <FamilyHub heading={listHeading} id={`${family}-pages`} cards={cards} kind={family} />
</HubLayout>
