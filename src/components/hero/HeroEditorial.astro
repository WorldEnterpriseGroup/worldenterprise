---
interface Props {
  /** Heading element for the title. Only the styleguide uses h2, to show several heroes on one page. */
  as?: 'h1' | 'h2';
  eyebrow?: string;
  title: string;
  lead?: string;
}

const { as: Heading = 'h1', eyebrow, title, lead } = Astro.props;
---

<section class="hero hero--editorial">
  <div class="container container--wide stack">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <Heading>{title}</Heading>
    <div class="rule" aria-hidden="true"></div>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>
