---
import type { SlotId } from '../../assets/photo/slots.ts';
import type { Crumb } from '../../lib/breadcrumbs.ts';
import Breadcrumbs from '../layout/Breadcrumbs.astro';
import { photoImage } from '../media/photo-image.ts';
import HeroActions from './HeroActions.astro';
import HeroArt from './HeroArt.astro';
import type { HeroArtProps, HeroCta, HeroMeasure } from './types.ts';

/**
 * Editorial hero: breadcrumbs, eyebrow, title, rule, lead, actions, and a media frame beside the copy on wide screens.
 * The media is, in order: the `photo` slot, the `media` slot content, the vector `art`. With none of them the copy runs alone.
 */
interface Props {
  /** Heading element for the title. Only the styleguide uses h2, to show several heroes on one page. */
  as?: 'h1' | 'h2';
  id?: string;
  crumbs?: readonly Crumb[];
  eyebrow?: string;
  title: string;
  lead?: string;
  primary?: HeroCta | undefined;
  secondary?: HeroCta | undefined;
  /** Photo slot for the media frame. Drops in over the vector art; the image is the LCP, so it carries fetchpriority="high" and the slot's AVIF srcset. */
  photo?: SlotId | undefined;
  /** Earlier name of `photo`, kept so existing callers keep working. */
  inset?: SlotId | undefined;
  /** Vector art for the media frame when no photo is given. */
  art?: HeroArtProps | undefined;
  measure?: HeroMeasure;
  /** Media frame shape from 62rem: 'default' is 4/3, 'wide' is 21/9 for a panoramic visual (wave 9, W9-4). */
  frame?: 'default' | 'wide';
}

const { as: Heading = 'h1', id, crumbs = [], eyebrow, title, lead, primary, secondary, photo, inset, art, measure = 'default', frame = 'default' } = Astro.props;
const slotId = photo ?? inset;
const image = slotId ? await photoImage(slotId) : undefined;
const hasMediaSlot = Astro.slots.has('media');
const hasActions = Astro.slots.has('actions');
// Reading-column measures have no room beside the copy, so they never carry a media frame.
const beside = measure === 'default';
const showMedia = beside && (image !== undefined || hasMediaSlot || art !== undefined);
const containerClass = { default: 'container', prose: 'container container--prose', rail: 'container' }[measure];
---

<section class="hero hero--editorial" data-hero="editorial" data-measure={measure}>
  <div class:list={[containerClass, 'hero__grid', showMedia && 'hero__grid--media']}>
    <div class="hero__copy stack">
      <Breadcrumbs crumbs={crumbs} />
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <Heading id={id}>{title}</Heading>
      <div class="rule" aria-hidden="true"></div>
      {lead && <p class="lead">{lead}</p>}
      <HeroActions primary={primary} secondary={secondary} extra={hasActions}>{hasActions && <slot name="actions" />}</HeroActions>
      <slot />
    </div>
    {
      showMedia && (
        <div class="hero__media">
          <div class="hero__frame" data-frame={frame === 'wide' ? 'wide' : undefined}>
            {image ? (
              <img src={image.src} srcset={image.srcset} sizes={image.srcset === undefined ? undefined : image.sizes} width={image.width} height={image.height} alt={image.alt} fetchpriority="high" decoding="async" />
            ) : hasMediaSlot ? (
              <slot name="media" />
            ) : (
              art && <HeroArt {...art} />
            )}
          </div>
        </div>
      )
    }
  </div>
</section>
