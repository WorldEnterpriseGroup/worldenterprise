---
interface Props {
  /** Heading element for the title. Only the styleguide uses h2, to show several heroes on one page. */
  as?: 'h1' | 'h2';
  title: string;
  lead?: string;
}

const { as: Heading = 'h1', title, lead } = Astro.props;
---

<section class="hero hero--compact">
  <div class="container stack">
    <Heading>{title}</Heading>
    {lead && <p class="lead">{lead}</p>}
  </div>
</section>
