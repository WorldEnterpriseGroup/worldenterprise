---
interface Props {
  /** Heading element for the title. Only the styleguide uses h2, to show several heroes on one page. */
  as?: 'h1' | 'h2';
  eyebrow?: string;
  title: string;
  lead?: string;
  byline?: string;
  published?: Date;
  updated?: Date;
}

const { as: Heading = 'h1', eyebrow, title, lead, byline, published, updated } = Astro.props;
const fmt = (d: Date): string => d.toISOString().slice(0, 10);
---

<header class="hero hero--article">
  <div class="container container--prose stack">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <Heading>{title}</Heading>
    {lead && <p class="lead">{lead}</p>}
    <p class="byline">
      {byline}
      {published && <time datetime={fmt(published)}>{fmt(published)}</time>}
      {updated && <span>, updated <time datetime={fmt(updated)}>{fmt(updated)}</time></span>}
    </p>
  </div>
</header>
