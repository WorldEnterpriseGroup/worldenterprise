---
import type { Crumb } from '../../lib/breadcrumbs.ts';
import { href } from '../../lib/url.ts';
import Breadcrumbs from '../layout/Breadcrumbs.astro';
import type { HeroMeasure } from './types.ts';

/**
 * Article hero for insight articles and research briefs. It holds the copy to the reading column and, by default, starts
 * at the left edge of the article body (measure "rail"). The `meta` slot replaces the default byline line.
 */
interface Props {
  /** Heading element for the title. Only the styleguide uses h2, to show several heroes on one page. */
  as?: 'h1' | 'h2';
  id?: string;
  crumbs?: readonly Crumb[];
  eyebrow?: string;
  /** Makes the eyebrow a link, for example to the topic page. */
  eyebrowHref?: string | undefined;
  /** Context a screen reader hears before a linked eyebrow ("Topic: build"). Visually hidden, so the visible words stay the eyebrow. */
  eyebrowLabel?: string | undefined;
  title: string;
  lead?: string;
  byline?: string;
  published?: Date;
  updated?: Date;
  measure?: HeroMeasure;
}

const { as: Heading = 'h1', id, crumbs = [], eyebrow, eyebrowHref, eyebrowLabel, title, lead, byline, published, updated, measure = 'rail' } = Astro.props;
const fmt = (d: Date): string => d.toISOString().slice(0, 10);
const containerClass = measure === 'prose' ? 'container container--prose' : 'container';
const hasMeta = Astro.slots.has('meta');
const hasByline = byline !== undefined || published !== undefined || updated !== undefined;
---

<header class="hero hero--article" data-hero="article" data-measure={measure}>
  <div class:list={[containerClass, 'hero__grid']}>
    <div class="hero__copy stack">
      <Breadcrumbs crumbs={crumbs} />
      {eyebrow && <p class="eyebrow">{eyebrowHref ? <a href={href(eyebrowHref)}>{eyebrowLabel && <span class="visually-hidden">{eyebrowLabel}: </span>}{eyebrow}</a> : eyebrow}</p>}
      <Heading id={id}>{title}</Heading>
      <div class="rule" aria-hidden="true"></div>
      {lead && <p class="lead">{lead}</p>}
      {
        hasMeta ? (
          <slot name="meta" />
        ) : (
          hasByline && (
            <p class="byline">
              {byline}
              {published && <time datetime={fmt(published)}>{fmt(published)}</time>}
              {updated && <span>, updated <time datetime={fmt(updated)}>{fmt(updated)}</time></span>}
            </p>
          )
        )
      }
    </div>
  </div>
</header>
