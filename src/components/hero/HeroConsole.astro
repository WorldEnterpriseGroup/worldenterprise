---
interface Props {
  /** Heading element for the title. Only the styleguide uses h2, to show several heroes on one page. */
  as?: 'h1' | 'h2';
  eyebrow?: string;
  title: string;
  lead?: string;
}

const { as: Heading = 'h1', eyebrow, title, lead } = Astro.props;
---

<section class="hero hero--console">
  <div class="container hero__grid">
    <div class="hero__copy stack">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <Heading>{title}</Heading>
      {lead && <p class="lead">{lead}</p>}
    </div>
    <div class="hero__panel"><slot /></div>
  </div>
</section>
