---
import { href } from '../../../lib/url.ts';
import { leaveWithColumns } from './leave-with.ts';

const columns = leaveWithColumns();
---

<div class="leave">
  <ol class="leave__cols" role="list">
    {
      columns.map((col) => (
        <li class={`leave__col leave__col--${col.id}`}>
          <article class="leave__card" aria-labelledby={`leave-${col.id}`}>
            <header class="leave__head">
              <span class="leave__hex" aria-hidden="true">{col.name.charAt(0)}</span>
              <span class="leave__alt">{col.altitude} altitude</span>
            </header>
            <h3 class="leave__title" id={`leave-${col.id}`}>{col.name}</h3>
            <p class="leave__promise">{col.promise}</p>
            <p class="leave__label" id={`leave-${col.id}-holding`}>You leave holding</p>
            <ul class="leave__holding" role="list" aria-labelledby={`leave-${col.id}-holding`}>
              {col.holding.map((item) => <li>{item}</li>)}
            </ul>
            <p class="leave__label" id={`leave-${col.id}-material`}>Working material</p>
            <ul class="leave__material" role="list" aria-labelledby={`leave-${col.id}-material`}>
              {
                col.material.map((item) => (
                  <li>
                    <span class="tag">{item.kind}</span>
                    <a href={href(item.path)}>{item.title}</a>
                  </li>
                ))
              }
            </ul>
            <p class="leave__more">
              <a class="btn btn--secondary" href={href(col.path)}>Read about {col.name}</a>
            </p>
          </article>
        </li>
      ))
    }
  </ol>
</div>

<style>
  @layer pages {
    .leave {
      container-type: inline-size;
    }

    .leave__cols {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--sp-5);
      list-style: none;
      padding: 0;
      margin: 0;

      @container (min-width: 56rem) {
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: var(--sp-6);
      }
    }

    .leave__card {
      display: flex;
      flex-direction: column;
      gap: var(--sp-3);
      block-size: 100%;
      padding: var(--sp-5);
      border: var(--border-hair);
      border-block-start: 4px solid var(--leave-tone);
      border-radius: var(--radius-md);
      background: var(--color-bg);
    }

    /* The three altitudes darken as the stage goes deeper: survey, blueprint, territory. */
    .leave__col--dream {
      --leave-tone: var(--we-tint);
      --leave-ink: var(--color-text);
    }

    .leave__col--build {
      --leave-tone: var(--we-blue);
      --leave-ink: var(--color-accent-contrast);
    }

    .leave__col--grow {
      --leave-tone: var(--we-blue-night);
      --leave-ink: var(--color-text-inverse);
    }

    /* The hexes sit on one track across the columns, so the three read as one climb. */
    .leave__head {
      display: flex;
      align-items: center;
      gap: var(--sp-3);
    }

    .leave__hex {
      display: grid;
      place-items: center;
      flex: none;
      inline-size: 3rem;
      aspect-ratio: var(--hex-ratio);
      clip-path: var(--hex-clip);
      background: var(--leave-tone);
      color: var(--leave-ink);
      font-family: var(--ff-display);
      font-size: var(--fs-lg);
      font-weight: 700;
    }

    .leave__alt {
      font-family: var(--ff-display);
      font-size: var(--fs-sm);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: var(--tracking-caps);
      color: var(--color-link);
    }

    .leave__title {
      font-size: var(--fs-xl);
      line-height: var(--lh-tight);
    }

    .leave__promise {
      color: var(--color-text-muted);
    }

    .leave__label {
      margin-block-start: var(--sp-2);
      padding-block-start: var(--sp-3);
      border-block-start: var(--border-hair);
      font-family: var(--ff-display);
      font-size: var(--fs-sm);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: var(--tracking-caps);
    }

    .leave__holding,
    .leave__material {
      display: grid;
      gap: var(--sp-3);
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .leave__holding li {
      position: relative;
      padding-inline-start: var(--sp-5);

      &::before {
        content: '';
        position: absolute;
        inset-inline-start: 0;
        inset-block-start: 0.45em;
        inline-size: 0.8rem;
        aspect-ratio: var(--hex-ratio);
        clip-path: var(--hex-clip);
        background: var(--we-blue);
        forced-color-adjust: none;
      }
    }

    .leave__material li {
      display: grid;
      justify-items: start;
      gap: var(--sp-1);
      font-size: var(--fs-sm);
    }

    .leave__material a {
      font-weight: 600;
    }

    .leave__more {
      margin-block-start: auto;
      padding-block-start: var(--sp-3);
    }

    @container (min-width: 56rem) {
      .leave__col:not(:last-child) .leave__head::after {
        content: '';
        flex: 1 1 auto;
        block-size: 2px;
        margin-inline-end: calc(-1 * var(--sp-6) - var(--sp-5));
        background: var(--we-tint);
        border-radius: var(--radius-pill);
        pointer-events: none;
      }
    }

    @media (prefers-reduced-motion: no-preference) {
      .leave__card {
        transition: box-shadow var(--dur-base) var(--ease-out);

        &:hover {
          box-shadow: var(--shadow-2);
        }
      }
    }
  }
</style>
