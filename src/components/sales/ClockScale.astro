---
/**
 * A quarter against the years (WP-58, chart 4): every span and marker on one months axis. Each row is real text (what it is and how
 * long) beside a drawn track on the same scale, so the comparison reads with styles off, in forced colors and at 320px.
 */
import { share } from '../../data/sales/geometry.ts';
import { salesSource, sourceAnchor } from '../../data/sales/sources.ts';
import type { Span } from '../../data/sales/timeline.ts';

interface Props {
  spans: readonly Span[];
  /** The months the axis runs to. */
  months: number;
  label: string;
}

const { spans, months, label } = Astro.props;
const axis = Array.from({ length: Math.floor(months / 12) + 1 }, (_, i) => i * 12);
const rows = spans.map((s) => ({
  ...s,
  x: share(s.from, months),
  w: s.kind === 'marker' ? 0 : Math.max(0.8, share(s.to, months) - share(s.from, months)),
  source: salesSource(s.source),
}));
---

<div class="sales-clock">
  <ol class="sales-clock__rows" aria-label={label}>
    {
      rows.map((r) => (
        <li class:list={['sales-clock__row', `sales-clock__row--${r.kind}`]}>
          <span class="sales-clock__label">
            {r.label}{' '}
            <a class="sales-clock__src" href={sourceAnchor(r.source.id)}>
              ({r.source.short})
            </a>
          </span>
          <span class="sales-clock__value">{r.display}</span>
          <span class="sales-clock__track" aria-hidden="true">
            <svg viewBox="0 0 100 12" preserveAspectRatio="none" focusable="false">
              <rect class="sales-clock__rail" x="0" y="5" width="100" height="2" />
              {axis.map((m) => (
                <rect class="sales-clock__tick" x={Math.min(99.6, share(m, months))} y="2" width="0.4" height="8" />
              ))}
              {r.kind === 'marker' ? (
                <rect class="sales-clock__marker" x={Math.max(0, r.x - 0.6)} y="0" width="1.2" height="12" />
              ) : (
                <rect class="sales-clock__span" x={r.x} y="1" width={r.w} height="10" />
              )}
            </svg>
          </span>
        </li>
      ))
    }
  </ol>
  <p class="sales-clock__axis" aria-hidden="true">
    {axis.map((m) => <span>{m === 0 ? '0' : `${m} mo`}</span>)}
  </p>
</div>

<style>
  @layer pages {
    .sales-clock {
      display: grid;
      gap: var(--sp-3);
    }

    .sales-clock__rows {
      display: grid;
      gap: var(--sp-5);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .sales-clock__row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        'label value'
        'track track';
      gap: var(--sp-1) var(--sp-3);
      align-items: baseline;
    }

    .sales-clock__label {
      grid-area: label;
    }

    .sales-clock__src {
      font-size: var(--fs-sm);
    }

    .sales-clock__value {
      grid-area: value;
      font-weight: 700;
      font-variant-numeric: tabular-nums;
    }

    .sales-clock__track {
      grid-area: track;
      display: block;
    }

    .sales-clock__track svg {
      display: block;
      inline-size: 100%;
      block-size: 1.75rem;
    }

    .sales-clock__rail,
    .sales-clock__tick {
      fill: var(--color-border);
    }

    .sales-clock__span {
      fill: var(--color-link);
      opacity: 0.45;
    }

    .sales-clock__row--program .sales-clock__span {
      fill: var(--color-highlight-ink);
      opacity: 1;
    }

    .sales-clock__marker {
      fill: var(--color-highlight-ink);
    }

    .sales-clock__axis {
      display: flex;
      justify-content: space-between;
      margin: 0;
      color: var(--color-text-muted);
      font-size: var(--fs-xs);
      font-variant-numeric: tabular-nums;
    }

    @media (forced-colors: active) {
      .sales-clock__rail,
      .sales-clock__tick,
      .sales-clock__marker,
      .sales-clock__span,
      .sales-clock__row--program .sales-clock__span {
        fill: CanvasText;
      }
    }
  }
</style>
