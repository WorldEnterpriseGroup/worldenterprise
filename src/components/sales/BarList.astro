---
/**
 * Horizontal bars as a real list (WP-58): each row is text (label and value) with a drawn bar beside it, so the chart reads the same to a
 * screen reader, with styles off, in forced colors and at 320px. The bar is a one-rect SVG stretched to its share of the largest value.
 */
import { share } from '../../data/sales/geometry.ts';
import type { Bar } from '../../data/sales/timeline.ts';

interface Props {
  bars: readonly Bar[];
  /** Accessible name of the list, e.g. "Share of founders who build a top-growth firm". */
  label: string;
  /** The value that fills a whole track. Defaults to the largest bar. */
  max?: number;
  /** Draw a comet that settles into orbit beside the bars (the failure-reasons chart). */
  comet?: boolean;
}

const { bars, label, max = Math.max(...bars.map((b) => b.value)), comet = false } = Astro.props;
---

<div class:list={['sales-bars', comet && 'sales-bars--comet']}>
  <ul class="sales-bars__list" aria-label={label}>
    {
      bars.map((bar) => (
        <li class:list={['sales-bar', bar.highlight === true && 'sales-bar--highlight']}>
          <span class="sales-bar__label">{bar.label}</span>
          <span class="sales-bar__track" aria-hidden="true">
            <svg viewBox="0 0 100 10" preserveAspectRatio="none" focusable="false">
              <rect class="sales-bar__rail" x="0" y="0" width="100" height="10" />
              <rect class="sales-bar__fill" x="0" y="0" width={share(bar.value, max)} height="10" />
            </svg>
          </span>
          <span class="sales-bar__value">{bar.display}</span>
        </li>
      ))
    }
  </ul>
  {
    comet && (
      <svg class="sales-bars__comet" viewBox="0 0 200 200" aria-hidden="true" focusable="false">
        <circle class="sales-bars__orbit" cx="100" cy="100" r="62" />
        <circle class="sales-bars__world" cx="100" cy="100" r="22" />
        <path class="sales-bars__tail" d="M10 30 Q 70 40 132 48" />
        <g class="sales-bars__spin">
          <circle class="sales-bars__body" cx="162" cy="100" r="8" />
        </g>
      </svg>
    )
  }
</div>

<style>
  @layer pages {
    .sales-bars {
      display: grid;
      gap: var(--sp-5);
      align-items: center;
    }

    .sales-bars__list {
      display: grid;
      gap: var(--sp-4);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .sales-bar {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        'label value'
        'track track';
      gap: var(--sp-1) var(--sp-3);
      align-items: baseline;
    }

    .sales-bar__label {
      grid-area: label;
    }

    .sales-bar__value {
      grid-area: value;
      font-weight: 700;
      font-variant-numeric: tabular-nums;
    }

    .sales-bar__track {
      grid-area: track;
      display: block;
    }

    .sales-bar__track svg {
      display: block;
      inline-size: 100%;
      block-size: 1.25rem;
    }

    .sales-bar__rail {
      fill: var(--color-bg-soft);
    }

    .sales-bar__fill {
      fill: var(--color-link);
    }

    .sales-bar--highlight .sales-bar__fill {
      fill: var(--color-highlight-ink);
    }

    .sales-bars__comet {
      display: none;
    }

    .sales-bars__orbit {
      fill: none;
      stroke: var(--color-text-muted);
      stroke-width: 2;
      stroke-dasharray: 4 6;
    }

    .sales-bars__world {
      fill: var(--color-link);
    }

    .sales-bars__tail {
      fill: none;
      stroke: var(--color-highlight-ink);
      stroke-width: 3;
      stroke-linecap: round;
    }

    .sales-bars__body {
      fill: var(--color-highlight-ink);
    }

    @media (min-width: 48rem) {
      .sales-bar {
        grid-template-columns: minmax(10rem, 16rem) minmax(0, 1fr) 7rem;
        grid-template-areas: 'label track value';
        align-items: center;
      }

      .sales-bars--comet {
        grid-template-columns: minmax(0, 1fr) 15rem;
      }

      .sales-bars__comet {
        display: block;
        inline-size: 100%;
      }
    }

    @media (prefers-reduced-motion: no-preference) {
      .sales-bars__spin {
        transform-box: view-box;
        transform-origin: 50% 50%;
        animation-name: sales-orbit;
        animation-duration: 4s;
        animation-timing-function: cubic-bezier(0.2, 0.7, 0.2, 1);
        animation-iteration-count: 1;
        animation-fill-mode: both;
      }
    }

    @keyframes sales-orbit {
      from {
        transform: rotate(-1turn);
      }

      to {
        transform: rotate(0turn);
      }
    }

    @media (forced-colors: active) {
      .sales-bar__fill,
      .sales-bar--highlight .sales-bar__fill,
      .sales-bars__world,
      .sales-bars__body {
        fill: CanvasText;
      }

      .sales-bar__rail {
        fill: Canvas;
        stroke: CanvasText;
      }

      .sales-bars__orbit,
      .sales-bars__tail {
        stroke: CanvasText;
      }
    }
  }
</style>
