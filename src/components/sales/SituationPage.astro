---
/**
 * One situation page of /who-we-work-with/ (WP-58, SITE-COPY.md section 6, SALES.md sections 4 and 6.3). Situations, never
 * identities: each page is for anyone in that situation. Structure: hero, what usually gets in the way (beside the situation's world),
 * what WE does with sourced figures, one chart, the questions people ask, how it fits, then the situation's call to action.
 */
import BarList from './BarList.astro';
import ChartFrame from './ChartFrame.astro';
import CtaRow from './CtaRow.astro';
import LineChart from './LineChart.astro';
import SalesSources from './SalesSources.astro';
import StatTiles from './StatTiles.astro';
import World from './World.astro';
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import { HONESTY_LINE } from '../../data/sales/copy.ts';
import { FIT_TEXT, SITUATIONS, situationBySlug, situationPath } from '../../data/sales/situations.ts';
import type { Situation } from '../../data/sales/situations.ts';
import { stat } from '../../data/sales/stats.ts';
import { href } from '../../lib/url.ts';

interface Props {
  /** The situation's slug in src/data/sales/situations.ts; each page file under src/pages/who-we-work-with/ passes its own. */
  slug: string;
}

const found = situationBySlug(Astro.props.slug);
if (found === undefined) throw new Error(`No situation with slug "${Astro.props.slug}" in src/data/sales/situations.ts`);
const s: Situation = found;
const path = situationPath(s);
const chart = s.chart;
const line = chart.line;
const chartRows: readonly (readonly string[])[] =
  line !== undefined ? line.points.map((p) => [String(p.x), `${p.y}%`]) : chart.bars.map((b) => [b.label, b.display]);
const chartColumns = line !== undefined ? ['Year', line.label] : ['Group', chart.unit.charAt(0).toUpperCase() + chart.unit.slice(1)];
const marks =
  line !== undefined
    ? (chart.marks ?? []).flatMap((x) => {
        const p = line.points.find((pt) => pt.x === x);
        return p === undefined ? [] : [{ x: p.x, y: p.y, label: `${p.y}% in ${p.x}` }];
      })
    : [];
const ids = [...s.stats.flatMap((id) => stat(id).sources), ...chart.sources];
const others = SITUATIONS.filter((o) => o.id !== s.id);
---

<MarketingLayout title={s.headline} seoTitle={s.seoTitle} description={s.description} lead={s.subhead} eyebrow={s.name} path={path} ogSlot="og-network" primary={s.primary}>
  <p class="sales-situation__for"><strong>{s.situation}</strong></p>
  <p class="sales-situation__hook">{s.hook}</p>

  <Fragment slot="after">
    <section class="band band--deep" aria-labelledby="obstacles-title">
      <div class="container">
        <div class="split">
          <div class="split__text sales-situation__text">
            <h2 id="obstacles-title">What usually gets in the way</h2>
            <ul class="sales-situation__list">
              {s.obstacles.map((o) => <li>{o}</li>)}
            </ul>
          </div>
          <div class="split__media">
            <World variant={s.world} title={s.worldAlt} id={`world-${s.id}`} size="lg" />
          </div>
        </div>
      </div>
    </section>

    <section class="band band--soft" aria-labelledby="does-title">
      <div class="container sales-situation__stack">
        <h2 id="does-title">What WE does</h2>
        <ul class="sales-situation__list sales-situation__list--checks">
          {s.bullets.map((b) => <li>{b}</li>)}
        </ul>
        <StatTiles stats={s.stats} label="Figures for this situation" />
      </div>
    </section>

    <section class="band" aria-labelledby="chart-title">
      <div class="container">
        <div class="split split--reverse">
          <div class="split__text sales-situation__text">
            <h2 id="chart-title">{chart.title}</h2>
            <p>{chart.description}</p>
            <p class="sales-situation__honesty">{HONESTY_LINE}</p>
          </div>
          <div class="split__media">
            <ChartFrame
              caption={chart.description}
              sources={chart.sources}
              caveat={chart.caveat}
              table={{ caption: chart.title, columns: chartColumns, rows: chartRows }}
            >
              {
                line !== undefined ? (
                  <LineChart
                    id={`chart-${s.id}`}
                    title={chart.title}
                    desc={chart.description}
                    series={[line]}
                    x={{ min: line.points[0]?.x ?? 0, max: line.points[line.points.length - 1]?.x ?? 1 }}
                    y={{ min: 0, max: 40 }}
                    xStep={5}
                    xStepNarrow={10}
                    yStep={10}
                    yUnit="%"
                    marks={marks}
                    area
                  />
                ) : (
                  <BarList bars={chart.bars} label={chart.title} />
                )
              }
            </ChartFrame>
          </div>
        </div>
      </div>
    </section>

    <section class="band band--tint-stone" aria-labelledby="questions-title">
      <div class="container sales-situation__stack">
        <h2 id="questions-title">Questions people ask</h2>
        <dl class="sales-situation__qa">
          {
            s.objections.map((o) => (
              <div class="sales-situation__qa-item">
                <dt>{o.question}</dt>
                <dd>{o.answer}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section class="band band--deep" aria-labelledby="fit-title">
      <div class="container">
        <div class="split">
          <div class="split__text sales-situation__text">
            <h2 id="fit-title">How it fits</h2>
            <p>{FIT_TEXT}</p>
            {s.note !== undefined && <p class="sales-situation__note">{s.note}</p>}
            <CtaRow primary={s.primary} more={[s.secondary]} label="Next steps for this situation" />
          </div>
          <nav class="split__media sales-situation__more" aria-labelledby="more-title">
            <h2 id="more-title" class="sales-situation__more-title">Other situations WE works with</h2>
            <ul>
              {
                others.map((o) => (
                  <li>
                    <a href={href(situationPath(o))}>{o.name}</a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>
      </div>
    </section>

    <section class="section" aria-label="Sources for this page">
      <div class="container">
        <SalesSources ids={ids} />
      </div>
    </section>
  </Fragment>
</MarketingLayout>

<style>
  @layer pages {
    .sales-situation__for {
      font-size: var(--fs-lead);
    }

    .sales-situation__hook {
      font-size: var(--fs-lead);
    }

    .sales-situation__text,
    .sales-situation__stack {
      display: grid;
      gap: var(--sp-4);
    }

    .sales-situation__text > *,
    .sales-situation__stack > * {
      margin: 0;
    }

    .sales-situation__list {
      display: grid;
      gap: var(--sp-3);
      margin: 0;
      padding-inline-start: var(--sp-5);
      font-size: var(--fs-lead);
      max-inline-size: var(--prose-max);
    }

    .sales-situation__honesty,
    .sales-situation__note {
      color: var(--color-text-muted);
      font-size: var(--fs-sm);
      font-style: italic;
    }

    .sales-situation__qa {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
      gap: var(--sp-5);
      margin: 0;
    }

    .sales-situation__qa-item {
      display: grid;
      align-content: start;
      gap: var(--sp-2);
      padding: var(--sp-5);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      background: var(--color-bg);
    }

    .sales-situation__qa dt {
      font-weight: 700;
    }

    .sales-situation__qa dd {
      margin: 0;
    }

    .sales-situation__more {
      display: grid;
      gap: var(--sp-3);
      align-content: start;
    }

    .sales-situation__more-title {
      margin: 0;
      font-size: var(--fs-h4);
    }

    .sales-situation__more ul {
      display: grid;
      gap: var(--sp-2);
      margin: 0;
      padding-inline-start: var(--sp-5);
    }

    @media (forced-colors: active) {
      .sales-situation__qa-item {
        border-color: CanvasText;
      }
    }
  }
</style>
