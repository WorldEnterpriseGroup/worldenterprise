---
interface Props {
  tone?: 'plain' | 'soft';
  tight?: boolean;
  defer?: boolean;
  id?: string;
  /** Id of the heading that labels this section. */
  labelledby?: string;
}

const { tone = 'plain', tight = false, defer = false, id, labelledby } = Astro.props;
const classes = ['section', tone === 'soft' ? 'section--soft' : '', tight ? 'section--tight' : '', defer ? 'section--defer' : '']
  .filter(Boolean)
  .join(' ');
---

<section class={classes} id={id} aria-labelledby={labelledby}>
  <div class="container"><slot /></div>
</section>
