---
import { href as resolve } from '../../lib/url.ts';

interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'quiet';
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  disabled?: boolean;
}

const { href: raw, variant = 'primary', type = 'button', class: extra, disabled = false } = Astro.props;
// href() is idempotent, so a caller may pass a resolved link or a site path.
const target = raw === undefined ? undefined : resolve(raw);
const classes = ['btn', `btn--${variant}`, extra].filter(Boolean).join(' ');
---

{
  target ? (
    <a class={classes} href={target}>
      <slot />
    </a>
  ) : (
    <button class={classes} type={type} disabled={disabled}>
      <slot />
    </button>
  )
}
