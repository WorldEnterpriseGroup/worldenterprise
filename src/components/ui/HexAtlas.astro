---
import { href } from '../../lib/url.ts';

interface Cell {
  readonly label: string;
  readonly href: string;
  readonly line?: string;
}

interface Props {
  cells: readonly Cell[];
  label: string;
}

const { cells, label } = Astro.props;
---

<nav class="hexatlas" aria-label={label}>
  <ul role="list">
    {
      cells.map((c) => (
        <li>
          <a class="hexatlas__cell" href={href(c.href)}>
            <span class="hexatlas__shape" aria-hidden="true">{c.line ?? ''}</span>
            <span class="hexatlas__label">{c.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .hexatlas__shape {
    display: grid;
    place-items: center;
    inline-size: 4.5rem;
    aspect-ratio: var(--hex-ratio);
    clip-path: var(--hex-clip);
    background: var(--we-tint);
    color: var(--color-text);
    font-family: var(--ff-display);
    font-size: var(--fs-xl);
    font-weight: 700;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  .hexatlas__cell {
    padding: var(--sp-2);
    border-radius: var(--radius-md);
    font-size: var(--fs-sm);
    line-height: 1.25;
  }

  .hexatlas__cell:hover .hexatlas__label {
    text-decoration: underline;
  }

  .hexatlas li:nth-child(4n + 1) .hexatlas__shape {
    background: var(--we-mist);
  }

  /* The cells assemble as the atlas scrolls into view: each one settles from slightly small and low, the next a little after it, so
     the map reads as built up cell by cell. The animation sits on the list item so it never competes with the shape's hover
     transform. Without scroll-driven animation, or with reduced motion, the atlas is simply drawn finished. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .hexatlas li {
        animation: hexatlas-assemble linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 55%;

        &:nth-child(3n + 2) {
          animation-range: entry 8% entry 63%;
        }

        &:nth-child(3n) {
          animation-range: entry 16% entry 71%;
        }
      }
    }
  }

  @keyframes hexatlas-assemble {
    from {
      scale: 0.82;
      translate: 0 var(--sp-4);
    }
  }
</style>
