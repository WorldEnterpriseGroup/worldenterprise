---
import { href } from '../../lib/url.ts';

interface Cell {
  readonly label: string;
  readonly href: string;
  readonly line?: string;
}

interface Props {
  cells: readonly Cell[];
  label: string;
}

const { cells, label } = Astro.props;
---

<nav class="hexatlas" aria-label={label}>
  <ul role="list">
    {
      cells.map((c) => (
        <li>
          <a class="hexatlas__cell" href={href(c.href)}>
            <span class="hexatlas__shape" aria-hidden="true">{c.line ?? ''}</span>
            <span class="hexatlas__label">{c.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .hexatlas__shape {
    display: grid;
    place-items: center;
    inline-size: 4.5rem;
    aspect-ratio: var(--hex-ratio);
    clip-path: var(--hex-clip);
    background: var(--we-tint);
    color: var(--color-text);
    font-family: var(--ff-display);
    font-size: var(--fs-xl);
    font-weight: 700;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  .hexatlas__cell {
    padding: var(--sp-2);
    border-radius: var(--radius-md);
    font-size: var(--fs-sm);
    line-height: 1.25;
  }

  .hexatlas__cell:hover .hexatlas__label {
    text-decoration: underline;
  }

  .hexatlas li:nth-child(4n + 1) .hexatlas__shape {
    background: var(--we-mist);
  }
</style>
