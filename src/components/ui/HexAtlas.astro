---
import { href } from '../../lib/url.ts';

interface Cell {
  readonly label: string;
  readonly href: string;
  readonly line?: string;
}

interface Props {
  cells: readonly Cell[];
  label: string;
}

const { cells, label } = Astro.props;
---

<nav class="hexatlas" aria-label={label}>
  <ul role="list">
    {
      cells.map((c) => (
        <li>
          <a class="hexatlas__cell" href={href(c.href)}>
            <span class="hexatlas__shape" aria-hidden="true">{c.line ?? ''}</span>
            <span class="hexatlas__label">{c.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>
