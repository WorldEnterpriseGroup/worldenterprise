---
import { href } from '../../lib/url.ts';

interface Cell {
  readonly label: string;
  readonly href?: string;
}

interface Props {
  cells: readonly Cell[];
  /** Zero-based index of the current cell. */
  current?: number;
  label: string;
}

const { cells, current, label } = Astro.props;
---

<nav class="celltrail" aria-label={label}>
  <ol role="list">
    {
      cells.map((c, i) => (
        <li class="celltrail__cell" aria-current={i === current ? 'step' : undefined}>
          <span class="celltrail__hex" aria-hidden="true">{i + 1}</span>
          {c.href && i !== current ? <a href={href(c.href)}>{c.label}</a> : <span>{c.label}</span>}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .celltrail ol {
    gap: var(--sp-2) 0;
  }

  /* Hairline link between cells, the trail of a droid becoming a world. It is short on purpose: the five playbook labels fill a
     1280px container to within a few pixels at the web font's widths, and a trail that wraps with one font and not the other moves
     everything below it when the web fonts arrive (CLS 0.25 on the playbook pages). The slack keeps it on one row with both. */
  .celltrail__cell:not(:last-child)::after {
    content: '';
    inline-size: var(--sp-4);
    block-size: 2px;
    margin-inline: var(--sp-1);
    background: var(--we-tint);
  }

  .celltrail__cell[aria-current='step'] ~ .celltrail__cell .celltrail__hex {
    background: var(--we-mist);
    color: var(--color-text-muted);
  }

  .celltrail__cell:has(~ [aria-current='step']) .celltrail__hex {
    background: var(--we-blue-deep);
    color: var(--color-text-inverse);
  }

  .celltrail a {
    color: inherit;
  }
</style>
