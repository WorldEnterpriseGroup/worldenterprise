---
import { href } from '../../lib/url.ts';
import { STAGES } from './stages.ts';

interface Props {
  /** Id of the heading that labels the diagram. */
  labelledby: string;
}

const { labelledby } = Astro.props;
---

<nav class="altitude" aria-labelledby={labelledby}>
  <ol role="list">
    {
      STAGES.map((stage, index) => (
        <li class={`altitude__step altitude__step--rise-${index}`}>
          <a class="altitude__link" href={href(stage.path)}>
            <span class="altitude__hex" aria-hidden="true">{stage.name.charAt(0)}</span>
            <span class="altitude__text">
              <span class="altitude__name">{stage.name}</span>
              <span class="altitude__alt">{stage.altitude} altitude</span>
              <span class="altitude__promise">{stage.promise}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<style>
  @layer pages {
    .altitude ol {
      display: grid;
      gap: var(--sp-4);
      list-style: none;
      padding: 0;

      @media (min-width: 52rem) {
        grid-template-columns: repeat(3, 1fr);
        align-items: end;
      }
    }

    .altitude__link {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: var(--sp-4);
      align-items: start;
      block-size: 100%;
      padding: var(--sp-5);
      color: var(--color-text);
      text-decoration: none;
      background: var(--color-bg);
      border: var(--border-hair);
      border-block-start: 4px solid var(--color-accent);
      border-radius: var(--radius-md);
      transition: box-shadow var(--dur-base) var(--ease-out);

      &:hover {
        box-shadow: var(--shadow-2);
      }

      @media (min-width: 52rem) {
        padding-block-start: calc(var(--sp-5) + var(--rise, 0) * var(--sp-5));
      }
    }

    /* Each step sits one notch lower than the one before. A class per step, not a style attribute, so the CSP needs no
       style-src-attr exception. One rule per entry of STAGES; tests/unit/wp-16/csp-style-attr.test.ts checks the count. */
    .altitude__step--rise-0 {
      --rise: 0;
    }

    .altitude__step--rise-1 {
      --rise: 1;
    }

    .altitude__step--rise-2 {
      --rise: 2;
    }

    .altitude__hex {
      display: grid;
      place-items: center;
      inline-size: 3.25rem;
      aspect-ratio: var(--hex-ratio);
      clip-path: var(--hex-clip);
      background: var(--color-accent);
      color: var(--color-accent-contrast);
      font-family: var(--ff-display);
      font-size: var(--fs-lg);
      font-weight: 700;
    }

    .altitude__text {
      display: grid;
      gap: var(--sp-1);
    }

    .altitude__name {
      font-family: var(--ff-display);
      font-size: var(--fs-xl);
      font-weight: 700;
    }

    .altitude__alt {
      font-family: var(--ff-display);
      font-size: var(--fs-sm);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: var(--tracking-caps);
      color: var(--color-link);
    }

    .altitude__promise {
      color: var(--color-text);
    }

    /* The stage rail: one line under the three steps, from Dream to Grow. It is drawn complete by default; where scroll-driven
       animation is supported and motion is welcome it is drawn left to right as the diagram scrolls into view, and each step
       rises into its notch a little after the one before. Vertical movement only, so the page never gains a scrollbar. */
    @media (min-width: 52rem) {
      .altitude ol::after {
        content: '';
        grid-column: 1 / -1;
        block-size: 4px;
        margin-block-start: var(--sp-2);
        background: linear-gradient(90deg, var(--tint-line), var(--color-accent));
        transform-origin: left;
      }
    }

    @media (prefers-reduced-motion: no-preference) {
      @supports (animation-timeline: view()) {
        .altitude__link {
          animation: altitude-rise linear both;
          animation-timeline: view();
          animation-range: entry 0% entry 60%;
        }

        .altitude__step--rise-1 .altitude__link {
          animation-range: entry 10% entry 70%;
        }

        .altitude__step--rise-2 .altitude__link {
          animation-range: entry 20% entry 80%;
        }

        .altitude ol::after {
          animation: altitude-rail linear both;
          animation-timeline: view();
          animation-range: entry 20% cover 40%;
        }
      }
    }

    @keyframes altitude-rise {
      from {
        translate: 0 var(--sp-5);
      }
    }

    @keyframes altitude-rail {
      from {
        transform: scaleX(0);
      }
    }

    @media (forced-colors: active) {
      .altitude ol::after {
        forced-color-adjust: none;
        background: CanvasText;
      }
    }
  }
</style>
