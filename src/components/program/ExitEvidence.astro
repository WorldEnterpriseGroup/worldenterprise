---
interface Props {
  items: readonly string[];
  /** Id of the heading that labels the list. */
  labelledby: string;
}

const { items, labelledby } = Astro.props;
---

<ul class="exit" role="list" aria-labelledby={labelledby}>
  {
    items.map((item) => (
      <li class="exit__item">
        <span class="exit__mark" aria-hidden="true"></span>
        <span>{item}</span>
      </li>
    ))
  }
</ul>

<style>
  @layer pages {
    .exit {
      display: grid;
      gap: var(--sp-3);
      list-style: none;
      padding: 0;
    }

    .exit__item {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: var(--sp-3);
      align-items: start;
      padding: var(--sp-4);
      background: var(--color-bg-soft);
      border-radius: var(--radius-md);
      border-inline-start: 4px solid var(--color-highlight);
    }

    .exit__mark {
      inline-size: 1.25rem;
      block-size: 1.25rem;
      margin-block-start: 0.2em;
      border: var(--border-strong);
      border-radius: var(--radius-sm);
      background: var(--color-bg);
    }
  }
</style>
