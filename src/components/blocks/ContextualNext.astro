---
import { resolveCta } from '../../data/cta/index.ts';
import type { CtaCollection } from '../../data/cta/index.ts';
import { withCtaItem } from '../../data/cta/next.ts';
import { getRouteState } from '../../lib/route-state.ts';
import { href } from '../../lib/url.ts';

interface NextItem {
  readonly title: string;
  readonly href: string;
  readonly description?: string;
}

/**
 * `cta` is optional. Given the place of the page, the list ends with the primary action that the default map of `src/data/cta` gives it
 * (through `resolveCta`, so a target that is not live is left out and a target the list already links is not listed twice).
 */
interface Props {
  items: readonly NextItem[];
  title?: string;
  cta?: { readonly path: string; readonly collection: CtaCollection; readonly topic?: string | undefined } | undefined;
}

const { items: given, title = 'Next', cta } = Astro.props;
const state = cta === undefined ? undefined : await getRouteState();
const model =
  cta === undefined || state === undefined
    ? null
    : resolveCta({ path: cta.path, collection: cta.collection, ...(cta.topic !== undefined ? { topic: cta.topic } : {}) }, state.isLive);
const items = withCtaItem(given, model);
---

{
  items.length > 0 && (
    <section class="next" aria-labelledby="next-title">
      <h2 id="next-title" class="next__title">{title}</h2>
      <ul class="next__list" role="list">
        {items.map((item) => (
          <li>
            <a class="next__link" href={href(item.href)}>
              <span class="next__label">{item.title}</span>
              {item.description && <span class="next__desc">{item.description}</span>}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
