---
interface Source {
  readonly id: string;
  readonly title: string;
  readonly publisher: string;
  readonly url: string;
  readonly accessed?: Date | undefined;
}

interface Props {
  sources: readonly Source[];
  title?: string;
  headingLevel?: 2 | 3;
}

const { sources, title = 'Sources', headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const dateFormat = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

{
  sources.length > 0 && (
    <section class="sources" aria-labelledby="sources-title">
      <Heading id="sources-title">{title}</Heading>
      <ol class="sources__list">
        {sources.map((source) => (
          <li id={`source-${source.id}`}>
            <a href={source.url} rel="noopener">{source.title}</a>, {source.publisher}
            {source.accessed && <span class="muted">. Accessed {dateFormat.format(source.accessed)}.</span>}
          </li>
        ))}
      </ol>
    </section>
  )
}
