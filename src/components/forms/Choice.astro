---
interface Props {
  id: string;
  name: string;
  label: string;
  type?: 'checkbox' | 'radio';
  value?: string;
  required?: boolean;
}

const { id, name, label, type = 'checkbox', value, required = false } = Astro.props;
---

<div class="choice">
  <input id={id} name={name} type={type} value={value} required={required} />
  <label for={id}>{label}</label>
</div>
