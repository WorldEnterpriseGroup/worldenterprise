---
import ApplyProgress from '../apply/ApplyProgress.astro';
import { APPLY_FIELDS, CONTEXT_SELECTS, REVIEW_COPY, SITUATION_HEADINGS, SITUATION_IDS, STAGE_OPTIONS, contextOptions } from '../apply/fields.ts';
import type { FieldCopy } from '../apply/fields.ts';
import { href } from '../../lib/url.ts';
import Field from './Field.astro';
import Fieldset from './Fieldset.astro';
import FormFrame from './FormFrame.astro';

type ContextSelect = (typeof CONTEXT_SELECTS)[number];
/** A context select: script-only, so it has no name and ships hidden. The script reveals it and carries the answer inside `message`. */
const select = (key: ContextSelect) => ({ id: `apply-${key}`, dataField: key, label: APPLY_FIELDS[key].label, type: 'select' as const, options: contextOptions(key) });
const hintOf = (key: ContextSelect): string | undefined => (APPLY_FIELDS[key] as FieldCopy).hint;
const started = APPLY_FIELDS.startedMonth;
---

<FormFrame
  kind="apply"
  id="apply"
  submitLabel="Start my readiness review"
  thanksPath="/apply/thanks/"
  consentLabel="I agree that WE may use these details to reply to my readiness review, as described in the privacy notice."
  stepped
>
  {/* One heading per situation page (SALES.md 6.3). All ship hidden; the script shows the one `?situation=` names. */}
  <div slot="top" class="apply-situation">
    {SITUATION_IDS.map((id) => SITUATION_HEADINGS[id] !== undefined && <h2 class="apply-situation__heading" data-situation-heading={id} hidden>{SITUATION_HEADINGS[id]}</h2>)}
  </div>
  <ApplyProgress slot="top" />

  <Fieldset legend="About you" step="you">
    <Field id="apply-name" name="name" label={APPLY_FIELDS.name.label} required autocomplete="name" maxlength={120} reserveError />
    <Field
      id="apply-email"
      name="email"
      label={APPLY_FIELDS.email.label}
      type="email"
      required
      autocomplete="email"
      maxlength={254}
      hint={APPLY_FIELDS.email.hint}
      reserveError
    />
    <Field
      id="apply-company"
      name="company"
      label={APPLY_FIELDS.company.label}
      autocomplete="organization"
      maxlength={120}
      hint={APPLY_FIELDS.company.hint}
      reserveError
    />
    {/* Script-only: no name, so the browser never posts it. The script carries the answer inside `message` (docs/forms-contract.md section 3). */}
    <div class="apply-context" data-context-field hidden>
      <Field {...select('situation')} reserveError />
    </div>
  </Fieldset>

  <Fieldset legend="About the company" step="idea">
    <Field id="apply-stage" name="stage" label={APPLY_FIELDS.stage.label} type="select" required options={STAGE_OPTIONS} reserveError />
    <div class="apply-context" data-context-field hidden>
      <div class="field">
        <label for="apply-startedMonth">{started.label}</label>
        <p class="field__hint" id="apply-startedMonth-hint">{started.hint}</p>
        <input id="apply-startedMonth" type="month" data-field="startedMonth" aria-describedby="apply-startedMonth-hint apply-startedMonth-error" />
        <p class="field__error" id="apply-startedMonth-error" hidden></p>
      </div>
      <Field {...select('industryYears')} hint={hintOf('industryYears')} reserveError />
    </div>
    <Field
      id="apply-message"
      name="message"
      label={APPLY_FIELDS.message.label}
      type="textarea"
      rows={6}
      maxlength={4000}
      hint={APPLY_FIELDS.message.hint}
      reserveError
    />
  </Fieldset>

  <Fieldset legend="Team and horizon" step="team">
    <div class="apply-context" data-context-field hidden>
      <Field {...select('teamFunding')} hint={hintOf('teamFunding')} reserveError />
      <Field {...select('horizon')} hint={hintOf('horizon')} reserveError />
    </div>
    <Field
      id="apply-seats"
      name="seats"
      label={APPLY_FIELDS.seats.label}
      type="textarea"
      rows={3}
      maxlength={500}
      hint={APPLY_FIELDS.seats.hint}
      reserveError
    />
    <p class="field__hint">Want help sketching roles? Use the <a href={href('/tools/team-composer/')}>Team Composer</a> first. It brings your roles back to this form.</p>
    <div class="apply-context" data-context-field hidden>
      <Field {...select('source')} hint={hintOf('source')} reserveError />
    </div>
  </Fieldset>

  <section class="fieldset review" data-step="review" data-review hidden>
    <h2 class="fieldset__heading" tabindex="-1" data-step-heading>{REVIEW_COPY.title}</h2>
    <p class="field__hint">{REVIEW_COPY.intro}</p>
    <div class="review__list stack" data-review-list></div>
  </section>
</FormFrame>

<style is:global>
  @layer pages {
    .intake .fieldset[hidden],
    .intake [data-step][hidden],
    .intake .btn[hidden],
    .intake [data-context-field][hidden],
    .intake [data-situation-heading][hidden] {
      display: none;
    }

    .intake .fieldset__heading {
      font: inherit;
      margin: 0;
    }

    .apply-context {
      display: grid;
      gap: var(--sp-4);
    }

    .apply-situation__heading {
      margin: 0;
      font-family: var(--ff-display);
      font-size: var(--fs-lg);
      font-weight: 700;
      color: var(--color-text);
    }

    .stepper {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--sp-2) var(--sp-5);
      padding-block: var(--sp-2);
      border-block-end: var(--border-hair);
      background: var(--color-bg);
      font-family: var(--ff-sans);
    }

    .stepper[hidden] {
      display: none;
    }

    .stepper__status {
      font-weight: 700;
      color: var(--color-text);
    }

    .stepper__list {
      display: flex;
      flex-wrap: wrap;
      gap: var(--sp-2) var(--sp-4);
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .stepper__item {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: var(--sp-2);
      color: var(--color-text-muted);
      font-size: var(--fs-sm);
    }

    .stepper__item[data-state='current'] {
      color: var(--color-text);
      font-weight: 700;
    }

    .stepper__num {
      display: inline-grid;
      place-items: center;
      inline-size: 1.75rem;
      block-size: 1.75rem;
      border: 2px solid var(--color-border-strong);
      border-radius: var(--radius-pill);
      font-weight: 700;
      color: var(--color-text);
      background: var(--color-bg);
    }

    .stepper__item[data-state='current'] .stepper__num {
      background: var(--color-cta);
      border-color: var(--color-cta);
      color: var(--color-cta-contrast);
    }

    .stepper__item[data-state='done'] .stepper__num {
      border-color: var(--color-link);
      color: var(--color-link);
    }

    /* A phone gets a sticky two-row bar: the status line, and four segments that fill as the steps are completed. */
    @media (max-width: 40rem) {
      .stepper {
        position: sticky;
        inset-block-start: 0;
        z-index: var(--z-header);
        display: grid;
        gap: var(--sp-1);
      }

      .stepper__status {
        font-size: var(--fs-sm);
      }

      .stepper__list {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: var(--sp-1);
      }

      .stepper__item {
        block-size: 0.375rem;
        border-radius: var(--radius-pill);
        background: var(--color-border-strong);
      }

      .stepper__item[data-state='done'],
      .stepper__item[data-state='current'] {
        background: var(--color-cta);
      }

      .stepper__num,
      .stepper__label {
        position: absolute;
        inline-size: 1px;
        block-size: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }
    }

    /* The bar can cover the top of the viewport on a phone, so a focused control is always scrolled clear of it (WCAG 2.2, 2.4.11).
       The script writes the bar's measured height to --stepper-bar-h on the form; 4rem covers the two-row bar until it does. */
    .intake[data-stepper='on'] :is(input, select, textarea, button, a, [tabindex='-1'], .error-summary) {
      scroll-margin-block-start: calc(var(--stepper-bar-h, 4rem) + var(--sp-4));
    }

    .review__group {
      display: grid;
      gap: var(--sp-2);
      padding-block-end: var(--sp-3);
      border-block-end: var(--border-hair);
    }

    .review__head {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--sp-2);
    }

    .review__title {
      font-size: var(--fs-base);
    }

    .review__rows {
      display: grid;
      gap: var(--sp-2);
      margin: 0;

      & dt {
        font-size: var(--fs-sm);
        color: var(--color-text-muted);
      }

      & dd {
        margin: 0;
        overflow-wrap: anywhere;
        white-space: pre-wrap;
      }
    }
  }
</style>
