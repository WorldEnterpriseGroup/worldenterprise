---
/** A list of programs as a responsive grid of rows. */
import type { EcosystemEntry } from '../../data/ecosystem/types.ts';
import EntryRow from './EntryRow.astro';

interface Props {
  entries: readonly EcosystemEntry[];
  level?: 3 | 4;
  idPrefix?: string;
  label?: string;
}

const { entries, level = 3, idPrefix = 'p-', label } = Astro.props;
---

<ul class="eco-list" aria-label={label}>
  {entries.map((entry) => <EntryRow entry={entry} level={level} idPrefix={idPrefix} />)}
</ul>

<style>
  @layer pages {
    .eco-list {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
      gap: var(--sp-5);
      margin: 0;
      padding: 0;
      list-style: none;
    }
  }
</style>
