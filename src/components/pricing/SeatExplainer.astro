---
/**
 * What a seat is, how WE steers it and which roles a seat can fill (claims C-02, C-03, C-10). The diagram is the one the program pages
 * use. The roles table lists a monthly rate only while the operator has published the seat rate (claim C-06, flags.seatPrice).
 */
import { flags } from '../../data/flags.ts';
import { ROLES } from '../../scripts/team-composer.ts';
import SeatDiagram from '../program/SeatDiagram.astro';
import DataTable from '../ui/DataTable.astro';

/** The rate column exists only while the operator has published the seat rate (claim C-06, FLAG-PRICE). */
const rate = flags.seatPrice.published ? flags.seatPrice.monthlyRate : null;
const money = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });
const columns = rate === null ? ['Role', 'What the seat does'] : ['Role', 'What the seat does', 'Monthly rate per seat'];
const rows = ROLES.map((role) => (rate === null ? [role.label, role.summary] : [role.label, role.summary, money.format(rate)]));

const facts = [
  { label: 'Dedicated', text: 'A person fills the seat and works only on your company.' },
  { label: 'Offshore', text: 'The person works offshore, fully remote.' },
  { label: 'Your roles', text: 'You choose the roles you need.' },
  { label: 'Steered by WE', text: 'WE steers the team and manages the subcontractors who fill the seats, so you work with one team instead of coordinating individuals.' },
] as const;
---

<section id="seats" class="seats" aria-labelledby="seats-title">
  <div class="seats__head">
    <h2 id="seats-title">How seats work</h2>
    <p>A seat is one dedicated place on your team.</p>
  </div>

  <ul class="seats__facts" role="list">
    {
      facts.map((fact) => (
        <li class="seats__fact">
          <span class="seats__fact-label">{fact.label}</span>
          <span>{fact.text}</span>
        </li>
      ))
    }
  </ul>

  <p class="seats__unit">
    The seat is the unit of work. Packages and custom seat plans are two ways to arrange seats. You can scale up or down by notice, whichever you
    choose. The notice terms are set out in the written agreement, not on this page.
  </p>

  <SeatDiagram labelledby="seats-title" />

  <div class="seats__roles">
    <h3 id="roles-title">Roles a seat can fill</h3>
    <DataTable caption="Seat roles and what each seat does" columns={columns} rows={rows} />
    {
      rate === null && (
        <p class="seats__note">No rate is listed here. Ask for it and WE shares the current figure for a package, a custom seat plan or the add-on.</p>
      )
    }
  </div>
</section>

<style>
  @layer pages {
    .seats {
      display: grid;
      gap: var(--sp-5);
      margin-block-start: var(--space-block);
      scroll-margin-block-start: calc(var(--header-h) + var(--sp-4));
    }

    .seats__head {
      display: grid;
      gap: var(--space-heading);
      max-inline-size: var(--prose-max);
    }

    .seats__facts {
      display: grid;
      gap: var(--sp-3);
      padding: 0;
      list-style: none;
      font-family: var(--ff-sans);

      @media (min-width: 40rem) {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      @media (min-width: 64rem) {
        grid-template-columns: repeat(4, minmax(0, 1fr));
      }
    }

    .seats__fact {
      display: grid;
      align-content: start;
      gap: var(--sp-1);
      padding: var(--sp-4);
      background: var(--color-bg-soft);
      border-inline-start: 4px solid var(--color-highlight);
      border-radius: var(--radius-sm);
    }

    .seats__fact-label {
      font-family: var(--ff-display);
      font-size: var(--fs-sm);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: var(--tracking-caps);
      color: var(--color-link);
    }

    .seats__unit {
      max-inline-size: var(--prose-max);
    }

    .seats__roles {
      display: grid;
      gap: var(--sp-3);
      margin-block-start: var(--sp-4);
    }

    .seats__note {
      font-family: var(--ff-sans);
      color: var(--color-text-muted);
    }
  }
</style>
