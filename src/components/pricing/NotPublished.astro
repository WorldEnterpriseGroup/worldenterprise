---
/**
 * What this page does not publish, and how to ask (claims C-06, C-10; flags.seatPrice stays off). The page lists no amounts and no
 * seat count per package. The way to ask is the contact form with the seat-rate topic.
 */
import { href } from '../../lib/url.ts';

interface Props {
  /** The contact form route that opens with the seat-rate topic. */
  ask: { readonly label: string; readonly href: string };
}

const { ask } = Astro.props;
---

<section id="not-published" class="notpub" aria-labelledby="notpub-title">
  <div class="notpub__head">
    <h2 id="notpub-title">What WE does not publish here, and how to ask</h2>
    <p>WE shares the current rate when you ask, so the figure you receive is the one that applies today.</p>
  </div>

  <div class="notpub__grid">
    <div class="notpub__col">
      <h3>Not on this page</h3>
      <ul class="notpub__list">
        <li><strong>Amounts.</strong> No rate for a package, for a seat or for the add-on.</li>
        <li>
          <strong>Seat counts for a package.</strong> A package is sized by stage and depth. WE sets the seat plan inside it to match its depth and
          confirms the plan in writing when you ask for the current rate.
        </li>
      </ul>
    </div>
    <div class="notpub__col">
      <h3>How to ask</h3>
      <ol class="notpub__list">
        <li>Open the contact form with the topic for the current seat rate.</li>
        <li>Say what you want a rate for: a package, a custom seat plan or the add-on.</li>
        <li>WE shares the current figure for it.</li>
      </ol>
      <p>
        <a class="btn btn--primary" href={href(ask.href)}>{ask.label}</a>
      </p>
    </div>
  </div>
</section>

<style>
  @layer pages {
    .notpub {
      display: grid;
      gap: var(--sp-5);
      margin-block-start: var(--space-block);
      padding: var(--sp-5);
      background: var(--color-amber-wash);
      border: var(--border-hair);
      border-inline-start: 6px solid var(--color-highlight);
      border-radius: var(--radius-md);
      font-family: var(--ff-sans);
      scroll-margin-block-start: calc(var(--header-h) + var(--sp-4));
    }

    .notpub__head {
      display: grid;
      gap: var(--space-heading);
      max-inline-size: var(--prose-max);
    }

    .notpub__grid {
      display: grid;
      gap: var(--sp-5);

      @media (min-width: 52rem) {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    .notpub__col {
      display: grid;
      align-content: start;
      gap: var(--sp-3);
    }

    .notpub__list {
      display: grid;
      gap: var(--sp-2);
      padding-inline-start: var(--sp-5);
    }
  }
</style>
