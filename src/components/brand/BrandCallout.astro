---
/**
 * A boxed aside for the three things a family page says apart from its main text: a note, a limit (what the page does not claim) and
 * a consideration. The title is a paragraph, never a heading, so the heading outline of the page is untouched. Meaning is carried
 * by the title and the mark on the leading edge (solid, double or dashed), never by colour alone.
 */
interface Props {
  tone?: 'note' | 'limit' | 'consider';
  title?: string;
}

const { tone = 'note', title } = Astro.props;
---

<aside class={`bcallout bcallout--${tone}`}>
  {title && <p class="bcallout__title">{title}</p>}
  <div class="bcallout__body stack"><slot /></div>
</aside>

<style>
  .bcallout {
    display: grid;
    gap: var(--sp-2);
    padding: var(--sp-4) var(--sp-5);
    border: var(--border-hair);
    border-inline-start-width: 4px;
    border-inline-start-style: solid;
    border-inline-start-color: var(--color-accent);
    border-radius: var(--radius-md);
    background: var(--tint-blue);
    color: var(--color-text);
  }

  .bcallout__title {
    margin: 0;
    font-family: var(--ff-display);
    font-size: var(--fs-sm);
    font-weight: 700;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  .bcallout__body {
    font-size: var(--fs-base);
    line-height: var(--lh-body);

    & > :first-child {
      margin-block-start: 0;
    }

    & > :last-child {
      margin-block-end: 0;
    }
  }

  .bcallout--limit {
    border-inline-start-style: double;
    border-inline-start-width: 6px;
    border-inline-start-color: var(--color-highlight-ink);
    background: var(--tint-sand);
  }

  .bcallout--consider {
    border-inline-start-style: dashed;
    border-inline-start-color: var(--color-border-strong);
    background: var(--tint-stone);
  }

  @media (forced-colors: active) {
    .bcallout {
      border-color: CanvasText;
      background: Canvas;
    }
  }
</style>
