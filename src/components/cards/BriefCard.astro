---
import { getPhoto } from '../../assets/photo/index.ts';
import type { SlotId } from '../../assets/photo/slots.ts';
import { href } from '../../lib/url.ts';
import Card from '../ui/Card.astro';

interface Props {
  title: string;
  summary: string;
  path: string;
  eyebrow?: string;
  photo?: SlotId;
  headingLevel?: 2 | 3 | 4;
  meta?: string;
}

const { title, summary, path, eyebrow = 'Research brief', photo, headingLevel = 3, meta } = Astro.props;
const image = photo ? getPhoto(photo) : undefined;
---

<Card
  title={title}
  href={href(path)}
  eyebrow={eyebrow}
  headingLevel={headingLevel}
  image={image ? { src: image.src.src, width: image.src.width, height: image.src.height, alt: image.alt } : undefined}
>
  <p>{summary}</p>
  {meta && <p class="card__meta">{meta}</p>}
</Card>
