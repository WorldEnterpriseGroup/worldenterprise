---
import wordmark from '../../assets/brand/we-logo-wordmark.svg';
import { applyButton, resolveNav } from '../../data/nav.ts';
import { site } from '../../data/site.ts';
import { getRouteState } from '../../lib/route-state.ts';
import { href } from '../../lib/url.ts';
import MegaNav from './MegaNav.astro';
import MobileNav from './MobileNav.astro';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const state = await getRouteState();
const items = resolveNav(state.isLive);
const apply = state.isLive(applyButton.href) ? applyButton : null;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href={href('/')} class="site-header__logo" aria-label={`${site.name}, home`}>
      <img src={wordmark.src} width={wordmark.width} height={wordmark.height} alt="World Enterprise" decoding="async" />
    </a>
    {items.length > 0 && <MegaNav items={items} currentPath={currentPath} />}
    {apply && <a class="btn btn--primary site-header__apply" href={href(apply.href)}>{apply.label}</a>}
    {items.length > 0 && <MobileNav items={items} apply={apply} currentPath={currentPath} />}
  </div>
</header>
<script>
  import '../../scripts/nav.ts';
</script>
