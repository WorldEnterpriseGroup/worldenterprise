---
import type { Crumb } from '../../lib/breadcrumbs.ts';
import HeroCompact from '../hero/HeroCompact.astro';
import type { HeroCta, HeroMeasure } from '../hero/types.ts';

/** The compact page opener. Kept as the stable name for pages that need only a title, a lead and perhaps one action. */
interface Props {
  title: string;
  eyebrow?: string;
  lead?: string;
  crumbs?: readonly Crumb[];
  primary?: HeroCta | undefined;
  secondary?: HeroCta | undefined;
  measure?: HeroMeasure;
}

const { title, eyebrow, lead, crumbs = [], primary, secondary, measure = 'default' } = Astro.props;
---

<HeroCompact title={title} eyebrow={eyebrow} lead={lead} crumbs={crumbs} primary={primary} secondary={secondary} measure={measure}>
  <slot />
</HeroCompact>
