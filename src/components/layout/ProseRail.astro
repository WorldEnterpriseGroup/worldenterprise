---
import CtaAside from '../cta/CtaAside.astro';
import { resolvePageCta } from '../cta/page-cta.ts';
import SourcesList from '../blocks/SourcesList.astro';
import type { CtaCollection, CtaVariant } from '../../data/cta/index.ts';
import { railToc } from '../../lib/rail-toc.ts';
import { href as withBase } from '../../lib/url.ts';
import type { HeroCta } from '../hero/types.ts';

/**
 * The body of a prose page in the 110rem frame (WP-109, issue #109). Running text keeps its reading measure and never sits alone: it is
 * the middle of three columns that together fill the frame. The start column is an "on this page" list built from the h2 headings of
 * the body (a page without a list gives the column to its call to action), the end column is the call to action the default map
 * gives this page and the sources where the page has any. Both rails are sticky. The measure and the reading type grow together at
 * wide screens (--prose-max, --fs-read), so the leftover width is absorbed by larger type and rails that flex, not by an empty
 * track. Below 75rem the page is one column: the list is hidden and the rails follow the body.
 *
 * The body is rendered to HTML here so the list can be read from it; `railToc` gives every h2 an id, so no page has to declare a
 * table of contents. Slots: the default slot is the body, `before` and `after` sit in the body column around it, and `rail` adds
 * content to the sticky rail between the list and the call to action.
 */
interface Source {
  readonly id: string;
  readonly title: string;
  readonly publisher: string;
  readonly url: string;
  readonly accessed?: Date | undefined;
}

interface Props {
  path: string;
  collection: CtaCollection;
  /** The frontmatter `cta` override of the document. */
  cta?: { readonly variant: CtaVariant; readonly briefId?: string | undefined } | undefined;
  /** Classes of the element that wraps the body: `prose` for Markdown and long-form text, `flow-wide` for a marketing body. */
  bodyClass?: string;
  sources?: readonly Source[];
  /** The body, already rendered to HTML by a layout that had to look at it. Without it the default slot is the body. */
  html?: string;
  /**
   * Links for the rail of a page that has neither a list of headings nor a call to action (a squeeze page, a form page): the page's own
   * hero actions, so the rail still tells the reader where to go.
   */
  jump?: readonly (HeroCta | undefined)[];
  /** The list needs at least this many h2 headings to be worth showing. */
  minHeadings?: number;
}

const { path, collection, cta, bodyClass = 'prose', sources = [], html: given, minHeadings = 2, jump = [] } = Astro.props;
const { html, items } = railToc(given ?? (await Astro.slots.render('default')));
const showToc = items.length >= minHeadings;
const model = await resolvePageCta({ path, collection, cta });
const hasRailSlot = Astro.slots.has('rail');
const hasSources = sources.length > 0;
const jumpLinks = showToc || model !== null ? [] : jump.filter((a): a is HeroCta => a !== undefined);
const hasToc = showToc || jumpLinks.length > 0;
const hasCta = model !== null;
// The start column: the list of headings, or the call to action when the page has no list. The end column: what is left.
const ctaAtStart = !hasToc && hasCta;
const hasStart = hasToc || ctaAtStart;
const hasEnd = hasRailSlot || (hasCta && !ctaAtStart);
---

<div
  class:list={[
    'container',
    'with-rail',
    'with-rail--page',
    hasStart && 'with-rail--start',
    hasEnd && 'with-rail--end',
    hasSources && 'with-rail--sources',
  ]}
>
  {
    hasStart && (
      <aside class:list={['rail', 'rail--start', !hasToc && 'rail--cta']} aria-label={hasToc ? 'On this page' : 'About this page'}>
        {
          showToc && (
            <nav class="toc-rail" aria-label="On this page">
              <p class="eyebrow">On this page</p>
              <ol role="list">
                {items.map((item) => (
                  <li>
                    <a href={`#${item.id}`}>{item.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }
        {
          jumpLinks.length > 0 && (
            <nav class="toc-rail" aria-label="On this page">
              <p class="eyebrow">On this page</p>
              <ol role="list">
                {jumpLinks.map((link) => (
                  <li>
                    <a href={withBase(link.href)}>{link.label}</a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }
        {ctaAtStart && <CtaAside model={model} level={2} />}
      </aside>
    )
  }
  <div class="with-rail__body stack">
    <slot name="before" />
    <div class={bodyClass} set:html={html} />
    <slot name="after" />
  </div>
  {
    hasEnd && (
      <aside class="rail rail--end" aria-label="About this page">
        <slot name="rail" />
        {!ctaAtStart && <CtaAside model={model} />}
      </aside>
    )
  }
  {
    hasSources && (
      <div class="rail-sources">
        <SourcesList sources={sources} />
      </div>
    )
  }
</div>
