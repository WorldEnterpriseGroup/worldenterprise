---
import wordmark from '../../assets/brand/we-logo-wordmark.svg';
import manifest from '../../assets/photo/manifest.json';
import { flags } from '../../data/flags.ts';
import { resolveFooter } from '../../data/nav.ts';
import { site } from '../../data/site.ts';
import { hasGeneratedImages, PHOTO_DISCLOSURE, PHOTO_DISCLOSURE_HREF } from '../../lib/photo-disclosure.ts';
import { getRouteState } from '../../lib/route-state.ts';
import { href } from '../../lib/url.ts';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const state = await getRouteState();
const columns = resolveFooter(state.isLive);
const legalLine = flags.pbcWording ? site.legalLine : `${site.legalName}, registered in Delaware`;
const year = new Date().getUTCFullYear();
// Shown only while at least one image is image-model output; the audit requires it on every page in that state.
const showPhotoDisclosure = hasGeneratedImages(manifest.slots);
const disclosureLinked = state.isLive(PHOTO_DISCLOSURE_HREF);
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand stack">
      <a href={href('/')} class="site-footer__logo" aria-label={`${site.name}, home`}>
        <img src={wordmark.src} width={wordmark.width} height={wordmark.height} alt="World Enterprise" loading="lazy" decoding="async" />
      </a>
      <p class="site-footer__motto">{site.motto}</p>
      <p class="site-footer__positioning">{site.description}</p>
    </div>
    {
      columns.map((column) => (
        <nav class="site-footer__col" aria-labelledby={`footer-${column.heading.toLowerCase().replace(/[^a-z]+/g, '-')}`}>
          <h2 class="site-footer__heading" id={`footer-${column.heading.toLowerCase().replace(/[^a-z]+/g, '-')}`}>
            {column.heading}
          </h2>
          <ul role="list">
            {column.links.map((link) => (
              <li>
                <a href={href(link.href)} aria-current={link.href === currentPath ? 'page' : undefined}>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <div class="site-footer__bar">
    <div class="container site-footer__bar-inner">
      <p>&copy; {year} {legalLine}.</p>
      <p>{site.signature}</p>
      {
        showPhotoDisclosure && (
          <p class="site-footer__disclosure">
            {PHOTO_DISCLOSURE}
            {disclosureLinked && (
              <>
                {' '}
                <a href={href(PHOTO_DISCLOSURE_HREF)}>Editorial policy</a>
              </>
            )}
          </p>
        )
      }
    </div>
  </div>
</footer>

<style>
  @layer reset, tokens, base, layout, components, utilities, pages, print;

  @layer components {
    /* Its own row under the copyright and signature, so the longer line never squeezes the other two. */
    .site-footer__disclosure {
      flex: 1 1 100%;
    }
  }
</style>
