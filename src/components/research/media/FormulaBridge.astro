---
/**
 * FormulaBridge (WP-23, #89): a formula drawn as a bridge (a waterfall schematic), e.g. net revenue retention: the starting revenue, what
 * is added, what is lost, and where the period ends. Bar heights are illustrative and print no numbers, because the figure explains a
 * definition, not a dataset; the caption says so. The steps are also a list with the formula written out.
 */
import { cleanText } from '../../visuals/contracts.ts';

export interface BridgeStep {
  readonly label: string;
  /** base: a full bar from zero (start or end); add: rises; subtract: falls. */
  readonly kind: 'base' | 'add' | 'subtract';
  /** Illustrative size, 0 to 1 of the axis. Rendering only; never printed. */
  readonly size: number;
}

interface Props {
  title: string;
  steps: readonly BridgeStep[];
  /** The formula, written out. */
  formula: string;
  note?: string;
  headingLevel?: 3 | 4;
  class?: string;
}

const { headingLevel = 3, class: className } = Astro.props;
const title = cleanText('FormulaBridge', 'title', Astro.props.title);
const formula = cleanText('FormulaBridge', 'formula', Astro.props.formula);
const note = Astro.props.note === undefined ? undefined : cleanText('FormulaBridge', 'note', Astro.props.note);
if (Astro.props.steps.length < 3 || Astro.props.steps.length > 7) throw new Error(`FormulaBridge: takes 3 to 7 steps, got ${Astro.props.steps.length}`);
const steps = Astro.props.steps.map((s, i) => {
  if (!(s.size > 0 && s.size <= 1)) throw new Error(`FormulaBridge: step ${i + 1} size must be above 0 and at most 1`);
  return { label: cleanText('FormulaBridge', `step ${i + 1} label`, s.label), kind: s.kind, size: s.size };
});

const W = 640;
const H = 300;
const base = 250;
const top = 20;
const scale = base - top;
const colW = W / steps.length;
const barW = colW * 0.56;
let level = 0;
const bars = steps.map((s, i) => {
  let from: number;
  let to: number;
  if (s.kind === 'base') {
    from = 0;
    to = s.size;
    level = s.size;
  } else if (s.kind === 'add') {
    from = level;
    to = Math.min(1, level + s.size);
    level = to;
  } else {
    from = level;
    to = Math.max(0, level - s.size);
    level = to;
  }
  const y1 = base - Math.max(from, to) * scale;
  const y2 = base - Math.min(from, to) * scale;
  const x = i * colW + (colW - barW) / 2;
  return { ...s, x, y: y1, h: Math.max(2, y2 - y1), end: base - to * scale };
});
const H_ = headingLevel === 3 ? 'h3' : 'h4';
const sign = { base: '', add: 'plus ', subtract: 'minus ' } as const;
---

<figure class:list={['bridge', className]}>
  <H_ class="bridge__title">{title}</H_>
  <svg class="bridge__art" viewBox={`0 0 ${W} ${H}`} aria-hidden="true" focusable="false">
    <line x1="0" x2={W} y1={base} y2={base} class="bridge__axis" />
    {
      bars.map((b, i) => (
        <g>
          <rect x={b.x} y={b.y} width={barW} height={b.h} rx="4" class={`bridge__bar bridge__bar--${b.kind}`} />
          {i < bars.length - 1 && <line x1={b.x + barW} x2={b.x + colW} y1={b.end} y2={b.end} class="bridge__link" />}
          <text x={b.x + barW / 2} y={base + 30} text-anchor="middle" class="bridge__n">
            {i + 1}
          </text>
        </g>
      ))
    }
  </svg>
  <ol class="bridge__list" role="list">
    {
      steps.map((s, i) => (
        <li>
          <span class={`bridge__key bridge__key--${s.kind}`} aria-hidden="true">
            {i + 1}
          </span>
          {sign[s.kind]}
          {s.label}
        </li>
      ))
    }
  </ol>
  <p class="bridge__formula"><code>{formula}</code></p>
  <figcaption class="bridge__note">{note ?? 'A schematic: bar heights are illustrative, not data.'}</figcaption>
</figure>

<style>
  @layer pages {
    .bridge {
      margin: 0;
      display: grid;
      gap: var(--sp-3);
    }

    .bridge__title {
      margin: 0;
      font-size: var(--fs-h4);
    }

    .bridge__art {
      display: block;
      inline-size: 100%;
      block-size: auto;
    }

    .bridge__axis {
      stroke: var(--we-grey-ui);
      stroke-width: 1.5;
    }

    .bridge__link {
      stroke: var(--we-grey-ui);
      stroke-dasharray: 4 4;
    }

    .bridge__bar--base {
      fill: var(--we-blue);
    }

    .bridge__bar--add {
      fill: var(--we-blue-hi);
    }

    .bridge__bar--subtract {
      fill: var(--we-amber);
    }

    .bridge__n {
      fill: var(--color-text);
      font-family: var(--ff-display);
      font-size: 20px;
      font-weight: 700;
    }

    .bridge__list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-wrap: wrap;
      gap: var(--sp-2) var(--sp-4);
      font-size: var(--fs-sm);
    }

    .bridge__list li {
      display: inline-flex;
      align-items: center;
      gap: var(--sp-2);
    }

    .bridge__key {
      display: inline-grid;
      place-items: center;
      inline-size: 1.5rem;
      block-size: 1.5rem;
      border-radius: var(--radius-sm);
      font-size: var(--fs-xs);
      font-weight: 700;
      color: var(--we-white);
      background: var(--we-blue);
    }

    .bridge__key--add {
      background: var(--we-blue-hi);
      color: var(--we-blue-night);
    }

    .bridge__key--subtract {
      background: var(--we-amber);
      color: var(--we-charcoal);
    }

    .bridge__formula {
      margin: 0;
      padding: var(--sp-3);
      border-inline-start: 3px solid var(--we-blue);
      background: var(--color-bg-soft);
      font-size: var(--fs-sm);
      overflow-wrap: anywhere;
    }

    .bridge__note {
      font-size: var(--fs-xs);
      color: var(--color-text-muted);
    }
  }
</style>
