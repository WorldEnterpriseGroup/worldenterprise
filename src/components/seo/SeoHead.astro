---
import { Font } from 'astro:assets';
import { site } from '../../data/site.ts';
import { asset, href } from '../../lib/url.ts';
import { canonicalUrl } from '../../lib/seo.ts';
import type { RobotsDirective } from '../../lib/seo.ts';
import SpeculationRules from './SpeculationRules.astro';

export interface OgImage {
  /** Absolute URL of an AVIF 1200x630 image. Omit while the slot only holds a placeholder. */
  readonly url: string;
  readonly alt: string;
}

interface Props {
  /** Full document title, already in the form "{Page} | World Enterprise Incubator". */
  title: string;
  description: string;
  /** Route path, for example /program/. Canonicals always use the production origin. */
  path: string;
  robots: RobotsDirective;
  ogType?: 'website' | 'article';
  ogImage?: OgImage;
  /** LCP image to preload. The page must also mark the image fetchpriority="high". */
  preloadImage?: { readonly href: string; readonly type: string };
  /** Optional article metadata for og:article tags. */
  published?: Date;
  modified?: Date;
}

const { title, description, path, robots, ogType = 'website', ogImage, preloadImage, published, modified } = Astro.props;
const canonical = canonicalUrl(path);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={robots} />
<meta name="referrer" content="strict-origin-when-cross-origin" />
<meta name="color-scheme" content="light" />
<meta name="theme-color" content="#FFFFFF" />
<meta name="generator" content={Astro.generator} />

<link rel="alternate" type="application/rss+xml" title={`${site.name}: insights and research`} href={href('/rss.xml')} />
<link rel="sitemap" type="application/xml" href={asset('/sitemap-index.xml')} />
<link rel="icon" href={asset('/favicon.svg')} type="image/svg+xml" />
<link rel="apple-touch-icon" href={asset('/apple-touch-icon.png')} />

<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content="en_US" />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{ogImage && <meta property="og:image" content={ogImage.url} />}
{ogImage && <meta property="og:image:width" content="1200" />}
{ogImage && <meta property="og:image:height" content="630" />}
{ogImage && <meta property="og:image:alt" content={ogImage.alt} />}
{published && <meta property="article:published_time" content={published.toISOString()} />}
{modified && <meta property="article:modified_time" content={modified.toISOString()} />}
<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{ogImage && <meta name="twitter:image" content={ogImage.url} />}

{preloadImage && <link rel="preload" as="image" href={preloadImage.href} type={preloadImage.type} fetchpriority="high" />}

<Font cssVariable="--font-display" preload={[{ weight: '700', style: 'normal' }]} />
<Font cssVariable="--font-serif" preload={[{ weight: '400', style: 'normal' }]} />
<Font cssVariable="--font-sans" />
<Font cssVariable="--font-mono" />

<SpeculationRules />
<slot />
