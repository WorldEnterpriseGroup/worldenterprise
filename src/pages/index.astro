---
/**
 * The home page (SITE-COPY 1, WP-53): the galaxy hero, the long horizon (Dream, Build, Grow on the business clock), the real clock,
 * what WE does and how WE is paid, the Universal Business Framework, who WE works with, the latest insights and the closing band.
 * Every secondary action falls back to a built page until its new route is live (src/components/program/ctas.ts).
 */
import HomeClock from '../components/home/HomeClock.astro';
import HomeHero from '../components/home/HomeHero.astro';
import HomeJourney from '../components/home/HomeJourney.astro';
import HomeTeam from '../components/home/HomeTeam.astro';
import HomeUbf from '../components/home/HomeUbf.astro';
import LatestInsights from '../components/home/LatestInsights.astro';
import { heroPoster } from '../components/home/hero-image.ts';
import { SITUATIONS, situationHref } from '../components/home/home.ts';
import { loadPage } from '../components/program/loadPage.ts';
import { NO_FUNDING_LINE } from '../components/program/clock.ts';
import { START_REVIEW, pick } from '../components/program/ctas.ts';
import VisualIcon from '../components/visuals/VisualIcon.astro';
import { photoImage } from '../components/media/photo-image.ts';
import { preloadOfPhoto } from '../lib/image-type.ts';
import { getRouteState } from '../lib/route-state.ts';
import { href } from '../lib/url.ts';
import HomeLayout from '../layouts/HomeLayout.astro';
import DataTeaser from '../components/program/longevity/DataTeaser.astro';
import JoinPrograms from '../components/program/longevity/JoinPrograms.astro';
import LongevitySpine from '../components/program/longevity/LongevitySpine.astro';
import SbirBand from '../components/program/longevity/SbirBand.astro';

const { data } = await loadPage('home');
const state = await getRouteState();
const isLive = (path: string): boolean => state.isLive(path);
const heroImage = await heroPoster();
const desk = await photoImage('band-1');
const band = await photoImage('band-4');

const howLong = pick('howLong', isLive);
const who = pick('who', isLive);
const brief = pick('timelineBrief', isLive);
const situations = SITUATIONS.map((s) => ({ ...s, href: situationHref(s, isLive) }));
---
<HomeLayout description={data.description} updated={data.updated} draft={data.draft} ogSlot="og-home" preloadImage={preloadOfPhoto(heroImage)}>
  <HomeHero image={heroImage}
    eyebrow={data.eyebrow ?? 'World Enterprise'}
    title="WE build worlds."
    lead="Long-horizon business incubation and consulting, paced to the years a company really takes."
    body="Move fast every week. Build for the decade. WE steers a dedicated team that builds your company with you, from first proof through the years when most new businesses close, for as long as the work is useful."
    primary={START_REVIEW}
    secondary={howLong}
  />

  <HomeJourney more={pick('program', isLive)} />

  <HomeClock more={howLong} />

  <LongevitySpine
    detail="track"
    id="longevity"
    tone="plain"
    lead="Startups win by shipping every week. Companies survive by lasting years. WE does both: a weekly rhythm that never slips, on a timeline built for the long run."
  />

  <HomeTeam photo={desk} more={pick('howWeWork', isLive)} paid={pick('paid', isLive)} />

  <HomeUbf more={pick('ubf', isLive)} />

  <section class="band band--soft home-who" aria-labelledby="home-who-title">
    <div class="container stack stack--loose">
      <div class="split split--even">
        <div class="split__text home-who__text">
          <p class="eyebrow">Who WE works with</p>
          <h2 id="home-who-title">Built around the people who build companies.</h2>
          <p class="lead">Founders whose experience predicts success, and capable founders who need more capacity than they can yet hire.</p>
          {who && <p><a class="btn btn--secondary" href={href(who.href)}>{who.label}</a></p>}
        </div>
        <div class="split__media">
          <img class="home-band" src={band.src} srcset={band.srcset} sizes={band.srcset === undefined ? undefined : band.sizes} width={band.width} height={band.height} alt={band.alt} loading="lazy" decoding="async" />
        </div>
      </div>
      <ul class="home-who__list" role="list">
        {
          situations.map((s) => (
            <li class="home-who__card">
              <VisualIcon name={s.icon} size={40} />
              <h3 class="home-who__label">{s.href === undefined ? s.label : <a href={href(s.href)}>{s.label}</a>}</h3>
              <p>{s.line}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <JoinPrograms id="join" />

  <SbirBand />

  <DataTeaser tone="soft" />

  <LatestInsights />

  <Fragment slot="after">
    <section class="band band--deep home-end" aria-labelledby="home-end-title">
      <div class="container home-end__inner">
        <h2 id="home-end-title">Where is your company on the clock?</h2>
        <p class="lead">Start a readiness review. WE arranges a conversation, then sends a one-page read of where your company sits on the business timeline and what the next phase needs.</p>
        <p class="home-end__required">{NO_FUNDING_LINE}</p>
        <div class="cluster">
          <a class="btn btn--inverse" href={href(START_REVIEW.href)}>{START_REVIEW.label}</a>
          {brief && <a class="home-end__brief" href={href(brief.href)}>{brief.label}</a>}
        </div>
      </div>
    </section>
  </Fragment>
</HomeLayout>

<style>
  @layer pages {
    .home-band {
      inline-size: 100%;
      block-size: auto;
      aspect-ratio: 16 / 9;
      object-fit: cover;
      border-radius: var(--radius-md);
    }

    .home-who__text {
      display: grid;
      gap: var(--sp-4);
    }

    .home-who__list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
      gap: var(--sp-4);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .home-who__card {
      display: grid;
      align-content: start;
      gap: var(--sp-2);
      padding: var(--sp-5);
      background: var(--color-bg);
      border: var(--border-hair);
      border-radius: var(--radius-md);
    }

    .home-who__label {
      font-size: var(--fs-lg);
      line-height: var(--lh-tight);
    }

    .home-end__inner {
      display: grid;
      gap: var(--sp-4);
      justify-items: start;
    }

    .home-end__inner > p {
      max-inline-size: var(--prose-max);
    }

    .home-end__required {
      font-weight: 600;
    }

    .home-end__brief {
      font-weight: 600;
    }
  }
</style>
