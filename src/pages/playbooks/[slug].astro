---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import ArticleEnd from '../../components/families/visual/ArticleEnd.astro';
import Button from '../../components/ui/Button.astro';
import PlaybookMedia from '../../components/playbooks/PlaybookMedia.astro';
import PlaybookTrail from '../../components/playbooks/PlaybookTrail.astro';
import SmartLink from '../../components/playbooks/SmartLink.astro';
import { isLinkable, liveItems } from '../../components/playbooks/links.ts';
import { PLAYBOOK_RELATED, artifactRefs, liveSequence, nextLive } from '../../components/playbooks/meta.ts';
import PlaybookLayout from '../../layouts/PlaybookLayout.astro';
import { getRenderable, isDraft } from '../../lib/content.ts';
import { getRouteState } from '../../lib/route-state.ts';
import { href } from '../../lib/url.ts';

export const getStaticPaths = (async () => {
  const entries = await getRenderable('playbooks');
  // The route slug is the last segment of the entry id.
  return entries.map((entry) => ({ params: { slug: entry.id.split('/').at(-1) ?? entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { slug = '' } = Astro.params;
const { Content } = await render(entry);
const { data } = entry;

// The chain is the playbooks whose route is live in this build, so a playbook that is missing or still a draft is skipped, never linked.
const { isLive } = await getRouteState();
const chain = liveSequence(isLive);
const position = chain.findIndex((p) => p.slug === slug);
const next = nextLive(slug, isLive);
const terminal = position !== -1 && next === undefined;
const stageLabel = { dream: 'Dream', build: 'Build', grow: 'Grow' }[data.stage];
const eyebrow = position >= 0 ? `Playbook ${position + 1} of ${chain.length}, ${stageLabel}` : `Playbook, ${stageLabel}`;

const artifacts = await liveItems(artifactRefs(slug, data.relatedLibrary));
const related = await liveItems(PLAYBOOK_RELATED[slug] ?? []);
const photo = position >= 0 ? chain[position]?.slot : undefined;
const leadsTo = terminal && (await isLinkable('/fundability/'));
---

<PlaybookLayout
  title={data.title}
  description={data.description}
  path={`/playbooks/${slug}/`}
  stage={data.stage}
  eyebrow={eyebrow}
  lead={data.description}
  steps={data.steps}
  artifacts={artifacts}
  photo={photo}
  updated={data.updated}
  draft={isDraft(entry)}
>
  <PlaybookTrail current={slug} />
  <section class="stack" aria-labelledby="outputs-title">
    <h2 id="outputs-title">What you will have at the end</h2>
    <ul>
      {data.artifacts.map((artifact) => <li>{artifact}</li>)}
    </ul>
  </section>

  <PlaybookMedia slot="media" slug={slug} title={data.title} steps={data.steps} kicker={`Playbook, ${stageLabel}`} />

  <Fragment slot="after">
    <div class="section">
      <div class="container container--prose stack">
        <div class="prose">
          <Content components={{ a: SmartLink }} />
        </div>
        {
          next && (
            <nav class="stack" aria-label="Next playbook">
              <p class="eyebrow">Next playbook</p>
              <div class="cluster">
                <Button href={href(`/playbooks/${next.slug}/`)}>{next.short}</Button>
                <Button href={href('/playbooks/')} variant="quiet">All playbooks</Button>
              </div>
            </nav>
          )
        }
        {
          terminal && (
            <nav class="stack" aria-label="Where this leads">
              <p class="eyebrow">Where this leads</p>
              <div class="cluster">
                {leadsTo && <Button href={href('/fundability/')}>Investor readiness</Button>}
                <Button href={href('/playbooks/')} variant={leadsTo ? 'quiet' : 'primary'}>All playbooks</Button>
              </div>
            </nav>
          )
        }
      </div>
    </div>
  </Fragment>
  <ArticleEnd slot="cta-end" kind="playbooks" seed={slug} related={related} />
</PlaybookLayout>
