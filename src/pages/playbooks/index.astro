---
import { getEntry, render } from 'astro:content';
import { IDENTITY } from '../../components/families/visual/copy.ts';
import { HOW_WE_WORKS, READINESS_REVIEW, hubActions } from '../../components/families/visual/cta.ts';
import EmblemFrame from '../../components/families/visual/EmblemFrame.astro';
import VisualCards from '../../components/families/visual/VisualCards.astro';
import SafeCtaBand from '../../components/playbooks/SafeCtaBand.astro';
import PlaybookTrail from '../../components/playbooks/PlaybookTrail.astro';
import SmartLink from '../../components/playbooks/SmartLink.astro';
import { PLAYBOOKS_HUB_LEAD, liveSequence } from '../../components/playbooks/meta.ts';
import HubLayout from '../../layouts/HubLayout.astro';
import { getPublished, isDraft } from '../../lib/content.ts';
import { getRouteState } from '../../lib/route-state.ts';

const page = await getEntry('pages', 'playbooks');
if (!page) throw new Error('Missing content entry: src/content/pages/playbooks/index.mdx');
const { Content } = await render(page);
const { data } = page;

const state = await getRouteState();
const published = await getPublished('playbooks');
// Only the playbooks whose route is live in this build, in reading order.
const sequence = liveSequence(state.isLive);
const entries = sequence.flatMap((ref) => {
  const entry = published.find((e) => e.id.split('/').at(-1) === ref.slug);
  return entry ? [{ ref, entry }] : [];
});
const stageLabel = { dream: 'Dream', build: 'Build', grow: 'Grow' } as const;
// Each playbook is a mission patch; the pips on the patch count its place in the sequence.
const cards = entries.map(({ ref, entry }, i) => ({
  title: ref.short,
  href: `/playbooks/${ref.slug}/`,
  summary: entry.data.description,
  eyebrow: `${i + 1} of ${sequence.length}, ${stageLabel[entry.data.stage]}`,
  meta: `${entry.data.steps.length} steps`,
  index: i,
}));
const actions = hubActions(state.isLive, { label: 'Open the templates', href: '/library/' });
---

<HubLayout
  title={data.title}
  description={data.description}
  path="/playbooks/"
  eyebrow={data.eyebrow}
  lead={PLAYBOOKS_HUB_LEAD}
  updated={data.updated}
  draft={isDraft(page)}
  ogSlot="og-playbooks"
  hero="console"
  primary={actions.primary}
  secondary={actions.secondary}
  subtree={entries.map(({ ref, entry }) => ({
    title: ref.short,
    href: `/playbooks/${ref.slug}/`,
    description: entry.data.description,
  }))}
>
  <div slot="panel"><EmblemFrame kind="playbooks" seed="playbooks-hub" index={sequence.length - 1} caption={IDENTITY.playbooks.caption} /></div>
  <div class="prose">
    <Content components={{ a: SmartLink }} />
  </div>
  <PlaybookTrail />
  <section class="pb-missions" aria-labelledby="pb-list-title">
    <h2 id="pb-list-title">The playbooks, in order</h2>
    <VisualCards kind="playbooks" cards={cards} headingLevel={3} size="large" labelledby="pb-list-title" />
  </section>
  <SafeCtaBand
    slot="after"
    title="Work through them with a team behind you"
    text="WE steers a dedicated team that builds the company with its founder, for as long as the work is useful. A readiness review is where that starts."
    primary={{ label: READINESS_REVIEW.label, href: READINESS_REVIEW.href }}
    secondary={{ label: HOW_WE_WORKS.label, href: HOW_WE_WORKS.href }}
  />
</HubLayout>

<style>
  @layer pages {
    .pb-missions {
      display: grid;
      gap: var(--sp-5);
    }
  }
</style>
