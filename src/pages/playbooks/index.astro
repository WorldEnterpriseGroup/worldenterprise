---
import { getEntry, render } from 'astro:content';
import { getPhoto } from '../../assets/photo/index.ts';
import PlaybookCard from '../../components/cards/PlaybookCard.astro';
import SafeCtaBand from '../../components/playbooks/SafeCtaBand.astro';
import Grid from '../../components/ui/Grid.astro';
import PlaybookTrail from '../../components/playbooks/PlaybookTrail.astro';
import SmartLink from '../../components/playbooks/SmartLink.astro';
import { PLAYBOOK_SEQUENCE } from '../../components/playbooks/meta.ts';
import HubLayout from '../../layouts/HubLayout.astro';
import { getPublished, isDraft } from '../../lib/content.ts';

const page = await getEntry('pages', 'playbooks');
if (!page) throw new Error('Missing content entry: src/content/pages/playbooks/index.mdx');
const { Content } = await render(page);
const { data } = page;

const published = await getPublished('playbooks');
const cards = PLAYBOOK_SEQUENCE.flatMap((ref) => {
  const entry = published.find((e) => e.id.split('/').at(-1) === ref.slug);
  return entry ? [{ ref, entry }] : [];
});
const inset = getPhoto('inset-playbooks');
const stageLabel = { dream: 'Dream', build: 'Build', grow: 'Grow' } as const;
---

<HubLayout
  title={data.title}
  description={data.description}
  path="/playbooks/"
  eyebrow={data.eyebrow}
  lead="Five playbooks, one for each stage of building a SaaS company. Each one is a short sequence of steps, the artifacts you should end up with, and the mistakes that cost founders the most time."
  updated={data.updated}
  draft={isDraft(page)}
  ogSlot="og-playbooks"
  subtree={cards.map(({ ref, entry }) => ({
    title: ref.short,
    href: `/playbooks/${ref.slug}/`,
    description: entry.data.description,
  }))}
>
  <div class="pb-intro">
    <div class="prose">
      <Content components={{ a: SmartLink }} />
    </div>
    <img class="pb-inset" src={inset.src.src} width={inset.src.width} height={inset.src.height} alt={inset.alt} loading="lazy" decoding="async" />
  </div>
  <PlaybookTrail />
  <section class="stack" aria-labelledby="pb-list-title">
    <h2 id="pb-list-title">The playbooks, in order</h2>
    <Grid min="17rem">
      {
        cards.map(({ ref, entry }, i) => (
          <PlaybookCard
            title={ref.short}
            summary={entry.data.description}
            path={`/playbooks/${ref.slug}/`}
            photo={ref.slot}
            eyebrow={`${i + 1} of ${PLAYBOOK_SEQUENCE.length}, ${stageLabel[entry.data.stage]}`}
            headingLevel={3}
            meta={`${entry.data.steps.length} steps`}
          />
        ))
      }
    </Grid>
  </section>
  <SafeCtaBand
    slot="after"
    title="Work through them with a team behind you"
    text="WE places dedicated team seats around a founder and steers the work. Apply to see whether the program fits your idea."
    primary={{ label: 'Apply to the program', href: '/apply/' }}
    secondary={{ label: 'Open the templates', href: '/library/' }}
  />
</HubLayout>

<style>
  @layer pages {
    .pb-intro {
      display: grid;
      gap: var(--sp-6);
      align-items: start;
    }

    @media (min-width: 52rem) {
      .pb-intro {
        grid-template-columns: minmax(0, 1fr) minmax(0, 20rem);
      }
    }

    .pb-inset {
      inline-size: 100%;
      block-size: auto;
      border-radius: var(--radius-md);
    }
  }
</style>
