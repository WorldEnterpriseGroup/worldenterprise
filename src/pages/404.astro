---
import BaseLayout from '../layouts/BaseLayout.astro';
import { href } from '../lib/url.ts';
---

<BaseLayout title="Page not found" description="The page you asked for does not exist. Go to the home page or search the site." path="/404.html" crumbs={[]}>
  <section class="page-header">
    <div class="container stack">
      <p class="eyebrow">Error 404</p>
      <h1>This page is not here</h1>
      <div class="rule" aria-hidden="true"></div>
      <p class="lead">The address may have changed, or the page may not exist yet.</p>
      <div class="cluster">
        <a class="btn btn--primary" href={href('/')}>Go to the home page</a>
        <a class="btn btn--secondary" href={href('/search/')}>Search the site</a>
      </div>
    </div>
  </section>
</BaseLayout>
