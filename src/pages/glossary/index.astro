---
import { getCollection } from 'astro:content';
import ReferenceIntro from '../../components/families/visual/ReferenceIntro.astro';
import GlossaryList from '../../components/reference/GlossaryList.astro';
import { definedTermSetNode } from '../../components/reference/jsonld.ts';
import { metaLookup } from '../../components/reference/resources.ts';
import type { MetaCollection, MetaEntry } from '../../components/reference/resources.ts';
import ReferenceLayout from '../../layouts/ReferenceLayout.astro';
import { getPublished } from '../../lib/content.ts';
import type { PublicCollection } from '../../lib/content.ts';
import { getRouteState } from '../../lib/route-state.ts';

const state = await getRouteState();

/** The title of every content entry a term can link to, read once from the collections. */
async function entriesOf(collection: MetaCollection & PublicCollection): Promise<MetaEntry[]> {
  const entries = await getPublished(collection);
  return entries.map((entry) => ({ collection, id: entry.id, title: entry.data.title, description: entry.data.description }));
}
const collections: readonly (MetaCollection & PublicCollection)[] = ['pages', 'library', 'guides', 'playbooks', 'research'];
const meta = metaLookup((await Promise.all(collections.map(entriesOf))).flat());

const entries = (await getCollection('glossary')).filter((entry) => entry.data.draft !== true);
const terms = entries.map((entry) => ({
  id: entry.data.id,
  term: entry.data.term,
  definition: entry.data.definition,
  group: entry.data.group,
  related: entry.data.related,
  genericDefinition: entry.data.genericDefinition,
  claimAllow: entry.data.claimAllow,
  // A route that is not live on this build is left out, and so is one with no title.
  seeAlso: entry.data.seeAlso.flatMap((path) => {
    const found = state.isLive(path) ? meta(path) : undefined;
    return found === undefined ? [] : [{ href: path, label: found.title }];
  }),
}));
---

<ReferenceLayout
  title="Glossary"
  description="Plain definitions of the funding, finance, product, legal and security terms early-stage SaaS founders meet, plus the words WE uses."
  path="/glossary/"
  eyebrow="Reference"
  lead="Terms founders meet, defined neutrally. These are general definitions, not legal or financial advice."
  wide
  updated={new Date('2026-10-10')}
  jsonLd={[definedTermSetNode('/glossary/', 'World Enterprise Incubator glossary', terms)]}
>
  <ReferenceIntro kind="glossary" seed="glossary">
    <GlossaryList terms={terms} />
  </ReferenceIntro>
</ReferenceLayout>
