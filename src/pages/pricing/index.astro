---
/**
 * /pricing/ (retired by WP-54, wave 9 W9-13): the packages page is gone and /how-we-work/ replaces it. The site has no redirect
 * mechanism, so this stays a short noindex pointer (src/data/routes.ts sets indexable: false). The required texts live only on
 * /how-we-work/, their single home.
 */
import { getEntry, render } from 'astro:content';
import { photoImage } from '../../components/media/photo-image.ts';
import ToolLayout from '../../layouts/ToolLayout.astro';
import { href } from '../../lib/url.ts';

const entry = await getEntry('pages', 'pricing/pricing');
if (!entry) throw new Error('Missing content entry pages/pricing/pricing (src/content/pages/pricing/pricing.mdx).');
const { Content } = await render(entry);
const { data } = entry;

// The band sits in a 40rem column from 62rem and fills the container below it.
const band = await photoImage('band-3', { sizes: '(min-width: 62rem) 40rem, 100vw' });
---

<ToolLayout
  title={data.title}
  description={data.description}
  eyebrow={data.eyebrow}
  lead="Packages and seat prices are no longer published. See how WE works instead."
  path="/pricing/"
  photo="inset-pricing"
  primary={{ label: 'See how WE works', href: '/how-we-work/' }}
  secondary={{ label: 'Start a readiness review', href: '/apply/' }}
  updated={data.updated}
  draft={data.draft}
  ogSlot="og-default"
>
  <div class="prose"><Content /></div>
  <p><a href={href('/how-we-work/')}>Go to How WE works</a></p>
  <div class="pricing-visual">
    <img src={band.src} srcset={band.srcset} sizes={band.srcset === undefined ? undefined : band.sizes} width={band.width} height={band.height} alt={band.alt} loading="lazy" decoding="async" />
  </div>
</ToolLayout>

<style>
  @layer pages {
    .pricing-visual img {
      inline-size: min(100%, 40rem);
      block-size: auto;
      border-radius: var(--radius-md);
    }
  }
</style>
