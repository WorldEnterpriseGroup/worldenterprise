---
import { getCollection } from 'astro:content';
import FaqList from '../../components/cards/FaqList.astro';
import { anchorId, faqPageNode, groupBy } from '../../components/reference/jsonld.ts';
import Button from '../../components/ui/Button.astro';
import Callout from '../../components/ui/Callout.astro';
import ReferenceLayout from '../../layouts/ReferenceLayout.astro';
import { getRouteState } from '../../lib/route-state.ts';
import { href } from '../../lib/url.ts';

const entries = (await getCollection('faq')).filter((entry) => entry.data.draft !== true);
const items = entries.map((entry) => ({
  id: entry.data.id,
  question: entry.data.question,
  answer: entry.data.answer,
  group: entry.data.group,
}));
const slugify = (value: string): string => value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
// One accordion per group: opening a question closes the others in its group only.
const groups = groupBy(items).map((g) => ({
  heading: g.group,
  slug: slugify(g.group),
  questions: g.items.map((item) => ({ id: anchorId('faq', item.id), question: item.question, answer: item.answer })),
}));
const state = await getRouteState();
const canApply = state.isLive('/apply/');
const canContact = state.isLive('/contact/');
---

<ReferenceLayout
  title="FAQ"
  description="Short, plain answers about World Enterprise Incubator: what a seat is, how the remote model works, what WE does not do, and how to apply."
  path="/faq/"
  eyebrow="Reference"
  lead="Straight answers, including what WE does not do."
  updated={new Date('2026-10-06')}
  jsonLd={[faqPageNode('/faq/', items)]}
>
  <div class="stack stack--loose">
    {
      groups.map((g) => (
        <section aria-labelledby={`faq-group-${g.slug}`} class="stack">
          <h2 id={`faq-group-${g.slug}`}>{g.heading}</h2>
          <FaqList items={g.questions} name={`faq-${g.slug}`} />
        </section>
      ))
    }
  </div>
  {
    (canApply || canContact) && (
      <Callout title="Still have a question?">
        <p>Tell WE about your idea, or ask directly.</p>
        <div class="cluster">
          {canApply && <Button href={href('/apply/')}>Apply to the program</Button>}
          {canContact && <Button href={href('/contact/')} variant="secondary">Contact WE</Button>}
        </div>
      </Callout>
    )
  }
</ReferenceLayout>
