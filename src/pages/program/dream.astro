---
/**
 * The Dream stage page (SITE-COPY 2.4, WP-53): months 0 to 6, the D.R.E.A.M. Playbook and the O.R.B.I.T.A.L. Plan, drawn as the readiness scorecard
 * the stage starts from.
 */
import ReadinessScorecard from '../../components/visuals/illustrations/ReadinessScorecard.astro';
import ProgramEnd from '../../components/program/ProgramEnd.astro';
import StageBody from '../../components/program/StageBody.astro';
import StageLong from '../../components/program/StageLong.astro';
import { START_REVIEW, pick } from '../../components/program/ctas.ts';
import { loadPage } from '../../components/program/loadPage.ts';
import { STAGE_VIEWS } from '../../components/program/phases.ts';
import { getStage, nextStage } from '../../components/program/stages.ts';
import { getRouteState } from '../../lib/route-state.ts';
import StageLayout from '../../layouts/StageLayout.astro';

const stage = getStage('dream');
const view = STAGE_VIEWS.dream;
const { data, Content } = await loadPage('program/dream');
const state = await getRouteState();
const howLong = pick('howLong', (path: string): boolean => state.isLive(path));
const following = nextStage(stage.id);
const next = [
  ...(following ? [{ title: STAGE_VIEWS[following.id].headline, href: following.path, description: STAGE_VIEWS[following.id].subhead.split('. ')[0] + '.' }] : []),
  { title: 'From first conversation to Day One', href: '/program/how-it-works/', description: 'How an engagement starts.' },
  { title: 'The whole program', href: '/program/', description: 'Five phases on the business clock, and Mission Control.' },
];
---

<StageLayout
  title={data.title}
  seoTitle={data.seoTitle}
  description={data.description}
  path={stage.path}
  stage={stage.id}
  lead={view.subhead}
  updated={data.updated}
  draft={data.draft}
  primary={START_REVIEW}
  secondary={howLong}
  ogSlot="og-program"
  next={next}
>
  <StageLong stage={stage.id} name={stage.name}>
    <Content />
    <Fragment slot="visual">
      <ReadinessScorecard title="Readiness: the baseline, then the gaps closed" />
    </Fragment>
  </StageLong>
  <StageBody stage={stage} />
  <Fragment slot="after">
    <ProgramEnd title="Find out where your company starts" text="Start a readiness review. WE arranges a conversation, then sends a one-page read of where the company sits on the business clock and what Dream would need." secondary={howLong} />
  </Fragment>
</StageLayout>
