---
import { FITS, FIT_HEADING, NOT_FITS, NOT_FIT_HEADING } from '../../components/apply/fit.ts';
import LimitsBlock from '../../components/blocks/LimitsBlock.astro';
import { photoImage } from '../../components/media/photo-image.ts';
import Card from '../../components/ui/Card.astro';
import CtaBand from '../../components/ui/CtaBand.astro';
import { loadPage } from '../../components/program/loadPage.ts';
import { STAGES } from '../../components/program/stages.ts';
import { href } from '../../lib/url.ts';
import StageLayout from '../../layouts/StageLayout.astro';

const { data, Content } = await loadPage('program/who-its-for');
const [primary, secondary] = data.ctas;
const next = [
  { title: 'How the program works', href: '/program/how-it-works/', description: 'Five steps from application to a working team.' },
  { title: 'Frequently asked questions', href: '/faq/', description: 'Short answers on stage, scope and cost.' },
  { title: 'Is your SaaS idea a business or a feature?', href: '/insights/is-your-saas-idea-a-business-or-a-feature/', description: 'A first test you can run today.' },
];
---

<StageLayout
  title={data.title}
  description={data.description}
  path="/program/who-its-for/"
  eyebrow={data.eyebrow}
  lead="The founders and ideas WE builds with."
  updated={data.updated}
  draft={data.draft}
  primary={primary}
  secondary={secondary}
  ogSlot="og-program"
  next={next}
>
  <div class="prose measure"><Content /></div>

  <section class="stack" aria-labelledby="fit-yes">
    <h2 id="fit-yes">{FIT_HEADING}</h2>
    <ul class="measure fit">
      {FITS.map((f) => <li>{f}</li>)}
    </ul>
  </section>

  <section class="stack" aria-labelledby="fit-stages">
    <h2 id="fit-stages">Stages WE serves</h2>
    <p class="measure">
      WE serves a company from first idea to its first customers. A founder can join at the stage that matches the evidence already in
      hand: with an idea, at Dream; with a validated problem, at Build; with a product in use, at Grow.
    </p>
    <div class="grid grid--min-15">
      {
        STAGES.map(async (s) => {
          const image = await photoImage(s.slot);
          return (
            <Card
              title={`${s.name}: ${s.promise}`}
              href={href(s.path)}
              headingLevel={3}
              eyebrow={`${s.altitude} altitude`}
              image={image}
            >
              <p>{s.altitudeNote}</p>
            </Card>
          );
        })
      }
    </div>
  </section>

  <LimitsBlock title={NOT_FIT_HEADING} items={NOT_FITS} />

  <Fragment slot="after">
    {primary && <CtaBand title="Think you fit?" text="Apply. The application is short, and a clear no is as useful to you as a yes." cta={primary} secondary={secondary} />}
  </Fragment>
</StageLayout>
