---
/**
 * The Build stage page (SITE-COPY 2.5, WP-53): months 6 to 36, through the steepest year, drawn as the launch trajectory with the
 * L.A.U.N.C.H. Sequence along its trail.
 */
import LaunchTrajectory from '../../components/visuals/LaunchTrajectory.astro';
import ProgramEnd from '../../components/program/ProgramEnd.astro';
import StageBody from '../../components/program/StageBody.astro';
import StageLong from '../../components/program/StageLong.astro';
import { START_REVIEW, pick } from '../../components/program/ctas.ts';
import { loadPage } from '../../components/program/loadPage.ts';
import { METHODS, STAGE_VIEWS } from '../../components/program/phases.ts';
import { getStage, nextStage } from '../../components/program/stages.ts';
import { getRouteState } from '../../lib/route-state.ts';
import StageLayout from '../../layouts/StageLayout.astro';
import LongevitySpine from './_longevity/LongevitySpine.astro';
import SbirBand from './_longevity/SbirBand.astro';

const stage = getStage('build');
const view = STAGE_VIEWS.build;
const { data, Content } = await loadPage('program/build');
const state = await getRouteState();
const howLong = pick('howLong', (path: string): boolean => state.isLive(path));
const following = nextStage(stage.id);
const next = [
  ...(following ? [{ title: STAGE_VIEWS[following.id].headline, href: following.path, description: STAGE_VIEWS[following.id].subhead.split('. ')[0] + '.' }] : []),
  { title: 'How the program works', href: '/program/how-it-works/', description: 'From first conversation to Day One.' },
  { title: 'The whole program', href: '/program/', description: 'Five phases on the business clock, and Mission Control.' },
];
const waypoints = METHODS.launch.expansion.map((label) => ({ label }));
---

<StageLayout
  title={data.title}
  seoTitle={data.seoTitle}
  description={data.description}
  path={stage.path}
  stage={stage.id}
  lead={view.subhead}
  updated={data.updated}
  draft={data.draft}
  primary={START_REVIEW}
  secondary={howLong}
  ogSlot="og-program"
  next={next}
>
  <StageLong stage={stage.id} name={stage.name}>
    <Content />
    <Fragment slot="visual">
      <LaunchTrajectory
        waypoints={waypoints}
        labelsName="Stages of the flight, and the L.A.U.N.C.H. Sequence"
        caption="The L.A.U.N.C.H. Sequence: Logistics, Application, Users, Navigation, Channel, Hive."
      />
    </Fragment>
  </StageLong>
  <StageBody stage={stage} />
  <Fragment slot="after">
    <LongevitySpine detail="brief" tone="soft" lead="Build runs through the years when the odds are hardest. Ship every week, and keep the plan patient." />
    <SbirBand />
    <ProgramEnd title="Plan the steepest year with WE" text="Start a readiness review. WE arranges a conversation, then sends a one-page read of where the company sits on the business clock and what Build would need." secondary={howLong} />
  </Fragment>
</StageLayout>
