---
import { getEntry, render } from 'astro:content';
import EvidenceRoom from '../../components/islands/we-evidence-room/EvidenceRoom.astro';
import CtaBand from '../../components/ui/CtaBand.astro';
import ToolLayout from '../../layouts/ToolLayout.astro';

const entry = await getEntry('pages', 'tools/evidence-room');
if (!entry) throw new Error('Missing content entry pages/tools/evidence-room (src/content/pages/tools/evidence-room.mdx).');
const { Content } = await render(entry);
const { data } = entry;
---

<ToolLayout
  title={data.title}
  description={data.description}
  eyebrow={data.eyebrow}
  lead="The data room and readiness guides as one checklist. Tick, filter, print or copy."
  path="/tools/evidence-room/"
  primary={{ label: 'Read the data room guide', href: '/fundability/data-room/' }}
  secondary={{ label: 'Investor readiness checklist', href: '/fundability/investor-readiness-checklist/' }}
  updated={data.updated}
  draft={data.draft}
  crumbs={[
    { label: 'Home', href: '/' },
    { label: 'Tools', href: '/tools/' },
    { label: 'Evidence room', href: '/tools/evidence-room/' },
  ]}
  noscript="JavaScript is off. The whole checklist is below and you can tick the boxes and print the page. The stage filter, the copy button and the saved address need JavaScript."
>
  <EvidenceRoom />
  <div class="prose"><Content /></div>
  <CtaBand
    slot="after"
    title="Want the numbers behind the evidence worked out?"
    text="The metrics calculator turns one month of your figures into the standard SaaS results, with every formula shown."
    cta={{ label: 'Open the metrics calculator', href: '/tools/metrics-calculator/' }}
    secondary={{ label: 'Fundability and readiness', href: '/fundability/' }}
  />
</ToolLayout>
