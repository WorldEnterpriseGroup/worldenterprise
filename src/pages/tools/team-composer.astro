---
import { getEntry, render } from 'astro:content';
import { jumpTo } from '../../components/hero/ctas.ts';
import TeamComposer from '../../components/islands/we-team-composer/TeamComposer.astro';
import CtaBand from '../../components/ui/CtaBand.astro';
import ToolSchematic from '../../components/tools/ToolSchematic.astro';
import ToolLayout from '../../layouts/ToolLayout.astro';

const entry = await getEntry('pages', 'tools/team-composer');
if (!entry) throw new Error('Missing content entry pages/tools/team-composer (src/content/pages/tools/team-composer.mdx).');
const { Content } = await render(entry);
const { data } = entry;
---

<ToolLayout
  title={data.title}
  description={data.description}
  eyebrow={data.eyebrow}
  lead="Sketch the roles you need. No sign-up, no price."
  path="/tools/team-composer/"
  primary={jumpTo('Start composing', '#composer')}
  secondary={{ label: 'See how WE works', href: '/how-we-work/' }}
  updated={data.updated}
  draft={data.draft}
  crumbs={[
    { label: 'Home', href: '/' },
    { label: 'Resources', href: '/resources/' },
    { label: 'Team Composer', href: '/tools/team-composer/' },
  ]}
  noscript="JavaScript is off. You can still enter how many people each role needs and continue to the application. The live summary needs JavaScript."
>
  <ToolSchematic href="/tools/team-composer/" name={data.title} />
  <div id="composer"><TeamComposer /></div>
  <div class="prose composer-notes"><Content /></div>
  <CtaBand
    slot="after"
    title="Bring the sketch to a readiness review"
    text="Your roles arrive in the application's team box, ready to edit. The readiness review, not the sketch, sets the team WE steers."
    cta={{ label: 'Start a readiness review', href: '/apply/' }}
    secondary={{ label: 'See how WE works', href: '/how-we-work/' }}
  />
</ToolLayout>
