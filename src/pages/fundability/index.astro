---
import { getEntry, render } from 'astro:content';
import NoFundingDisclaimer from '../../components/blocks/NoFundingDisclaimer.astro';
import ReadinessCheck from '../../components/islands/we-readiness-check/ReadinessCheck.astro';
import SmartLink from '../../components/playbooks/SmartLink.astro';
import SafeCtaBand from '../../components/playbooks/SafeCtaBand.astro';
import { jumpTo } from '../../components/hero/ctas.ts';
import { IDENTITY } from '../../components/families/visual/copy.ts';
import { READINESS_REVIEW } from '../../components/families/visual/cta.ts';
import EmblemFrame from '../../components/families/visual/EmblemFrame.astro';
import HubLayout from '../../layouts/HubLayout.astro';
import { getPublished, isDraft } from '../../lib/content.ts';

const page = await getEntry('pages', 'fundability');
if (!page) throw new Error('Missing content entry: src/content/pages/fundability/index.mdx');
const { Content } = await render(page);
const { data } = page;

// The first four guides keep their order; every guide written after them follows by name, so a new file is listed without a code change.
const order = ['investor-readiness-checklist', 'data-room', 'safe-explained', 'investor-updates'];
const rank = (id: string): number => {
  const at = order.indexOf(id);
  return at === -1 ? order.length : at;
};
const guides = (await getPublished('guides'))
  .filter((g) => g.data.section === 'fundability')
  .sort((a, b) => rank(a.id) - rank(b.id) || a.id.localeCompare(b.id));
---

<HubLayout
  title={data.title}
  seoTitle={data.seoTitle}
  description={data.description}
  path="/fundability/"
  eyebrow={data.eyebrow}
  lead="Investor readiness is evidence preparation: the records, the numbers and the habits that let a serious person check your claims quickly. It is not a promise of funding."
  updated={data.updated}
  draft={isDraft(page)}
  ogSlot="og-fundability"
  hero="console"
  primary={jumpTo('Run the readiness check', '#self-check')}
  secondary={{ label: READINESS_REVIEW.label, href: READINESS_REVIEW.href }}
  toc={[
    { slug: 'what-it-means', text: 'What it means' },
    { slug: 'self-check', text: 'Self-check' },
    { slug: 'hub-subtree', text: 'The guides' },
  ]}
  subtree={guides.map((g) => ({ title: g.data.title, href: `/fundability/${g.id}/`, description: g.data.description }))}
>
  <div slot="panel"><EmblemFrame kind="fundability" caption={IDENTITY.fundability.caption} /></div>
  <NoFundingDisclaimer />
  <section id="what-it-means" class="prose" aria-label="What investor readiness means">
    <Content components={{ a: SmartLink }} />
  </section>
  <section id="self-check" aria-label="Investor readiness self-check" class="scroll-target">
    <ReadinessCheck />
  </section>
  <SafeCtaBand
    slot="after"
    title="Prepare with a team that steers the work"
    text="Service Line F covers fundability and investor readiness inside the program. WE prepares the evidence. The raise itself, and the legal advice around it, stay with you and your own counsel."
    primary={{ label: 'See Service Line F', href: '/services/fundability-and-investor-readiness/' }}
    secondary={{ label: READINESS_REVIEW.label, href: READINESS_REVIEW.href }}
  />
</HubLayout>

<style>
  @layer pages {
    .scroll-target {
      scroll-margin-block-start: calc(var(--header-h) + var(--sp-4));
    }
  }
</style>
