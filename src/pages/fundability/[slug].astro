---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import ArticleEnd from '../../components/families/visual/ArticleEnd.astro';
import ContextualNext from '../../components/blocks/ContextualNext.astro';
import SmartLink from '../../components/playbooks/SmartLink.astro';
import { liveItems } from '../../components/playbooks/links.ts';
import Button from '../../components/ui/Button.astro';
import GuideLayout from '../../layouts/GuideLayout.astro';
import { getRenderable, isDraft } from '../../lib/content.ts';
import { href } from '../../lib/url.ts';

/** Each fundability guide: the next step to take after reading it. Paths are ledger routes. */
const NEXT: Readonly<Record<string, readonly { title: string; href: string; description: string }[]>> = {
  'investor-readiness-checklist': [
    { title: 'Run the self-check', href: '/fundability/#self-check', description: 'Tick what is true today and get a list of gaps with places to start.' },
    { title: 'Organize the seed data room', href: '/fundability/data-room/', description: 'Where each record lives and how to keep the folder current.' },
  ],
  'data-room': [
    { title: 'Seed data room checklist', href: '/library/seed-data-room-checklist/', description: 'The folder-by-folder checklist as a template you can copy.' },
    { title: 'Write your investor updates', href: '/fundability/investor-updates/', description: 'A short, consistent structure for progress reports.' },
  ],
  'safe-explained': [
    { title: 'Prepare questions for your counsel', href: '/insights/questions-to-ask-your-counsel-before-you-sign/', description: 'A brief for the lawyer who works for you.' },
    { title: 'Run the self-check', href: '/fundability/#self-check', description: 'See which parts of your evidence still have gaps.' },
  ],
  'investor-updates': [
    { title: 'Weekly investor update template', href: '/library/weekly-investor-update-template/', description: 'A fixed structure you can copy and fill in.' },
    { title: 'Define your metrics once', href: '/research/early-stage-saas-metrics-definitions/', description: 'Definitions and formulas so every update counts the same way.' },
  ],
  'term-sheet-checklist': [
    { title: 'Prepare questions for your counsel', href: '/insights/questions-to-ask-your-counsel-before-you-sign/', description: 'A brief for the lawyer who works for you.' },
    { title: 'Read a term sheet line by line', href: '/insights/reading-a-term-sheet-line-by-line/', description: 'What each common clause says and why it is there.' },
  ],
  'security-questionnaire-answers': [
    { title: 'Security baseline checklist', href: '/library/security-baseline-checklist/', description: 'The controls to put in place before the questionnaire arrives.' },
    { title: 'Answer a questionnaire well', href: '/insights/answering-a-security-and-privacy-questionnaire/', description: 'How to answer each question honestly and keep the answers consistent.' },
  ],
  'pricing-experiments': [
    { title: 'Pricing page checklist', href: '/library/pricing-page-checklist/', description: 'A checklist for the page that shows what you charge.' },
    { title: 'Check a pricing page', href: '/tools/pricing-page-checker/', description: 'Test your page against the questions a buyer asks.' },
  ],
  'customer-interview-synthesis': [
    { title: 'Interview synthesis sheet', href: '/library/interview-synthesis-sheet/', description: 'A one-page sheet for turning notes into findings.' },
    { title: 'Customer interview guide', href: '/library/customer-interview-guide/', description: 'Questions to ask before you have anything to synthesize.' },
  ],
};

export const getStaticPaths = (async () => {
  const entries = (await getRenderable('guides')).filter((e) => e.data.section === 'fundability');
  return entries.map((entry) => ({ params: { slug: entry.id.split('/').at(-1) ?? entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { slug = '' } = Astro.params;
const { Content } = await render(entry);
const { data } = entry;
const next = await liveItems(NEXT[slug] ?? []);
// The first next step is the one action a reader of this guide takes: a self-check or a template to copy.
const nextStep = next[0] ? { label: next[0].title, href: next[0].href } : undefined;
---

<GuideLayout
  title={data.title}
  description={data.description}
  path={`/fundability/${slug}/`}
  eyebrow="Fundability guide"
  primary={nextStep}
  lead={data.description}
  disclaimers={data.disclaimers}
  sources={data.sources}
  updated={data.updated}
  draft={isDraft(entry)}
  ogSlot="og-fundability"
>
  <Content components={{ a: SmartLink }} />
  <Fragment slot="after">
    {
      next.length > 0 && (
        <div class="section section--soft section--defer">
          <div class="container stack">
            <ContextualNext items={next} title="What to do next" />
            <div class="cluster">
              <Button href={href('/fundability/')} variant="quiet">Back to investor readiness</Button>
            </div>
          </div>
        </div>
      )
    }
  </Fragment>
  <ArticleEnd slot="cta-end" kind="fundability" seed={slug} />
</GuideLayout>
