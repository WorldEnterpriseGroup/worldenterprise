---
import PageShell from '../../components/about/PageShell.astro';
import { loadPage } from '../../components/about/load-page.ts';
import Callout from '../../components/ui/Callout.astro';
import CtaBand from '../../components/ui/CtaBand.astro';
import DataTable from '../../components/ui/DataTable.astro';
import Section from '../../components/ui/Section.astro';
import { jumpTo } from '../../components/hero/ctas.ts';
import { site } from '../../data/site.ts';
import { getRouteState } from '../../lib/route-state.ts';
import { asset, href } from '../../lib/url.ts';
import { pressBoilerplate, pressEntity } from './_boilerplate.ts';

const entry = await loadPage('press/index');
const entity = pressEntity();
const boilerplate = pressBoilerplate();
// The brand kit is linked only while its route is live (ledger row launched and page built), so the link can never point at a 404.
const kitLive = (await getRouteState()).isLive('/press/brand-kit/');
---

<PageShell
  entry={entry}
  path="/press/"
  lead="Facts, a short boilerplate and logo downloads."
  schemaType="WebPage"
  primary={{ label: 'Download the wordmark (SVG)', href: '/press/we-logo-wordmark.svg', download: true }}
  secondary={jumpTo('Read the boilerplate', '#press-boiler')}
>
  <Fragment slot="after">
    <Section labelledby="press-boiler">
      <div class="container stack">
        <h2 id="press-boiler">Boilerplate</h2>
        <Callout title="Copy and use"><p>{boilerplate}</p></Callout>
        <p>WE may update this text. Check the date on this page before you reuse it.</p>
      </div>
    </Section>
    <Section tone="soft" labelledby="press-facts">
      <div class="container stack">
        <h2 id="press-facts">Facts to check against</h2>
        <DataTable
          caption="Published facts about WE"
          columns={['Item', 'Fact']}
          rows={[
            ['Name', site.name],
            ['Operating company', entity],
            ['What it is', 'A business incubation and consulting firm'],
            ['Format', 'Fully remote; no office and no visiting address'],
            ['Motto', site.motto],
            ['Funding', 'WE makes no promise of funding']
          ]}
        />
        <p>Anything not in this table is not a published claim. Check with WE before you state it.</p>
      </div>
    </Section>
    <Section labelledby="press-logo">
      <div class="container stack">
        <h2 id="press-logo">Logo downloads</h2>
        <p>The wordmark is provided as SVG for use on white or very light backgrounds.</p>
        <p>
          <a href={asset('/press/we-logo-wordmark.svg')} download>Download the World Enterprise wordmark (SVG)</a>
        </p>
        <h3 id="press-use">Using the logo</h3>
        <ul>
          <li>Use it dark on light only. There is no reversed version.</li>
          <li>Keep clear space around it equal to the height of one of its hexagonal cells.</li>
          <li>Do not stretch, recolour, outline, crop or place it on a dark or busy ground.</li>
          <li>Do not use it in a way that suggests WE endorses your product or service.</li>
        </ul>
        {
          kitLive && (
            <p>
              <a href={href('/press/brand-kit/')}>Read the brand kit</a> for usage rules, colors and type.
            </p>
          )
        }
      </div>
    </Section>
    <CtaBand title="A question or a correction?" text="Choose the topic Press or media, or A correction to something WE published." cta={{ label: 'Contact WE', href: '/contact/' }} />
  </Fragment>
</PageShell>
