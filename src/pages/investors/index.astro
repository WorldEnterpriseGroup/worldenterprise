---
import { render } from 'astro:content';
import InvestorIntroductionsOffer from '../../components/blocks/InvestorIntroductionsOffer.astro';
import LimitsBlock from '../../components/blocks/LimitsBlock.astro';
import NoFundingDisclaimer from '../../components/blocks/NoFundingDisclaimer.astro';
import { ASK_TO_MEET, HUB, JOURNEY_LINKS, MATERIAL_LINKS, PROCESS_STEPS } from '../../components/investors/copy.ts';
import LinkList from '../../components/investors/LinkList.astro';
import PortfolioShowcase from '../../components/investors/PortfolioShowcase.astro';
import { getPageEntry } from '../../components/network/pageEntry.ts';
import { isLinkable } from '../../components/playbooks/links.ts';
import Callout from '../../components/ui/Callout.astro';
import DataTable from '../../components/ui/DataTable.astro';
import Steps from '../../components/ui/Steps.astro';
import ReadinessScorecard from '../../components/visuals/illustrations/ReadinessScorecard.astro';
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import HubEcosystem from '../../components/hubs/HubEcosystem.astro';
import HubLead from '../../components/hubs/HubLead.astro';
import HubMoment from '../../components/hubs/HubMoment.astro';
import { tile } from '../../components/hubs/stats.ts';
import BarChart from '../../components/visuals/charts/BarChart.astro';
import StatTiles from '../../components/visuals/charts/StatTiles.astro';
import { dilutionBars, roundGapBars } from '../../data/datasets/figures.ts';

const page = await getPageEntry('investors', 'investors/index');
const { Content } = await render(page);

const meet = JOURNEY_LINKS[0];
const secondary = meet && (await isLinkable(meet.href)) ? { label: meet.title, href: meet.href } : undefined;
---

<MarketingLayout
  title={page.data.title}
  description={page.data.description}
  path="/investors/"
  eyebrow={page.data.eyebrow}
  lead={HUB.lead}
  updated={page.data.updated}
  ogSlot="og-network"
  primary={ASK_TO_MEET}
  secondary={secondary}
>
  <Callout tone="notice" title={HUB.notOfferTitle}>
    <p>{HUB.notOffer}</p>
  </Callout>

  <Content />

  <HubLead labelledby="clock-title">
    <div slot="head" class="investors-head">
      <h2 id="clock-title">The funding clock</h2>
      <p>Published medians for venture-backed companies: rounds come years apart, and each one costs the founders a share of the company.</p>
    </div>
    <div class="investors-bars">
      <HubMoment id="hub-investors-gaps" kind="chart">
        <BarChart {...roundGapBars} max={3} />
      </HubMoment>
      <HubMoment id="hub-investors-dilution" kind="chart">
        <BarChart {...dilutionBars} max={25} />
      </HubMoment>
    </div>
    <HubMoment slot="side" id="hub-investors-figures" kind="stats">
      <StatTiles stats={[tile('ST-33'), tile('ST-11')]} label="Young firms and capital" id="investors-figures" />
      <p class="investors-note">WE makes no promise of funding.</p>
    </HubMoment>
  </HubLead>

  <h2 id="process-title">{HUB.processHeading}</h2>
  <Steps headingLevel={3} steps={PROCESS_STEPS} />

  <h2 id="companies-title">{HUB.companiesHeading}</h2>
  <PortfolioShowcase headingLevel={3} />

  <h2 id="more-title">{HUB.moreHeading}</h2>
  <LinkList items={JOURNEY_LINKS} />

  <h2 id="prepares-title">{HUB.materialsHeading}</h2>
  <div class="split investors-prepares">
    <div class="split__text investors-stack">
      <DataTable caption={HUB.materialsCaption} columns={HUB.materialsColumns} rows={HUB.materials} />
      <LinkList items={MATERIAL_LINKS} />
    </div>
    <div class="split__media investors-stack">
      <ReadinessScorecard steps={false} title="Readiness, area by area: an illustration, not a score" />
      <p class="investors-note">WE makes no promise of funding.</p>
    </div>
  </div>

  <InvestorIntroductionsOffer variant="full" headingLevel={2} idPrefix="intro-offer" />

  <LimitsBlock title={HUB.limitsTitle} items={HUB.limits} headingLevel={2} />

  <h2 id="diligence-title">{HUB.diligenceHeading}</h2>
  <p>{HUB.diligence}</p>

  <NoFundingDisclaimer />

  <HubEcosystem id="investors-ecosystem" />
</MarketingLayout>

<style>
  .investors-prepares {
    align-items: start;
  }

  .investors-stack {
    display: grid;
    gap: var(--space-flow);
    align-content: start;

    & > * {
      margin: 0;
    }
  }

  .investors-head {
    display: grid;
    gap: var(--sp-2);
    max-inline-size: var(--prose-max);

    & > * {
      margin: 0;
    }
  }

  .investors-bars {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: var(--sp-6);
    align-items: start;
  }

  .investors-note {
    color: var(--color-text-muted);
    font-size: var(--fs-sm);
  }
</style>
