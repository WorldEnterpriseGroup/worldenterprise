---
import { render } from 'astro:content';
import InvestorIntroductionsOffer from '../../components/blocks/InvestorIntroductionsOffer.astro';
import LimitsBlock from '../../components/blocks/LimitsBlock.astro';
import NoFundingDisclaimer from '../../components/blocks/NoFundingDisclaimer.astro';
import { ASK_TO_MEET, HUB, JOURNEY_LINKS, MATERIAL_LINKS, PROCESS_STEPS } from '../../components/investors/copy.ts';
import LinkList from '../../components/investors/LinkList.astro';
import PortfolioShowcase from '../../components/investors/PortfolioShowcase.astro';
import { getPageEntry } from '../../components/network/pageEntry.ts';
import { isLinkable } from '../../components/playbooks/links.ts';
import Callout from '../../components/ui/Callout.astro';
import DataTable from '../../components/ui/DataTable.astro';
import Steps from '../../components/ui/Steps.astro';
import MarketingLayout from '../../layouts/MarketingLayout.astro';

const page = await getPageEntry('investors', 'investors/index');
const { Content } = await render(page);

const meet = JOURNEY_LINKS[0];
const secondary = meet && (await isLinkable(meet.href)) ? { label: meet.title, href: meet.href } : undefined;
---

<MarketingLayout
  title={page.data.title}
  description={page.data.description}
  path="/investors/"
  eyebrow={page.data.eyebrow}
  lead={HUB.lead}
  updated={page.data.updated}
  ogSlot="og-network"
  primary={ASK_TO_MEET}
  secondary={secondary}
>
  <Callout tone="notice" title={HUB.notOfferTitle}>
    <p>{HUB.notOffer}</p>
  </Callout>

  <Content />

  <h2 id="process-title">{HUB.processHeading}</h2>
  <Steps headingLevel={3} steps={PROCESS_STEPS} />

  <h2 id="companies-title">{HUB.companiesHeading}</h2>
  <PortfolioShowcase headingLevel={3} />

  <h2 id="more-title">{HUB.moreHeading}</h2>
  <LinkList items={JOURNEY_LINKS} />

  <h2 id="prepares-title">{HUB.materialsHeading}</h2>
  <DataTable caption={HUB.materialsCaption} columns={HUB.materialsColumns} rows={HUB.materials} />
  <LinkList items={MATERIAL_LINKS} />

  <InvestorIntroductionsOffer variant="full" headingLevel={2} idPrefix="intro-offer" />

  <LimitsBlock title={HUB.limitsTitle} items={HUB.limits} headingLevel={2} />

  <h2 id="diligence-title">{HUB.diligenceHeading}</h2>
  <p>{HUB.diligence}</p>

  <NoFundingDisclaimer />
</MarketingLayout>
