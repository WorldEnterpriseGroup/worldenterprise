---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import ArticleHub from '../../../layouts/ArticleHub.astro';
import { DESKS, DESK_LABELS, listInsights } from '../../../components/insights/articles.ts';
import type { Desk } from '../../../components/insights/articles.ts';
import InsightCard from '../../../components/insights/InsightCard.astro';
import { insightPath, insightSlug, readingMinutes } from '../../../components/insights/articles.ts';
import { getRenderable } from '../../../lib/content.ts';
import { IDENTITY } from '../../../components/families/visual/copy.ts';
import CtaLadder from '../../../components/families/visual/CtaLadder.astro';
import EmblemFrame from '../../../components/families/visual/EmblemFrame.astro';

// A desk gets a topic page once it holds an article (route-core.ts DESK_TOPIC_PATTERN): a desk nobody has written for has no page.
export const getStaticPaths = (async () => {
  const published = await getRenderable('insights');
  return DESKS.filter((desk) => published.some((entry) => entry.data.topic === desk)).map((topic) => ({ params: { topic } }));
}) satisfies GetStaticPaths;

const topic = Astro.params.topic as Desk;
const label = DESK_LABELS[topic];
const page = (await getCollection('pages')).find((e) => e.id === `insights/topic-${topic}`);
const Content = page === undefined ? undefined : (await render(page)).Content;
const items = await listInsights(topic);
---

<ArticleHub
  title={page?.data.title ?? `${label.name} insights`}
  description={page?.data.description ?? `${label.blurb} Sourced articles from World Enterprise Editorial.`}
  path={`/insights/topic/${topic}/`}
  eyebrow={`Insights / ${label.name}`}
  lead={label.blurb}
  {...(page !== undefined ? { updated: page.data.updated, draft: page.data.draft } : {})}
>
  <div class="desk-intro">
    <div class="desk-intro__text">
      {Content !== undefined ? <div class="prose"><Content /></div> : <p class="muted">{IDENTITY.insights.caption}</p>}
    </div>
    <div class="desk-intro__art">
      <EmblemFrame kind="insights" seed={`desk-${topic}`} />
    </div>
  </div>
  {
    items.length > 0 ? (
      <ul class="grid grid--min-16" role="list">
        {items.map((e) => (
          <li>
            <InsightCard
              title={e.data.title}
              summary={e.data.description}
              path={insightPath(e)}
              slug={insightSlug(e)}
              topic={e.data.topic}
              meta={`${readingMinutes(e.body)} min read`}
              headingLevel={2}
            />
          </li>
        ))}
      </ul>
    ) : (
      <p class="muted">Articles for this desk are being edited and will appear here when they are ready.</p>
    )
  }
  <CtaLadder slot="cta-end" />
</ArticleHub>

<style>
  @layer pages {
    .desk-intro {
      display: grid;
      gap: var(--sp-6);
      align-items: center;

      @media (min-width: 62rem) {
        grid-template-columns: minmax(0, 40rem) minmax(0, 1fr);
      }
    }

    .desk-intro__art {
      max-inline-size: 44rem;
    }
  }
</style>
