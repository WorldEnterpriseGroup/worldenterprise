---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import ArticleHub from '../../../layouts/ArticleHub.astro';
import { DESKS, DESK_LABELS, listInsights } from '../../../components/insights/articles.ts';
import type { Desk } from '../../../components/insights/articles.ts';
import InsightCard from '../../../components/insights/InsightCard.astro';
import { insightPath, insightSlug, readingMinutes } from '../../../components/insights/articles.ts';
import { getRenderable } from '../../../lib/content.ts';
import { IDENTITY } from '../../../components/families/visual/copy.ts';
import CtaLadder from '../../../components/families/visual/CtaLadder.astro';
import EmblemFrame from '../../../components/families/visual/EmblemFrame.astro';
import DeskConstellation from '../../../components/hubs/DeskConstellation.astro';
import DotStrip from '../../../components/hubs/DotStrip.astro';
import HubEcosystem from '../../../components/hubs/HubEcosystem.astro';
import { getRouteState } from '../../../lib/route-state.ts';

// A desk gets a topic page once it holds an article (route-core.ts DESK_TOPIC_PATTERN): a desk nobody has written for has no page.
export const getStaticPaths = (async () => {
  const published = await getRenderable('insights');
  return DESKS.filter((desk) => published.some((entry) => entry.data.topic === desk)).map((topic) => ({ params: { topic } }));
}) satisfies GetStaticPaths;

const topic = Astro.params.topic as Desk;
const label = DESK_LABELS[topic];
const page = (await getCollection('pages')).find((e) => e.id === `insights/topic-${topic}`);
const Content = page === undefined ? undefined : (await render(page)).Content;
const items = await listInsights(topic);
// WP-24: the whole insights sky with this desk lit (the others link to their own pages when live), and the reading time of every
// article on this desk. Drawn at build time; the page ships no script for it.
const state = await getRouteState();
const all = await Promise.all(DESKS.map(async (desk) => ({ desk, items: await listInsights(desk) })));
const sky = all
  .filter((d) => d.items.length > 0)
  .map(({ desk, items: list }) => ({
    id: desk,
    name: DESK_LABELS[desk].name,
    count: list.length,
    href: desk === topic ? '#desk-articles' : state.isLive(`/insights/topic/${desk}/`) ? `/insights/topic/${desk}/` : '/insights/',
  }));
const minutes = items.map((e) => ({ label: e.data.title, value: readingMinutes(e.body) }));
const readingMax = Math.ceil(Math.max(10, ...minutes.map((m) => m.value)) / 5) * 5;
---

<ArticleHub
  title={page?.data.title ?? `${label.name} insights`}
  description={page?.data.description ?? `${label.blurb} Sourced articles from World Enterprise Editorial.`}
  path={`/insights/topic/${topic}/`}
  eyebrow={`Insights / ${label.name}`}
  lead={label.blurb}
  {...(page !== undefined ? { updated: page.data.updated, draft: page.data.draft } : {})}
>
  <div class="desk-intro">
    <div class="desk-intro__text">
      {Content !== undefined ? <div class="prose"><Content /></div> : <p class="muted">{IDENTITY.insights.caption}</p>}
    </div>
    <div class="desk-intro__art">
      <EmblemFrame kind="insights" seed={`desk-${topic}`} />
    </div>
  </div>
  {
    sky.length > 0 && items.length > 0 && (
      <div class="desk-media">
        <DeskConstellation id="hub-topic-sky" desks={sky} focus={topic} />
        <DotStrip
          id="hub-topic-reading"
          title={`Reading time on the ${label.name} desk`}
          caption="One dot per article, in whole minutes; the amber mark is the median."
          credit="Chart: World Enterprise Group Incorporated, counted at build time from the articles on this desk."
          rows={[{ label: label.name, dots: minutes }]}
          min={0}
          max={readingMax}
          unit=" min"
          itemLabel="Article"
          valueLabel="Reading time"
        />
      </div>
    )
  }
  {
    items.length > 0 ? (
      <ul class="grid grid--min-16" role="list" id="desk-articles">
        {items.map((e) => (
          <li>
            <InsightCard
              title={e.data.title}
              summary={e.data.description}
              path={insightPath(e)}
              slug={insightSlug(e)}
              topic={e.data.topic}
              meta={`${readingMinutes(e.body)} min read`}
              headingLevel={2}
            />
          </li>
        ))}
      </ul>
    ) : (
      <p class="muted">Articles for this desk are being edited and will appear here when they are ready.</p>
    )
  }
  <HubEcosystem id="topic-ecosystem" />
  <CtaLadder slot="cta-end" />
</ArticleHub>

<style>
  @layer pages {
    .desk-intro {
      display: grid;
      gap: var(--sp-6);
      align-items: center;

      @media (min-width: 62rem) {
        grid-template-columns: minmax(0, 40rem) minmax(0, 1fr);
      }
    }

    .desk-media {
      display: grid;
      gap: var(--space-block, var(--sp-7));
      min-inline-size: 0;
    }

    .desk-intro__art {
      max-inline-size: 44rem;
    }
  }
</style>
