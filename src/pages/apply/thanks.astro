---
import { getEntry, render } from 'astro:content';
import AsideStyles from '../../components/forms/AsideStyles.astro';
import NoFundingDisclaimer from '../../components/blocks/NoFundingDisclaimer.astro';
import Steps from '../../components/ui/Steps.astro';
import FormLayout from '../../layouts/FormLayout.astro';
import { href } from '../../lib/url.ts';

const entry = await getEntry('pages', 'apply/thanks');
if (!entry) throw new Error('Missing content entry pages/apply/thanks (src/content/pages/apply/thanks.mdx).');
const { Content } = await render(entry);
const { data } = entry;
---

<FormLayout
  title={data.title}
  seoTitle={data.seoTitle}
  description={data.description}
  eyebrow={data.eyebrow}
  lead="WE will write to the address you gave to arrange a conversation."
  path="/apply/thanks/"
  updated={data.updated}
  draft={data.draft}
>
  <div class="prose"><Content /></div>
  <h2>What happens next</h2>
  <Steps
    headingLevel={3}
    steps={[
      { title: 'WE reviews your application', body: 'WE reviews what you wrote about the idea and the team you have in mind.' },
      { title: 'WE replies', body: 'The reply goes to the email address you gave. If it does not arrive, check your spam folder and then write to WE from the contact page.' },
      { title: 'Your company clock', body: 'WE sends a one-page read of where the company sits on the business clock. If the idea fits, WE scopes the work with you and drafts agreements for you to review with your own counsel.' },
    ]}
  />
  <Fragment slot="aside">
    <AsideStyles />
    <h2 class="aside-title">While you wait</h2>
    <ul class="stack" role="list">
      <li><a href={href('/program/how-it-works/')}>How the program works</a></li>
      <li><a href={href('/playbooks/validate-the-problem/')}>Playbook: validate the problem</a></li>
      <li><a href={href('/tools/team-composer/')}>Sketch a team in the Team Composer</a></li>
      <li><a href={href('/how-we-work/')}>How WE works</a></li>
      <li><a href={href('/contact/')}>Contact WE</a></li>
    </ul>
    <NoFundingDisclaimer />
  </Fragment>
</FormLayout>
