---
import { industryActions } from '../../components/families/actions.ts';
import { HEADINGS_HUB } from '../../components/families/copy.ts';
import FamilyHubPage from '../../components/families/FamilyHubPage.astro';
import { loadIsLive } from '../../components/families/load.ts';
import { ogSlotFor } from '../../components/families/og.ts';
import { findHubPage, liveCards } from '../../components/families/paths.ts';
import { INDUSTRIES } from '../../data/families.ts';
import { getRenderable } from '../../lib/content.ts';

/** The industries hub (/industries/): the structure is the template's, the intro is the content owner's `industries/index` page. */
const pages = await getRenderable('pages');
const isLive = await loadIsLive();
---

<FamilyHubPage
  family="industries"
  composition="industries"
  page={findHubPage(INDUSTRIES, pages)}
  path="/industries/"
  cards={liveCards(INDUSTRIES, pages, isLive)}
  listHeading={HEADINGS_HUB.industries}
  actions={industryActions(isLive)}
  ogSlot={ogSlotFor('industries')}
/>
