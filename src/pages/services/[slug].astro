---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import ContextualNext from '../../components/blocks/ContextualNext.astro';
import CtaBand from '../../components/ui/CtaBand.astro';
import LineAside from '../../components/services/LineAside.astro';
import { loadServiceLines } from '../../components/services/data.ts';
import { EXTRA_NEXT, entrySlug, playbookPath, servicePath } from '../../components/services/lines.ts';
import type { NextLink } from '../../components/services/lines.ts';
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import { getPublished, getRenderable, isDraft } from '../../lib/content.ts';

export const getStaticPaths = (async () => {
  const entries = await getRenderable('services');
  const lines = await loadServiceLines();
  // The route slug is the last segment of the entry id.
  return entries.map((entry) => ({ params: { slug: entrySlug(entry.id) }, props: { entry, lines } }));
}) satisfies GetStaticPaths;

const { entry, lines } = Astro.props;
const { slug } = Astro.params;
const { Content } = await render(entry);
const { data } = entry;

// Titles and descriptions come from the playbooks collection, so a line page never repeats them by hand.
const playbooks = new Map((await getPublished('playbooks')).map((p) => [entrySlug(p.id), p.data] as const));
const playbookLinks: NextLink[] = data.relatedPlaybooks.map((id) => {
  const playbook = playbooks.get(id);
  if (playbook === undefined) throw new Error(`Service entry ${entry.id} lists playbook "${id}", which is not a published playbook.`);
  return { title: playbook.title, href: playbookPath(id), description: playbook.description };
});
const nextItems = [...playbookLinks, ...(EXTRA_NEXT[data.line] ?? [])];
const eyebrow = `Service line ${data.line}`;
---

<ServiceLayout
  title={data.shortTitle}
  heading={data.title}
  description={data.summary}
  path={servicePath(slug ?? entrySlug(entry.id))}
  line={data.line}
  eyebrow={eyebrow}
  lead={data.summary}
  covers={data.covers}
  doesNotCover={data.doesNotCover}
  updated={data.updated}
  draft={isDraft(entry)}
>
  <Content />
  <LineAside slot="aside" line={data.line} lines={lines} />
  <Fragment slot="after">
    <div class="section section--soft">
      <div class="container">
        <ContextualNext items={nextItems} title="Next steps for this line" />
      </div>
    </div>
    <CtaBand
      title="Ready to scope this line?"
      text="Tell WE about your company and the stage it is at. You choose the lines, and WE steers the team."
      cta={{ label: 'Apply', href: '/apply/' }}
      secondary={{ label: 'Compose your team', href: '/tools/team-composer/' }}
    />
  </Fragment>
</ServiceLayout>
