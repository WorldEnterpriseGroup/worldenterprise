{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/astro-magazine/brief-storyboard.schema.json",
  "title": "Astro Magazine Brief Storyboard",
  "type": "object",
  "required": ["schema_version", "id", "kind", "status", "title", "slug", "canonical_html", "download_path", "cluster", "reader_decision", "thesis", "target_physical_pages", "minimum_designed_pages", "minimum_substantive_pages", "owners", "sections", "pages", "sources", "visuals", "related_articles", "accepted_exceptions", "gates"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "minLength": 1 },
    "kind": { "const": "brief" },
    "status": { "enum": ["commissioned", "storyboarding", "researching", "drafting", "editing", "designing", "accessibility_review", "senior_review", "publish_ready", "published", "deferred"] },
    "title": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "minLength": 1 },
    "target_physical_pages": { "type": "integer", "minimum": 30 },
    "minimum_designed_pages": { "type": "integer", "minimum": 30 },
    "minimum_substantive_pages": { "type": "integer", "minimum": 30 },
    "owners": { "type": "object" },
    "sections": { "type": "array", "minItems": 8 },
    "pages": {
      "type": "array",
      "minItems": 30,
      "items": {
        "type": "object",
        "required": ["page", "job", "substantive", "claim_ids", "source_ids", "visual_ids", "accessibility_state"],
        "properties": {
          "page": { "type": "integer", "minimum": 1 },
          "job": { "type": "string", "minLength": 1 },
          "substantive": { "type": "boolean" },
          "claim_ids": { "type": "array" },
          "source_ids": { "type": "array" },
          "visual_ids": { "type": "array" },
          "accessibility_state": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sources": { "type": "array", "minItems": 1 },
    "visuals": { "type": "array", "minItems": 1 },
    "related_articles": { "type": "array", "minItems": 1 },
    "accepted_exceptions": { "type": "object" },
    "gates": {
      "type": "object",
      "required": ["storyboard", "research", "fact_check", "html", "pdf_page_count", "pdf_visual_inspection", "pdf_text_extraction", "pdf_accessibility", "content_parity", "senior_approval"],
      "additionalProperties": {
        "enum": ["pass", "warn", "blocked", "accepted_exception", "unknown"]
      }
    }
  }
}
