{
  "name": "worldenterprise",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "World Enterprise Incubator, the public website of World Enterprise Group Incorporated.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "sync": "astro sync",
    "test:unit": "node --test \"tests/unit/**/*.test.ts\"",
    "postbuild": "pagefind --site dist --output-subdir pagefind",
    "audit:contrast": "node scripts/audit-contrast.mjs",
    "audit:claims": "node scripts/audit-claims.mjs",
    "audit:claims:selftest": "node scripts/audit-claims.mjs --self-test",
    "check:ownership": "node scripts/check-ownership.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/mdx": "8.0.3",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.3.6",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "lighthouse": "13.5.0",
    "linkinator": "8.1.0",
    "pagefind": "1.5.2",
    "typescript": "6.0.3"
  }
}
