{
  "name": "worldenterprise",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "World Enterprise Incubator, the public website of World Enterprise Group Incorporated.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "sync": "astro sync",
    "test:unit": "node --test \"tests/unit/**/*.test.ts\"",
    "postbuild": "pagefind --site dist --output-subdir pagefind",
    "audit:contrast": "node scripts/audit-contrast.mjs",
    "audit:claims": "node scripts/audit-claims.mjs dist",
    "audit:claims:selftest": "node scripts/audit-claims.mjs --self-test",
    "audit:claims:source": "node scripts/audit-claims.mjs --source infra/intake/briefs",
    "audit:gated": "node scripts/audit-gated-briefs.mjs --dist dist --briefs infra/intake/briefs --also src --also docs --abstracts src/content/briefs",
    "audit:gated:selftest": "node scripts/audit-gated-briefs.mjs --self-test",
    "audit:seo": "node scripts/audit-seo.mjs --dist dist",
    "audit:jsonld": "node scripts/validate-jsonld.mjs --dist dist",
    "audit:tokens": "node scripts/audit-tokens.mjs --root .",
    "audit:images": "node scripts/audit-images.mjs --dist dist",
    "audit:links": "node scripts/audit-links.mjs --dist dist --ledger reports/ledger.json",
    "audit:ledger": "node scripts/audit-route-ledger.mjs --dist dist --ledger reports/ledger.json",
    "audit:dist": "node scripts/lib/audit-dist.mjs --dist dist --cname CNAME",
    "audit:csp": "node scripts/audit-csp.mjs --dist dist",
    "audit:geo": "node scripts/audit-geo.mjs --dist dist",
    "audit:a11y": "node scripts/audit-a11y.mjs --dist dist",
    "qa:lighthouse": "node scripts/run-lighthouse.mjs --dist dist --out reports/lighthouse",
    "verify:release": "node scripts/lib/release-gate.mjs --json reports/release-gate.json",
    "check:ownership": "node scripts/check-ownership.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.3",
    "@astrojs/mdx": "8.0.3",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.3.7",
    "satteri": "0.10.5",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "lighthouse": "13.5.0",
    "pagefind": "1.5.2",
    "typescript": "6.0.3"
  }
}
